// Translated from PostgreSQL src/backend/parser/gram.y
//
// The SQL grammar. PG generates the LALR parser with bison; we use lalrpop (also
// LALR), so gram.y productions map across nearly one-to-one. The lexer is the
// logos token source in scan.rs (external-token mode below); semantic actions
// build PG's exact RawStmt/SelectStmt/ResTarget/A_Const node trees via the helpers
// in this file's sibling parser.rs (the makeXxxConst / makeRawStmt analogs).
//
// GROW discipline (README): the production hierarchy is scaffolded in full even
// where a nonterminal currently has one alternative, so later milestones ADD
// alternatives instead of restructuring. Every reachable production is complete.

use crate::backend::parser::scan::Token;
use crate::backend::parser::parser::{
    make_int_const, make_float_const, make_string_const, make_raw_stmt, make_star_target,
    do_negate, make_create_stmt, make_column_def_elt, system_type_name, generic_type_name,
    make_insert_stmt, make_values_select, make_column_ref, make_range_var_table_ref,
    make_a_expr, make_and_expr, make_or_expr, make_not_expr, make_func_call, RawStmtVec,
    make_type_cast, make_case_expr, make_case_when, make_coalesce_expr, make_min_max_expr,
    make_nullif_expr, make_string_const_cast, make_agg_star_call, make_distinct_func_call,
    make_sortby, insert_select_options, make_index_stmt, make_index_elem,
    make_join_expr, make_alias, apply_rangevar_alias, apply_join_alias,
    make_update_stmt, make_delete_stmt, make_merge_stmt, make_set_target,
    make_returning_clause, make_locking_clause, make_merge_when, set_select_locking,
    make_transaction_stmt, make_def_elem_str, make_def_elem_bool, set_variable_local,
    make_set_value, make_set_default, make_set_current, make_set_multi, make_set_timezone,
    make_set_transaction_snapshot, make_reset, make_reset_all, make_variable_show,
    make_param_ref, make_prepare_stmt, make_execute_stmt, make_deallocate_stmt,
    make_declare_cursor_stmt, make_close_portal_stmt, make_fetch_stmt, set_fetch_ismove,
    make_alter_table_stmt, make_at_add_column, make_at_drop_column, make_at_column_default,
    make_at_set_not_null, make_at_add_constraint, make_at_drop_constraint, make_check_constraint,
    make_rename_relation, make_rename_column, make_drop_stmt, make_any_name, make_grant_stmt,
    make_comment_stmt, make_access_priv, make_role_spec, make_seq_def_elem_int,
    make_seq_def_elem_bool, make_create_seq_stmt, make_alter_seq_stmt, make_create_schema_stmt,
    make_define_type_stmt, make_define_collation_stmt, make_create_domain_stmt,
    make_create_function_stmt, make_generic_def_elem, make_createdb_stmt, make_dropdb_stmt,
    make_create_conversion_stmt, make_create_tablespace_stmt, make_function_parameter,
    make_ot_column_def, DropBehaviorTok, ObjType,
};
use crate::nodes::parsenodes::{CursorOptions, FetchDirection, FETCH_ALL};
use crate::nodes::parsenodes::TransactionStmtKind as TxKind;
use crate::nodes::nodes::{CmdType, JoinType, Node};
use crate::nodes::lockoptions::{LockClauseStrength, LockWaitPolicy};
use crate::nodes::primnodes::MergeMatchKind;
use crate::nodes::parsenodes::{LockingClause, ObjectType, ResTarget, SelectStmt, SortByDir, SortByNulls, TypeName};

grammar;

// --- external lexer interface (scan.rs feeds these terminals) ---------------
extern {
    type Location = i32;
    type Error = crate::backend::parser::scan::LexError;

    enum Token {
        // keywords by canonical spelling (scan.rs resolves words against kwlist)
        "SELECT"  => Token::Keyword("select"),
        "AS"      => Token::Keyword("as"),
        "CREATE"  => Token::Keyword("create"),
        "TABLE"   => Token::Keyword("table"),
        "INT"     => Token::Keyword("int"),
        "INTEGER" => Token::Keyword("integer"),
        "FROM"    => Token::Keyword("from"),
        "INSERT"  => Token::Keyword("insert"),
        "INTO"    => Token::Keyword("into"),
        "VALUES"  => Token::Keyword("values"),
        "WHERE"   => Token::Keyword("where"),
        "AND"     => Token::Keyword("and"),
        "OR"      => Token::Keyword("or"),
        "NOT"     => Token::Keyword("not"),
        // M4 (step 23): cast + conditional-expression keywords.
        "CAST"     => Token::Keyword("cast"),
        "CASE"     => Token::Keyword("case"),
        "WHEN"     => Token::Keyword("when"),
        "THEN"     => Token::Keyword("then"),
        "ELSE"     => Token::Keyword("else"),
        "END"      => Token::Keyword("end"),
        "COALESCE" => Token::Keyword("coalesce"),
        "NULLIF"   => Token::Keyword("nullif"),
        "GREATEST" => Token::Keyword("greatest"),
        "LEAST"    => Token::Keyword("least"),
        // M4 type-name keywords (the Numeric / ConstTypename spellings).
        "NUMERIC"   => Token::Keyword("numeric"),
        "DECIMAL"   => Token::Keyword("decimal"),
        "REAL"      => Token::Keyword("real"),
        "FLOAT"     => Token::Keyword("float"),
        "DOUBLE"    => Token::Keyword("double"),
        "PRECISION" => Token::Keyword("precision"),
        "SMALLINT"  => Token::Keyword("smallint"),
        "BIGINT"    => Token::Keyword("bigint"),
        "BOOLEAN"   => Token::Keyword("boolean"),
        "TEXT"      => Token::Keyword("text"),
        // `date` is not a SQL keyword (it reaches the grammar as an IDENT via
        // GenericType); only `timestamp` is a keyword here.
        "TIMESTAMP" => Token::Keyword("timestamp"),
        // M5 (step 26): grouping / ordering / distinct / limit keywords.
        "GROUP"    => Token::Keyword("group"),
        "ORDER"    => Token::Keyword("order"),
        "BY"       => Token::Keyword("by"),
        "DISTINCT" => Token::Keyword("distinct"),
        "ASC"      => Token::Keyword("asc"),
        "DESC"     => Token::Keyword("desc"),
        "NULLS"    => Token::Keyword("nulls"),
        "FIRST"    => Token::Keyword("first"),
        "LAST"     => Token::Keyword("last"),
        "LIMIT"    => Token::Keyword("limit"),
        "OFFSET"   => Token::Keyword("offset"),
        "ALL"      => Token::Keyword("all"),
        // M6 (step 28): CREATE INDEX keywords.
        "INDEX"    => Token::Keyword("index"),
        "ON"       => Token::Keyword("on"),
        "USING"    => Token::Keyword("using"),
        "UNIQUE"   => Token::Keyword("unique"),
        // M7 (step 32): JOIN syntax keywords.
        "JOIN"     => Token::Keyword("join"),
        "INNER"    => Token::Keyword("inner"),
        "LEFT"     => Token::Keyword("left"),
        "RIGHT"    => Token::Keyword("right"),
        "FULL"     => Token::Keyword("full"),
        "OUTER"    => Token::Keyword("outer"),
        "CROSS"    => Token::Keyword("cross"),
        // M8 (step 34): UPDATE / DELETE / MERGE / RETURNING / FOR UPDATE keywords.
        "UPDATE"   => Token::Keyword("update"),
        "SET"      => Token::Keyword("set"),
        "DELETE"   => Token::Keyword("delete"),
        "RETURNING" => Token::Keyword("returning"),
        "FOR"      => Token::Keyword("for"),
        "SHARE"    => Token::Keyword("share"),
        "KEY"      => Token::Keyword("key"),
        "NO"       => Token::Keyword("no"),
        "OF"       => Token::Keyword("of"),
        "NOWAIT"   => Token::Keyword("nowait"),
        "SKIP"     => Token::Keyword("skip"),
        "LOCKED"   => Token::Keyword("locked"),
        "MERGE"    => Token::Keyword("merge"),
        "MATCHED"  => Token::Keyword("matched"),
        "DO"       => Token::Keyword("do"),
        "NOTHING"  => Token::Keyword("nothing"),
        // M9 (step 36): transaction control + SET/SHOW/RESET keywords.
        "BEGIN"    => Token::Keyword("begin"),
        "COMMIT"   => Token::Keyword("commit"),
        "ROLLBACK" => Token::Keyword("rollback"),
        "ABORT"    => Token::Keyword("abort"),
        "START"    => Token::Keyword("start"),
        "SAVEPOINT" => Token::Keyword("savepoint"),
        "RELEASE"  => Token::Keyword("release"),
        "PREPARE"  => Token::Keyword("prepare"),
        "PREPARED" => Token::Keyword("prepared"),
        "TRANSACTION" => Token::Keyword("transaction"),
        "WORK"     => Token::Keyword("work"),
        "CHAIN"    => Token::Keyword("chain"),
        "TO"       => Token::Keyword("to"),
        "SHOW"     => Token::Keyword("show"),
        "RESET"    => Token::Keyword("reset"),
        "LOCAL"    => Token::Keyword("local"),
        "SESSION"  => Token::Keyword("session"),
        "CHARACTERISTICS" => Token::Keyword("characteristics"),
        "DEFAULT"  => Token::Keyword("default"),
        "CURRENT"  => Token::Keyword("current"),
        "ISOLATION" => Token::Keyword("isolation"),
        "LEVEL"    => Token::Keyword("level"),
        "READ"     => Token::Keyword("read"),
        "WRITE"    => Token::Keyword("write"),
        "ONLY"     => Token::Keyword("only"),
        "DEFERRABLE" => Token::Keyword("deferrable"),
        "COMMITTED" => Token::Keyword("committed"),
        "UNCOMMITTED" => Token::Keyword("uncommitted"),
        "REPEATABLE" => Token::Keyword("repeatable"),
        "SERIALIZABLE" => Token::Keyword("serializable"),
        "TIME"     => Token::Keyword("time"),
        "ZONE"     => Token::Keyword("zone"),
        "SNAPSHOT" => Token::Keyword("snapshot"),
        "AUTHORIZATION" => Token::Keyword("authorization"),
        "TRUE"     => Token::Keyword("true"),
        "FALSE"    => Token::Keyword("false"),
        // M9 (step 37): PREPARE/EXECUTE/DEALLOCATE/DECLARE CURSOR/FETCH/MOVE/CLOSE.
        "EXECUTE"    => Token::Keyword("execute"),
        "DEALLOCATE" => Token::Keyword("deallocate"),
        "DECLARE"    => Token::Keyword("declare"),
        "CURSOR"     => Token::Keyword("cursor"),
        "FETCH"      => Token::Keyword("fetch"),
        "MOVE"       => Token::Keyword("move"),
        "CLOSE"      => Token::Keyword("close"),
        "SCROLL"     => Token::Keyword("scroll"),
        "BINARY"     => Token::Keyword("binary"),
        "INSENSITIVE" => Token::Keyword("insensitive"),
        "ASENSITIVE" => Token::Keyword("asensitive"),
        "HOLD"       => Token::Keyword("hold"),
        "WITH"       => Token::Keyword("with"),
        "WITHOUT"    => Token::Keyword("without"),
        "IN"         => Token::Keyword("in"),
        "NEXT"       => Token::Keyword("next"),
        "PRIOR"      => Token::Keyword("prior"),
        "ABSOLUTE"   => Token::Keyword("absolute"),
        "RELATIVE"   => Token::Keyword("relative"),
        "BACKWARD"   => Token::Keyword("backward"),
        "FORWARD"    => Token::Keyword("forward"),
        // M10 (step 38): ALTER TABLE / DROP / RENAME + dependency keywords.
        "ALTER"      => Token::Keyword("alter"),
        "DROP"       => Token::Keyword("drop"),
        "ADD"        => Token::Keyword("add"),
        "COLUMN"     => Token::Keyword("column"),
        "RENAME"     => Token::Keyword("rename"),
        "CASCADE"    => Token::Keyword("cascade"),
        "RESTRICT"   => Token::Keyword("restrict"),
        "EXISTS"     => Token::Keyword("exists"),
        "IF"         => Token::Keyword("if"),
        "CONSTRAINT" => Token::Keyword("constraint"),
        "NULL"       => Token::Keyword("null"),
        "CHECK"      => Token::Keyword("check"),
        "GRANT"      => Token::Keyword("grant"),
        "REVOKE"     => Token::Keyword("revoke"),
        "COMMENT"    => Token::Keyword("comment"),
        "IS"         => Token::Keyword("is"),
        "TYPE"       => Token::Keyword("type"),
        "VIEW"       => Token::Keyword("view"),
        "SEQUENCE"   => Token::Keyword("sequence"),
        "SCHEMA"     => Token::Keyword("schema"),
        "PRIVILEGES" => Token::Keyword("privileges"),
        // M10 (step 39): object-DDL keywords for SEQUENCE/SCHEMA/TYPE/DOMAIN/
        // FUNCTION/DATABASE/COLLATION/CONVERSION/TABLESPACE.
        "INCREMENT"  => Token::Keyword("increment"),
        "MINVALUE"   => Token::Keyword("minvalue"),
        "MAXVALUE"   => Token::Keyword("maxvalue"),
        "CACHE"      => Token::Keyword("cache"),
        "CYCLE"      => Token::Keyword("cycle"),
        "OWNED"      => Token::Keyword("owned"),
        "TEMP"       => Token::Keyword("temp"),
        "TEMPORARY"  => Token::Keyword("temporary"),
        "DOMAIN"     => Token::Keyword("domain"),
        "FUNCTION"   => Token::Keyword("function"),
        "PROCEDURE"  => Token::Keyword("procedure"),
        "LANGUAGE"   => Token::Keyword("language"),
        "RETURNS"    => Token::Keyword("returns"),
        "ENUM"       => Token::Keyword("enum"),
        "COLLATION"  => Token::Keyword("collation"),
        "CONVERSION" => Token::Keyword("conversion"),
        "DATABASE"   => Token::Keyword("database"),
        "TABLESPACE" => Token::Keyword("tablespace"),
        "LOCATION"   => Token::Keyword("location"),
        "REPLACE"    => Token::Keyword("replace"),
        "OPTION"     => Token::Keyword("option"),
        // literals / identifiers
        "IDENT"   => Token::Ident(<String>),
        "ICONST"  => Token::IConst(<i32>),
        "FCONST"  => Token::FConst(<String>),
        "SCONST"  => Token::SConst(<String>),
        // PARAM ($n) - carries the parameter number (M9, step 37).
        "PARAM"   => Token::Param(<i32>),
        // punctuation
        ";"       => Token::Semi,
        ","       => Token::Comma,
        "*"       => Token::Star,
        "("       => Token::LParen,
        ")"       => Token::RParen,
        "."       => Token::Dot,
        "+"       => Token::Plus,
        "-"       => Token::Minus,
        "/"       => Token::Slash,
        "%"       => Token::Percent,
        "<"       => Token::Lt,
        ">"       => Token::Gt,
        "="       => Token::Eq,
        "::"      => Token::Typecast,
        "<="      => Token::LessEquals,
        ">="      => Token::GreaterEquals,
        "<>"      => Token::NotEquals,
    }
}

// ===========================================================================
//  Top level: a semicolon-separated list of statements, each wrapped in RawStmt.
//  (gram.y `stmtmulti`; the MODE_* alternate entry points are added when plpgsql
//  / type-name parsing lands.)
// ===========================================================================

// gram.y wraps the whole result in `parse_toplevel`; the driver calls this rule.
pub Stmtmulti: RawStmtVec = {
    <mut list:Stmtmulti> ";" <s:TopLevelStmt> => {
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
    <s:TopLevelStmt> => {
        let mut list = Vec::new();
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
};

// gram.y `toplevel_stmt`: stmt | TransactionStmtLegacy. BEGIN/END are accepted
// only at top level (PG's toplevel_stmt), keeping them usable as labels elsewhere.
TopLevelStmt: Option<Node> = {
    Stmt,
    <s:TransactionStmtLegacy> => Some(s),
};

// gram.y `stmt`: the giant alternation over every statement kind. Grows one
// statement type per milestone; an empty statement yields None (dropped above).
Stmt: Option<Node> = {
    <s:SelectStmt> => Some(s),
    <s:CreateStmt> => Some(s),
    <s:IndexStmt> => Some(s),
    <s:AlterTableStmt> => Some(s),
    <s:RenameStmt> => Some(s),
    <s:DropStmt> => Some(s),
    <s:GrantStmt> => Some(s),
    <s:CommentStmt> => Some(s),
    <s:CreateSeqStmt> => Some(s),
    <s:AlterSeqStmt> => Some(s),
    <s:CreateSchemaStmt> => Some(s),
    <s:DefineStmt> => Some(s),
    <s:CreateDomainStmt> => Some(s),
    <s:CreateFunctionStmt> => Some(s),
    <s:CreateConversionStmt> => Some(s),
    <s:CreatedbStmt> => Some(s),
    <s:DropdbStmt> => Some(s),
    <s:CreateTableSpaceStmt> => Some(s),
    <s:InsertStmt> => Some(s),
    <s:UpdateStmt> => Some(s),
    <s:DeleteStmt> => Some(s),
    <s:MergeStmt> => Some(s),
    <s:TransactionStmt> => Some(s),
    <s:VariableSetStmt> => Some(s),
    <s:VariableShowStmt> => Some(s),
    <s:PrepareStmt> => Some(s),
    <s:ExecuteStmt> => Some(s),
    <s:DeallocateStmt> => Some(s),
    <s:DeclareCursorStmt> => Some(s),
    <s:ClosePortalStmt> => Some(s),
    <s:FetchStmt> => Some(s),
    => None,            // empty statement (e.g. trailing ';')
};

// ===========================================================================
//  UPDATE / DELETE / MERGE  (M8, step 34)
// ===========================================================================

// gram.y `UpdateStmt`: opt_with_clause UPDATE relation_expr_opt_alias SET
// set_clause_list from_clause where_or_current_clause returning_clause. M8 reaches
// `UPDATE t SET col = expr, ... [FROM ...] [WHERE ...] [RETURNING ...]`; WITH and
// WHERE CURRENT OF grow at their milestones.
UpdateStmt: Node = {
    "UPDATE" <rel:QualifiedName> "SET" <sets:SetClauseList>
        <frm:FromClause> <whr:WhereClause> <ret:ReturningClause> =>
        make_update_stmt(rel, sets, frm, whr, ret),
};

// gram.y `set_clause_list: set_clause (',' set_clause)*`.
SetClauseList: Vec<Node> = {
    <c:SetClause> => vec![c],
    <mut list:SetClauseList> "," <c:SetClause> => { list.push(c); list },
};

// gram.y `set_clause: set_target '=' a_expr` (the multiple-column form
// `(a,b) = (...)` grows later). Builds a ResTarget naming the column with the
// assigned expression as its `val`.
SetClause: Node = {
    <col:ColId> "=" <val:AExpr> => make_set_target(col, val),
};

// gram.y `DeleteStmt`: opt_with_clause DELETE_P FROM relation_expr_opt_alias
// using_clause where_or_current_clause returning_clause. M8 reaches
// `DELETE FROM t [USING ...] [WHERE ...] [RETURNING ...]`.
DeleteStmt: Node = {
    "DELETE" "FROM" <rel:QualifiedName> <using:UsingClause> <whr:WhereClause>
        <ret:ReturningClause> =>
        make_delete_stmt(rel, using, whr, ret),
};

// gram.y `using_clause: USING from_list | /*EMPTY*/`.
UsingClause: Vec<Node> = {
    "USING" <list:FromList> => list,
    => Vec::new(),
};

// gram.y `returning_clause: RETURNING returning_with_clause target_list | /*EMPTY*/`.
// M8 covers the plain `RETURNING target_list` (the OLD/NEW alias form grows later).
ReturningClause: Vec<Node> = {
    "RETURNING" <list:TargetList> => list,
    => Vec::new(),
};

// gram.y `MergeStmt`: opt_with_clause MERGE INTO relation_expr_opt_alias USING
// table_ref ON a_expr merge_when_list returning_clause. M8 reaches the basic
// `MERGE INTO t USING src ON cond WHEN ...` shape.
MergeStmt: Node = {
    "MERGE" "INTO" <rel:QualifiedName> "USING" <src:TableRef> "ON" <cond:AExpr>
        <whens:MergeWhenList> <ret:ReturningClause> =>
        make_merge_stmt(rel, src, cond, whens, ret),
};

// gram.y `merge_when_list: merge_when_clause+`.
MergeWhenList: Vec<Node> = {
    <w:MergeWhenClause> => vec![w],
    <mut list:MergeWhenList> <w:MergeWhenClause> => { list.push(w); list },
};

// gram.y `merge_when_clause`. M8 covers the common forms:
//   WHEN MATCHED THEN UPDATE SET ...    /  WHEN MATCHED THEN DELETE
//   WHEN NOT MATCHED THEN INSERT VALUES (...)  /  ... DO NOTHING
MergeWhenClause: Node = {
    "WHEN" "MATCHED" "THEN" "UPDATE" "SET" <sets:SetClauseList> =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::UPDATE, sets, Vec::new()),
    "WHEN" "MATCHED" "THEN" "DELETE" =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::DELETE, Vec::new(), Vec::new()),
    "WHEN" "MATCHED" "THEN" "DO" "NOTHING" =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::NOTHING, Vec::new(), Vec::new()),
    "WHEN" "NOT" "MATCHED" "THEN" "INSERT" "VALUES" "(" <vals:ExprList> ")" =>
        make_merge_when(MergeMatchKind::NOT_MATCHED_BY_TARGET, CmdType::INSERT, Vec::new(), vals),
    "WHEN" "NOT" "MATCHED" "THEN" "DO" "NOTHING" =>
        make_merge_when(MergeMatchKind::NOT_MATCHED_BY_TARGET, CmdType::NOTHING, Vec::new(), Vec::new()),
};

// ===========================================================================
//  INSERT
// ===========================================================================

// gram.y `InsertStmt`: opt_with_clause INSERT INTO insert_target insert_rest
// opt_on_conflict returning_clause. M2 reaches `INSERT INTO qname [(collist)]
// (VALUES (...) | SelectStmt)`; WITH / ON CONFLICT / RETURNING / OVERRIDING and
// the DEFAULT VALUES form grow at their milestones.
InsertStmt: Node = {
    "INSERT" "INTO" <rel:QualifiedName> <cols:OptInsertColumnList> <src:InsertRest> => {
        make_insert_stmt(rel, cols, src)
    },
};

// gram.y `insert_rest`: the source after the target. M2 supports a `VALUES (...)`
// list (wrapped as a SelectStmt with valuesLists, exactly as gram.y does) and a
// general SelectStmt; the `DEFAULT VALUES` and column-list+SELECT forms grow.
InsertRest: Option<Node> = {
    "VALUES" <rows:ValuesLists> => Some(make_values_select(rows)),
    <s:SelectStmt> => Some(s),
};

// gram.y `'(' insert_column_list ')' | /*EMPTY*/`. A ColumnRef per column.
OptInsertColumnList: Vec<Node> = {
    "(" <cols:InsertColumnList> ")" => cols,
    => Vec::new(),
};

InsertColumnList: Vec<Node> = {
    <c:InsertColumnItem> => vec![c],
    <mut list:InsertColumnList> "," <c:InsertColumnItem> => { list.push(c); list },
};

// gram.y `insert_column_item: ColId opt_indirection` -> a ResTarget naming the
// target column. M2 takes the bare column name (no indirection).
InsertColumnItem: Node = {
    <n:ColId> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: None, location: -1 };
        Node::ResTarget(Box::new(rt))
    },
};

// gram.y `values_clause`: VALUES ctext_row [, ...]. Each row is a parenthesized
// expression list. M2 covers one or more rows of constant expressions.
ValuesLists: Vec<Node> = {
    <r:ValuesRow> => vec![r],
    <mut list:ValuesLists> "," <r:ValuesRow> => { list.push(r); list },
};

// gram.y `ctext_row: '(' ctext_expr_list ')'`. In PG the row is a bare `List *`
// element of valuesLists; the port has no `List` Node type (pg_list tombstone),
// so a row's expr list is carried as the `args` of a RowExpr node (an exact-fit
// Vec<Node> carrier). transformInsertStmt reads `RowExpr.args` as the sublist.
ValuesRow: Node = {
    "(" <exprs:ExprList> ")" => {
        Node::RowExpr(Box::new(crate::nodes::primnodes::RowExpr {
            args: exprs,
            row_typeid: crate::postgres_ext::InvalidOid,
            row_format: crate::nodes::primnodes::CoercionForm::IMPLICIT_CAST,
            colnames: Vec::new(),
            location: -1,
        }))
    },
};

ExprList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:ExprList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  CREATE TABLE
// ===========================================================================

// gram.y `CreateStmt`. M2 reaches the plain `CREATE TABLE name ( elts )` form;
// IF NOT EXISTS, OF type, PARTITION OF, inheritance, partition spec, WITH options,
// ON COMMIT, tablespace and access-method clauses arrive at their milestones.
CreateStmt: Node = {
    "CREATE" "TABLE" <name:QualifiedName> "(" <elts:OptTableElementList> ")" => {
        make_create_stmt(name, elts)
    },
};

// gram.y `qualified_name`: ColId | ColId indirection. M2 supports the bare and
// schema-qualified (`schema.name`) forms; the general indirection (subscripts) is
// rejected by makeRangeVarFromQualifiedName in PG and is not reached here.
QualifiedName: crate::nodes::primnodes::RangeVar = {
    <n:ColId> => crate::nodes::makefuncs::makeRangeVar(None, Some(n), -1),
    <s:ColId> "." <n:ColId> =>
        crate::nodes::makefuncs::makeRangeVar(Some(s), Some(n), -1),
};

// gram.y `OptTableElementList` / `TableElementList`. M2 element = columnDef;
// TableConstraint and TableLikeClause grow with constraints / LIKE.
OptTableElementList: Vec<Node> = {
    TableElementList,
    => Vec::new(),
};

TableElementList: Vec<Node> = {
    <e:TableElement> => vec![e],
    <mut list:TableElementList> "," <e:TableElement> => { list.push(e); list },
};

TableElement: Node = {
    ColumnDef,
};

// gram.y `columnDef`: ColId Typename ColQualList. M2 builds the plain
// `name type` ColumnDef; column constraints (NOT NULL / DEFAULT / ...) grow with
// the ColQualList machinery.
ColumnDef: Node = {
    <name:ColId> <typ:Typename> => make_column_def_elt(name, typ),
};

// ===========================================================================
//  CREATE INDEX
// ===========================================================================

// gram.y `IndexStmt`: CREATE [UNIQUE] INDEX [name] ON relation [USING am]
// '(' index_params ')'. M6 reaches the plain single-/multi-column btree index;
// CONCURRENTLY, IF NOT EXISTS, INCLUDE, WITH options, tablespace, WHERE (partial),
// and the constraint forms grow at their milestones.
IndexStmt: Node = {
    "CREATE" <uniq:OptUnique> "INDEX" <name:OptIndexName> "ON" <rel:QualifiedName>
        <am:OptAccessMethodClause> "(" <params:IndexParams> ")" =>
        make_index_stmt(uniq, name, rel, am, params),
};

OptUnique: bool = {
    "UNIQUE" => true,
    => false,
};

OptIndexName: Option<String> = {
    <n:ColId> => Some(n),
    => None,
};

// gram.y `access_method_clause: USING name | /*EMPTY*/`. Defaults to btree.
OptAccessMethodClause: Option<String> = {
    "USING" <n:ColId> => Some(n),
    => None,
};

// gram.y `index_params: index_elem (',' index_elem)*`.
IndexParams: Vec<Node> = {
    <e:IndexElem> => vec![e],
    <mut list:IndexParams> "," <e:IndexElem> => { list.push(e); list },
};

// gram.y `index_elem: ColId index_elem_options ...`. M6 covers a bare column name
// (with ASC/DESC); opclasses, expressions, collations, and NULLS ordering grow.
IndexElem: Node = {
    <n:ColId> <dir:OptAscDesc> => make_index_elem(n, dir),
};

// ===========================================================================
//  ALTER TABLE / RENAME / DROP  (M10, step 38)
// ===========================================================================

// gram.y `AlterTableStmt: ALTER TABLE relation_expr alter_table_cmds`. M10 reaches
// `ALTER TABLE [IF EXISTS] name <cmd> [, <cmd>]...` for tables; the MATERIALIZED
// VIEW / INDEX / TYPE / partition / SET-clause forms grow at their milestones.
AlterTableStmt: Node = {
    "ALTER" "TABLE" <rel:QualifiedName> <cmds:AlterTableCmds> =>
        make_alter_table_stmt(rel, cmds, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> <cmds:AlterTableCmds> =>
        make_alter_table_stmt(rel, cmds, true),
};

AlterTableCmds: Vec<Node> = {
    <c:AlterTableCmd> => vec![c],
    <mut list:AlterTableCmds> "," <c:AlterTableCmd> => { list.push(c); list },
};

// gram.y `alter_table_cmd`: the M10-reachable subcommands (ADD/DROP COLUMN,
// ALTER COLUMN SET/DROP DEFAULT, SET/DROP NOT NULL, ALTER COLUMN TYPE, ADD/DROP
// CONSTRAINT). The rarely-hit AT_* forms grow at their milestones.
AlterTableCmd: Node = {
    "ADD" "COLUMN" <c:ColumnDef> => make_at_add_column(c),
    "ADD" <c:ColumnDef> => make_at_add_column(c),
    "DROP" "COLUMN" <n:ColId> <b:OptDropBehavior> => make_at_drop_column(n, false, b),
    "DROP" "COLUMN" "IF" "EXISTS" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_column(n, true, b),
    "DROP" <n:ColId> <b:OptDropBehavior> => make_at_drop_column(n, false, b),
    "ALTER" "COLUMN" <n:ColId> "SET" "DEFAULT" <e:AExpr> =>
        make_at_column_default(n, Some(e)),
    "ALTER" <n:ColId> "SET" "DEFAULT" <e:AExpr> => make_at_column_default(n, Some(e)),
    "ALTER" "COLUMN" <n:ColId> "DROP" "DEFAULT" => make_at_column_default(n, None),
    "ALTER" <n:ColId> "DROP" "DEFAULT" => make_at_column_default(n, None),
    "ALTER" "COLUMN" <n:ColId> "SET" "NOT" "NULL" => make_at_set_not_null(n, true),
    "ALTER" <n:ColId> "SET" "NOT" "NULL" => make_at_set_not_null(n, true),
    "ALTER" "COLUMN" <n:ColId> "DROP" "NOT" "NULL" => make_at_set_not_null(n, false),
    "ALTER" <n:ColId> "DROP" "NOT" "NULL" => make_at_set_not_null(n, false),
    "ADD" <c:TableConstraint> => make_at_add_constraint(c),
    "DROP" "CONSTRAINT" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_constraint(n, false, b),
    "DROP" "CONSTRAINT" "IF" "EXISTS" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_constraint(n, true, b),
};

// gram.y `TableConstraint: CONSTRAINT name ConstraintElem | ConstraintElem`. M10
// reaches a named/unnamed CHECK constraint (the minimal table constraint).
TableConstraint: Node = {
    "CONSTRAINT" <n:ColId> "CHECK" "(" <e:AExpr> ")" =>
        make_check_constraint(Some(n), e),
    "CHECK" "(" <e:AExpr> ")" => make_check_constraint(None, e),
};

// gram.y `opt_drop_behavior: CASCADE | RESTRICT | /*EMPTY*/`.
OptDropBehavior: DropBehaviorTok = {
    "CASCADE"  => DropBehaviorTok::Cascade,
    "RESTRICT" => DropBehaviorTok::Restrict,
    => DropBehaviorTok::Restrict,
};

// gram.y `RenameStmt`: the M10-reachable forms -- RENAME a table/index/view/...
// or one of its columns. `ALTER TABLE name RENAME [COLUMN] col TO new` and
// `ALTER TABLE name RENAME TO new`.
RenameStmt: Node = {
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Table, rel, new, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Table, rel, new, true),
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" "COLUMN" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, false),
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> "RENAME" "COLUMN" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, true),
    "ALTER" "INDEX" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Index, rel, new, false),
    "ALTER" "VIEW" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::View, rel, new, false),
};

// gram.y `DropStmt`: the generic `DROP <objtype> [IF EXISTS] names [CASCADE|RESTRICT]`.
// M10 reaches TABLE/INDEX/VIEW/SEQUENCE/TYPE/SCHEMA; the table/index forms route to
// RemoveRelations, the rest to RemoveObjects.
DropStmt: Node = {
    "DROP" <t:DropObjectType> <ie:OptIfExists> <names:AnyNameList> <b:OptDropBehavior> =>
        make_drop_stmt(t, names, ie, b),
};

DropObjectType: ObjType = {
    "TABLE"      => ObjType::Table,
    "INDEX"      => ObjType::Index,
    "VIEW"       => ObjType::View,
    "SEQUENCE"   => ObjType::Sequence,
    "TYPE"       => ObjType::Type,
    "SCHEMA"     => ObjType::Schema,
    "FUNCTION"   => ObjType::Function,
    "PROCEDURE"  => ObjType::Procedure,
    "COLLATION"  => ObjType::Collation,
    "CONVERSION" => ObjType::Conversion,
};

OptIfExists: bool = {
    "IF" "EXISTS" => true,
    => false,
};

// gram.y `any_name_list`: a comma-separated list of (possibly qualified) names.
// Each name is carried as a List of String parts (the DropStmt `objects` shape).
AnyNameList: Vec<Node> = {
    <n:AnyName> => vec![n],
    <mut list:AnyNameList> "," <n:AnyName> => { list.push(n); list },
};

AnyName: Node = {
    <n:ColId> => make_any_name(vec![n]),
    <s:ColId> "." <n:ColId> => make_any_name(vec![s, n]),
};

// ===========================================================================
//  GRANT / COMMENT  (M10 step 39: real privilege + comment machinery)
// ===========================================================================

// gram.y `GrantStmt`: GRANT|REVOKE priv_list ON TABLE name [, ...] TO|FROM role_list
// [WITH GRANT OPTION]. M10 reaches the table-object form; other object kinds + the
// schema-wide / default-privileges forms grow at their milestones.
GrantStmt: Node = {
    "GRANT" <p:GrantPrivList> "ON" "TABLE" <objs:QualifiedNameList> "TO" <r:GranteeList>
        <go:OptGrantGrantOption> =>
        make_grant_stmt(true, p, ObjectType::TABLE, objs, r, go),
    "REVOKE" <p:GrantPrivList> "ON" "TABLE" <objs:QualifiedNameList> "FROM" <r:GranteeList> =>
        make_grant_stmt(false, p, ObjectType::TABLE, objs, r, false),
};

// gram.y `privileges`: ALL [PRIVILEGES] | privilege_list. ALL is one AccessPriv with
// a NULL privname; a list is one AccessPriv per named privilege.
GrantPrivList: Vec<Node> = {
    "ALL" => vec![make_access_priv(None)],
    "ALL" "PRIVILEGES" => vec![make_access_priv(None)],
    <list:PrivilegeList> => list,
};

PrivilegeList: Vec<Node> = {
    <p:Privilege> => vec![p],
    <mut list:PrivilegeList> "," <p:Privilege> => { list.push(p); list },
};

// gram.y `privilege`: the named privileges are keywords (SELECT/INSERT/UPDATE/
// DELETE), so each is an explicit alternative; any other privilege name arrives as
// a ColId (PG's `privilege: ... | ColId opt_column_list`).
Privilege: Node = {
    "SELECT" => make_access_priv(Some("select".to_string())),
    "INSERT" => make_access_priv(Some("insert".to_string())),
    "UPDATE" => make_access_priv(Some("update".to_string())),
    "DELETE" => make_access_priv(Some("delete".to_string())),
    <n:ColId> => make_access_priv(Some(n)),
};

// gram.y `grantee_list`: comma-separated role specs.
GranteeList: Vec<Node> = {
    <n:ColId> => vec![make_role_spec(n)],
    <mut list:GranteeList> "," <n:ColId> => { list.push(make_role_spec(n)); list },
};

// gram.y `opt_grant_grant_option: WITH GRANT OPTION | /*EMPTY*/`.
OptGrantGrantOption: bool = {
    "WITH" "GRANT" "OPTION" => true,
    => false,
};

// gram.y `CommentStmt`: COMMENT ON <object> IS 'text'|NULL. M10 reaches TABLE /
// COLUMN / INDEX / SEQUENCE / SCHEMA (the relation-shaped kinds carried as a
// RangeVar); the function/type/... forms grow at their milestones.
CommentStmt: Node = {
    "COMMENT" "ON" "TABLE" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::TABLE, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "INDEX" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::INDEX, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "SEQUENCE" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::SEQUENCE, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "SCHEMA" <n:ColId> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::SCHEMA, Some(make_any_name(vec![n])), c),
    "COMMENT" "ON" "VIEW" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::VIEW, Some(Node::RangeVar(Box::new(n))), c),
};

CommentText: Option<String> = {
    <s:"SCONST"> => Some(s),
    "NULL" => None,
};

// ===========================================================================
//  CREATE / ALTER SEQUENCE  (M10, step 39)
// ===========================================================================

// gram.y `CreateSeqStmt`: CREATE [TEMP] SEQUENCE [IF NOT EXISTS] qualified_name
// OptSeqOptList. The TEMP qualifier is parsed (relpersistence handling stages).
CreateSeqStmt: Node = {
    "CREATE" "SEQUENCE" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, false),
    "CREATE" "SEQUENCE" "IF" "NOT" "EXISTS" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, true),
    "CREATE" OptTemp "SEQUENCE" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, false),
};

// gram.y `AlterSeqStmt`: ALTER SEQUENCE [IF EXISTS] qualified_name SeqOptList.
AlterSeqStmt: Node = {
    "ALTER" "SEQUENCE" <name:QualifiedName> <opts:SeqOptList> =>
        make_alter_seq_stmt(name, opts, false),
    "ALTER" "SEQUENCE" "IF" "EXISTS" <name:QualifiedName> <opts:SeqOptList> =>
        make_alter_seq_stmt(name, opts, true),
};

// gram.y `opt_temp`: TEMP | TEMPORARY (the GLOBAL/LOCAL noise + UNLOGGED grow later).
OptTemp: () = {
    "TEMP" => (),
    "TEMPORARY" => (),
};

// gram.y `OptSeqOptList: SeqOptList | /*EMPTY*/` and `SeqOptList: SeqOptElem+`.
OptSeqOptList: Vec<Node> = {
    SeqOptList,
    => Vec::new(),
};

SeqOptList: Vec<Node> = {
    <e:SeqOptElem> => vec![e],
    <mut list:SeqOptList> <e:SeqOptElem> => { list.push(e); list },
};

// gram.y `SeqOptElem` (the M10-reachable options). INCREMENT/START/CACHE/MINVALUE/
// MAXVALUE carry a signed integer; CYCLE/NO CYCLE is a flag; AS type + OWNED BY are
// accepted and dropped (their handling stages). NumericOnly is ICONST [+/-].
SeqOptElem: Node = {
    "INCREMENT" <i:SeqNumeric> => make_seq_def_elem_int("increment", i),
    "INCREMENT" "BY" <i:SeqNumeric> => make_seq_def_elem_int("increment", i),
    "START" <i:SeqNumeric> => make_seq_def_elem_int("start", i),
    "START" "WITH" <i:SeqNumeric> => make_seq_def_elem_int("start", i),
    "MINVALUE" <i:SeqNumeric> => make_seq_def_elem_int("minvalue", i),
    "NO" "MINVALUE" => make_seq_def_elem_bool("no_minvalue", true),
    "MAXVALUE" <i:SeqNumeric> => make_seq_def_elem_int("maxvalue", i),
    "NO" "MAXVALUE" => make_seq_def_elem_bool("no_maxvalue", true),
    "CACHE" <i:SeqNumeric> => make_seq_def_elem_int("cache", i),
    "CYCLE" => make_seq_def_elem_bool("cycle", true),
    "NO" "CYCLE" => make_seq_def_elem_bool("cycle", false),
    "AS" <_t:SimpleTypename> => make_seq_def_elem_bool("as", true),
    "OWNED" "BY" <_n:AnyName> => make_seq_def_elem_bool("owned_by", true),
};

// ===========================================================================
//  CREATE SCHEMA  (M10, step 39)
// ===========================================================================

// gram.y `CreateSchemaStmt`. M10 reaches `CREATE SCHEMA [IF NOT EXISTS] name
// [AUTHORIZATION role]`; the nested schema_element_list (CREATE TABLE inside the
// schema) is parsed-and-staged (an element list routes its members at exec time).
CreateSchemaStmt: Node = {
    "CREATE" "SCHEMA" <n:ColId> <auth:OptSchemaAuth> =>
        make_create_schema_stmt(Some(n), auth, Vec::new(), false),
    "CREATE" "SCHEMA" "IF" "NOT" "EXISTS" <n:ColId> <auth:OptSchemaAuth> =>
        make_create_schema_stmt(Some(n), auth, Vec::new(), true),
    "CREATE" "SCHEMA" "AUTHORIZATION" <r:ColId> =>
        make_create_schema_stmt(None, Some(make_role_spec(r)), Vec::new(), false),
};

// gram.y `OptSchemaName` AUTHORIZATION role tail.
OptSchemaAuth: Option<Node> = {
    "AUTHORIZATION" <r:ColId> => Some(make_role_spec(r)),
    => None,
};

// ===========================================================================
//  CREATE TYPE / DOMAIN / COLLATION  (M10, step 39: DefineStmt + CreateDomainStmt)
// ===========================================================================

// gram.y `DefineStmt` for CREATE TYPE: composite `AS (col type, ...)`, enum
// `AS ENUM ('a', ...)`. The base-type `CREATE TYPE n (INPUT=.., ...)` form stages.
DefineStmt: Node = {
    "CREATE" "TYPE" <n:AnyNameParts> "AS" "(" <cols:OtColumnList> ")" =>
        make_define_type_stmt(n, cols),
    "CREATE" "TYPE" <n:AnyNameParts> "AS" "ENUM" "(" <labels:EnumLabelList> ")" =>
        make_define_type_stmt(n, labels),
    "CREATE" "COLLATION" <n:AnyNameParts> "(" <defs:DefList> ")" =>
        make_define_collation_stmt(n, defs),
};

// gram.y `TableFuncElementList` (the composite column list `colname type, ...`).
OtColumnList: Vec<Node> = {
    <c:OtColumn> => vec![c],
    <mut list:OtColumnList> "," <c:OtColumn> => { list.push(c); list },
};

OtColumn: Node = {
    <n:ColId> <t:Typename> => make_ot_column_def(n, t),
};

// gram.y `enum_val_list`: the quoted enum labels.
EnumLabelList: Vec<Node> = {
    <s:"SCONST"> => vec![make_string_const(s)],
    <mut list:EnumLabelList> "," <s:"SCONST"> => { list.push(make_string_const(s)); list },
};

// gram.y `CreateDomainStmt`: CREATE DOMAIN n [AS] type [DEFAULT e] [constraints].
// M10 reaches the type + optional DEFAULT (constraints stage to phase B).
CreateDomainStmt: Node = {
    "CREATE" "DOMAIN" <n:AnyNameParts> <t:Typename> =>
        make_create_domain_stmt(n, t, Vec::new()),
    "CREATE" "DOMAIN" <n:AnyNameParts> "AS" <t:Typename> =>
        make_create_domain_stmt(n, t, Vec::new()),
};

// gram.y `any_name` parts as a Vec<String> (1- or 2-part).
AnyNameParts: Vec<String> = {
    <n:ColId> => vec![n],
    <s:ColId> "." <n:ColId> => vec![s, n],
};

// gram.y `def_list: def_elem (',' def_elem)*` (the parenthesized definition list).
DefList: Vec<Node> = {
    <e:DefElemItem> => vec![e],
    <mut list:DefList> "," <e:DefElemItem> => { list.push(e); list },
};

// gram.y `def_elem: ColLabel '=' def_arg | ColLabel`.
DefElemItem: Node = {
    <n:ColId> "=" <s:"SCONST"> => make_generic_def_elem(&n, Some(make_string_const(s))),
    <n:ColId> "=" <i:SignedIconst> => make_generic_def_elem(&n, Some(make_int_const(i32::try_from(i).unwrap_or(0)))),
    <n:ColId> => make_generic_def_elem(&n, None),
};

// ===========================================================================
//  CREATE FUNCTION / PROCEDURE  (M10, step 39)
// ===========================================================================

// gram.y `CreateFunctionStmt`: CREATE [OR REPLACE] FUNCTION|PROCEDURE name(args)
// [RETURNS rettype] LANGUAGE lang AS 'body' [opts]. The body/language are options.
CreateFunctionStmt: Node = {
    "CREATE" <repl:OptOrReplace> "FUNCTION" <n:AnyNameParts> "(" <args:FuncArgsOrEmpty> ")"
        <ret:OptFuncReturns> <opts:OptCreateFuncOptList> =>
        make_create_function_stmt(false, repl, n, args, ret, opts),
    "CREATE" <repl:OptOrReplace> "PROCEDURE" <n:AnyNameParts> "(" <args:FuncArgsOrEmpty> ")"
        <opts:OptCreateFuncOptList> =>
        make_create_function_stmt(true, repl, n, args, None, opts),
};

OptOrReplace: bool = {
    "OR" "REPLACE" => true,
    => false,
};

// gram.y `func_args_with_defaults: '(' func_args_with_defaults_list ')' | '(' ')'`.
FuncArgsOrEmpty: Vec<Node> = {
    => Vec::new(),
    <list:FuncArgList> => list,
};

FuncArgList: Vec<Node> = {
    <a:FuncArg> => vec![a],
    <mut list:FuncArgList> "," <a:FuncArg> => { list.push(a); list },
};

// gram.y `func_arg`: [arg_class] [param_name] func_type. M10 reaches `[name] type`.
FuncArg: Node = {
    <t:Typename> => make_function_parameter(None, t),
    <n:ColId> <t:Typename> => make_function_parameter(Some(n), t),
};

// gram.y `RETURNS func_type | /*EMPTY*/`.
OptFuncReturns: Option<TypeName> = {
    "RETURNS" <t:Typename> => Some(t),
    => None,
};

// gram.y `createfunc_opt_list`: the LANGUAGE / AS body options. Non-empty
// left-recursive list with an Opt wrapper for emptiness (avoids the empty-vs-single
// reduction ambiguity).
OptCreateFuncOptList: Vec<Node> = {
    CreateFuncOptList,
    => Vec::new(),
};

CreateFuncOptList: Vec<Node> = {
    <e:CreateFuncOptItem> => vec![e],
    <mut list:CreateFuncOptList> <e:CreateFuncOptItem> => { list.push(e); list },
};

// gram.y `createfunc_opt_item` (the M10-reachable subset): LANGUAGE name | AS 'body'.
// PG's LANGUAGE arg is NonReservedWord_or_Sconst; the common language names (`sql`,
// `plpgsql`) are unreserved keywords, so the quoted form `LANGUAGE 'sql'` is the
// portable spelling here (a bare unreserved-keyword ColId is a broader grammar
// change). A plain-identifier language name is also accepted.
CreateFuncOptItem: Node = {
    "LANGUAGE" <n:ColId> => make_generic_def_elem("language", Some(make_string_const(n))),
    "LANGUAGE" <s:"SCONST"> => make_generic_def_elem("language", Some(make_string_const(s))),
    "AS" <s:"SCONST"> => make_generic_def_elem("as", Some(make_string_const(s))),
};

// ===========================================================================
//  CREATE DATABASE / DROP DATABASE / CREATE CONVERSION / CREATE TABLESPACE
//  (M10, step 39: parse-and-route; bodies in phase B)
// ===========================================================================

// gram.y `CreatedbStmt`: CREATE DATABASE name [createdb_opt_list].
CreatedbStmt: Node = {
    "CREATE" "DATABASE" <n:ColId> <opts:DefListOrEmpty> => make_createdb_stmt(n, opts),
};

// gram.y `DropdbStmt`: DROP DATABASE [IF EXISTS] name.
DropdbStmt: Node = {
    "DROP" "DATABASE" <n:ColId> => make_dropdb_stmt(n, false),
    "DROP" "DATABASE" "IF" "EXISTS" <n:ColId> => make_dropdb_stmt(n, true),
};

DefListOrEmpty: Vec<Node> = {
    <list:DefList> => list,
    => Vec::new(),
};

// gram.y `CreateConversionStmt` (minimal stub-parse): routed to its phase-B body.
CreateConversionStmt: Node = {
    "CREATE" "CONVERSION" <n:AnyNameParts> => make_create_conversion_stmt(n),
};

// gram.y `CreateTableSpaceStmt` (minimal): CREATE TABLESPACE name LOCATION 'path'.
CreateTableSpaceStmt: Node = {
    "CREATE" "TABLESPACE" <n:ColId> "LOCATION" <loc:"SCONST"> =>
        make_create_tablespace_stmt(n, Some(loc)),
};

// ===========================================================================
//  Type names  (gram.y Typename -> SimpleTypename -> Numeric / GenericType).
//  The full type tower (arrays, intervals, character types, typmods, %TYPE,
//  SETOF) grows at later milestones; M2 covers int/integer and a bare generic
//  type name resolved by catalog lookup.
// ===========================================================================

Typename: TypeName = {
    SimpleTypename,
};

SimpleTypename: TypeName = {
    Numeric,
    // The keyword-spelled non-Numeric built-in types (text + timestamp). `date` is
    // not a SQL keyword in PG, so it arrives via GenericType (a bare catalog name);
    // `text`/`timestamp` ARE keywords and need an explicit arm.
    "TEXT"      => system_type_name("text"),
    "TIMESTAMP" => system_type_name("timestamp"),
    GenericType,
};

// gram.y `Numeric`: the built-in numeric/boolean spellings. The integer aliases map
// to their pg_catalog type; M4 (step 23) adds smallint/bigint/real/float/double
// precision/numeric/decimal/boolean (typmods on numeric/decimal/float grow with the
// opt_type_modifiers machinery). `float8`/`numeric` etc. resolve to their seeded
// pg_type rows.
Numeric: TypeName = {
    "INT"     => system_type_name("int4"),
    "INTEGER" => system_type_name("int4"),
    "SMALLINT" => system_type_name("int2"),
    "BIGINT"  => system_type_name("int8"),
    "REAL"    => system_type_name("float4"),
    "FLOAT"   => system_type_name("float8"),
    "DOUBLE" "PRECISION" => system_type_name("float8"),
    "BOOLEAN" => system_type_name("bool"),
    "NUMERIC" => system_type_name("numeric"),
    "DECIMAL" => system_type_name("numeric"),
};


// gram.y `GenericType`: a (possibly schema-qualified) user/catalog type name,
// resolved by catalog lookup at analysis time. M2 takes a bare type identifier;
// the qualified form + opt_type_modifiers + array bounds grow later.
GenericType: TypeName = {
    <n:ColId> => generic_type_name(n),
};

// gram.y `ColId`: an identifier usable as a column/table name. The unreserved /
// col-name keyword spellings that ColId also admits grow as those keywords enter
// the grammar; M2 accepts a bare IDENT.
ColId: String = {
    <n:"IDENT"> => n,
};

// ===========================================================================
//  Transaction control (M9, step 36): gram.y `TransactionStmt` +
//  `TransactionStmtLegacy`.
// ===========================================================================

// gram.y `TransactionStmt`: the non-legacy transaction-control statements.
TransactionStmt: Node = {
    "ABORT" OptTransaction <chain:OptTransactionChain> =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, chain),
    "START" "TRANSACTION" <m:TransactionModeListOrEmpty> =>
        make_transaction_stmt(TxKind::START, m, None, None, false),
    "COMMIT" OptTransaction <chain:OptTransactionChain> =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, chain),
    "ROLLBACK" OptTransaction <chain:OptTransactionChain> =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, chain),
    "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::SAVEPOINT, Vec::new(), Some(n), None, false),
    "RELEASE" "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::RELEASE, Vec::new(), Some(n), None, false),
    "RELEASE" <n:ColId> =>
        make_transaction_stmt(TxKind::RELEASE, Vec::new(), Some(n), None, false),
    "ROLLBACK" OptTransaction "TO" "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::ROLLBACK_TO, Vec::new(), Some(n), None, false),
    "ROLLBACK" OptTransaction "TO" <n:ColId> =>
        make_transaction_stmt(TxKind::ROLLBACK_TO, Vec::new(), Some(n), None, false),
    "PREPARE" "TRANSACTION" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::PREPARE, Vec::new(), None, Some(gid), false),
    "COMMIT" "PREPARED" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::COMMIT_PREPARED, Vec::new(), None, Some(gid), false),
    "ROLLBACK" "PREPARED" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::ROLLBACK_PREPARED, Vec::new(), None, Some(gid), false),
};

// gram.y `TransactionStmtLegacy`: BEGIN / END (top level only).
TransactionStmtLegacy: Node = {
    "BEGIN" OptTransaction <m:TransactionModeListOrEmpty> =>
        make_transaction_stmt(TxKind::BEGIN, m, None, None, false),
    "END" OptTransaction <chain:OptTransactionChain> =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, chain),
};

// gram.y `opt_transaction`: WORK | TRANSACTION | empty (noise words).
OptTransaction: () = {
    "WORK" => (),
    "TRANSACTION" => (),
    => (),
};

// gram.y `opt_transaction_chain`: AND CHAIN | AND NO CHAIN | empty.
OptTransactionChain: bool = {
    "AND" "CHAIN" => true,
    "AND" "NO" "CHAIN" => false,
    => false,
};

// gram.y `transaction_mode_list_or_empty`.
TransactionModeListOrEmpty: Vec<Node> = {
    TransactionModeList,
    => Vec::new(),
};

// gram.y `transaction_mode_list`: comma-separated OR space-separated (PG historic).
TransactionModeList: Vec<Node> = {
    <i:TransactionModeItem> => vec![i],
    <mut l:TransactionModeList> "," <i:TransactionModeItem> => { l.push(i); l },
    <mut l:TransactionModeList> <i:TransactionModeItem> => { l.push(i); l },
};

// gram.y `transaction_mode_item`.
TransactionModeItem: Node = {
    "ISOLATION" "LEVEL" <lv:IsoLevel> =>
        make_def_elem_str("transaction_isolation", lv),
    "READ" "ONLY" => make_def_elem_bool("transaction_read_only", true),
    "READ" "WRITE" => make_def_elem_bool("transaction_read_only", false),
    "DEFERRABLE" => make_def_elem_bool("transaction_deferrable", true),
    "NOT" "DEFERRABLE" => make_def_elem_bool("transaction_deferrable", false),
};

// gram.y `iso_level`.
IsoLevel: &'static str = {
    "READ" "UNCOMMITTED" => "read uncommitted",
    "READ" "COMMITTED" => "read committed",
    "REPEATABLE" "READ" => "repeatable read",
    "SERIALIZABLE" => "serializable",
};

// ===========================================================================
//  SET / RESET / SHOW (M9, step 36): gram.y `VariableSetStmt` / `VariableShowStmt`.
// ===========================================================================

// gram.y `VariableSetStmt`: SET [SESSION|LOCAL] set_rest | RESET reset_rest.
VariableSetStmt: Node = {
    "SET" <r:SetRest> => set_variable_local(r, false),
    "SET" "LOCAL" <r:SetRest> => set_variable_local(r, true),
    "SET" "SESSION" <r:SetRest> => set_variable_local(r, false),
    "RESET" <r:ResetRest> => r,
};

// gram.y `set_rest`: TRANSACTION / SESSION CHARACTERISTICS + set_rest_more.
SetRest: Node = {
    "TRANSACTION" <m:TransactionModeList> => make_set_multi("TRANSACTION", m),
    "SESSION" "CHARACTERISTICS" "AS" "TRANSACTION" <m:TransactionModeList> =>
        make_set_multi("SESSION CHARACTERISTICS", m),
    SetRestMore,
};

// gram.y `set_rest_more`: generic_set + the special syntaxes M9 reaches.
SetRestMore: Node = {
    GenericSet,
    <n:VarName> "FROM" "CURRENT" => make_set_current(n),
    "TIME" "ZONE" <v:ZoneValue> => make_set_timezone(v),
    "TRANSACTION" "SNAPSHOT" <s:"SCONST"> => make_set_transaction_snapshot(s),
};

// gram.y `generic_set`: var_name {TO|=} {var_list|DEFAULT}.
GenericSet: Node = {
    <n:VarName> "TO" <v:VarList> => make_set_value(n, v),
    <n:VarName> "=" <v:VarList> => make_set_value(n, v),
    <n:VarName> "TO" "DEFAULT" => make_set_default(n),
    <n:VarName> "=" "DEFAULT" => make_set_default(n),
};

// gram.y `reset_rest`: generic_reset | TIME ZONE | TRANSACTION ISOLATION LEVEL.
ResetRest: Node = {
    <n:VarName> => make_reset(n),
    "ALL" => make_reset_all(),
    "TIME" "ZONE" => make_reset("timezone".to_string()),
    "TRANSACTION" "ISOLATION" "LEVEL" => make_reset("transaction_isolation".to_string()),
};

// gram.y `var_name`: ColId | var_name '.' ColId.
VarName: String = {
    ColId,
    <l:VarName> "." <r:ColId> => format!("{l}.{r}"),
};

// gram.y `var_list`: comma-separated var_value.
VarList: Vec<Node> = {
    <v:VarValue> => vec![v],
    <mut l:VarList> "," <v:VarValue> => { l.push(v); l },
};

// gram.y `var_value`: opt_boolean_or_string -> string const | NumericOnly -> const.
VarValue: Node = {
    <s:BooleanOrString> => make_string_const(s),
    <i:"ICONST"> => make_int_const(i),
    <f:"FCONST"> => make_float_const(f),
    "-" <i:"ICONST"> => make_int_const(-i),
};

// gram.y `opt_boolean_or_string`: TRUE | FALSE | ON | NonReservedWord | Sconst.
BooleanOrString: String = {
    "TRUE" => "true".to_string(),
    "FALSE" => "false".to_string(),
    "ON" => "on".to_string(),
    <n:ColId> => n,
    <s:"SCONST"> => s,
};

// gram.y `zone_value` (the M9-reachable forms): Sconst | IDENT | DEFAULT | LOCAL.
ZoneValue: Option<String> = {
    <s:"SCONST"> => Some(s),
    <i:"IDENT"> => Some(i),
    "DEFAULT" => None,
    "LOCAL" => None,
};

// gram.y `VariableShowStmt`.
VariableShowStmt: Node = {
    "SHOW" <n:VarName> => make_variable_show(n),
    "SHOW" "TIME" "ZONE" => make_variable_show("timezone".to_string()),
    "SHOW" "TRANSACTION" "ISOLATION" "LEVEL" =>
        make_variable_show("transaction_isolation".to_string()),
    "SHOW" "SESSION" "AUTHORIZATION" => make_variable_show("session_authorization".to_string()),
    "SHOW" "ALL" => make_variable_show("all".to_string()),
};

// ===========================================================================
//  PREPARE / EXECUTE / DEALLOCATE  (M9, step 37): gram.y `PrepareStmt`,
//  `ExecuteStmt`, `DeallocateStmt`.
// ===========================================================================

// gram.y `PrepareStmt: PREPARE name prep_type_clause AS PreparableStmt`. The
// `CREATE TABLE AS EXECUTE` form is staged (deferred) for this milestone.
PrepareStmt: Node = {
    "PREPARE" <n:ColId> <argtypes:PrepTypeClause> "AS" <q:PreparableStmt> =>
        make_prepare_stmt(n, argtypes, q),
};

// gram.y `prep_type_clause: '(' type_list ')' | /*EMPTY*/`.
PrepTypeClause: Vec<TypeName> = {
    "(" <l:TypeList> ")" => l,
    => Vec::new(),
};

// gram.y `type_list: Typename (',' Typename)*`.
TypeList: Vec<TypeName> = {
    <t:Typename> => vec![t],
    <mut l:TypeList> "," <t:Typename> => { l.push(t); l },
};

// gram.y `PreparableStmt: SelectStmt | InsertStmt | UpdateStmt | DeleteStmt | MergeStmt`.
PreparableStmt: Node = {
    SelectStmt,
    InsertStmt,
    UpdateStmt,
    DeleteStmt,
    MergeStmt,
};

// gram.y `ExecuteStmt: EXECUTE name execute_param_clause`. The `CREATE TABLE AS
// EXECUTE` form is staged (deferred) for this milestone.
ExecuteStmt: Node = {
    "EXECUTE" <n:ColId> <params:ExecuteParamClause> => make_execute_stmt(n, params),
};

// gram.y `execute_param_clause: '(' expr_list ')' | /*EMPTY*/`.
ExecuteParamClause: Vec<Node> = {
    "(" <l:ExprList> ")" => l,
    => Vec::new(),
};

// gram.y `DeallocateStmt`: DEALLOCATE [PREPARE] name | DEALLOCATE [PREPARE] ALL.
DeallocateStmt: Node = {
    "DEALLOCATE" <l:@L> <n:ColId> => make_deallocate_stmt(Some(n), l),
    "DEALLOCATE" "PREPARE" <l:@L> <n:ColId> => make_deallocate_stmt(Some(n), l),
    "DEALLOCATE" "ALL" => make_deallocate_stmt(None, -1),
    "DEALLOCATE" "PREPARE" "ALL" => make_deallocate_stmt(None, -1),
};

// ===========================================================================
//  DECLARE CURSOR / CLOSE / FETCH / MOVE  (M9, step 37): gram.y
//  `DeclareCursorStmt`, `ClosePortalStmt`, `FetchStmt`.
// ===========================================================================

// gram.y `DeclareCursorStmt: DECLARE cursor_name cursor_options CURSOR opt_hold
// FOR SelectStmt`. PG always folds in CURSOR_OPT_FAST_PLAN.
DeclareCursorStmt: Node = {
    "DECLARE" <n:ColId> <opts:CursorOptions> "CURSOR" <hold:OptHold> "FOR" <q:SelectStmt> =>
        make_declare_cursor_stmt(n, opts | hold | CursorOptions::FAST_PLAN.bits(), q),
};

// gram.y `cursor_options`: accumulating left-recursive option list (NO SCROLL /
// SCROLL / BINARY / ASENSITIVE / INSENSITIVE).
CursorOptions: i32 = {
    => 0,
    <o:CursorOptions> "NO" "SCROLL" => o | CursorOptions::NO_SCROLL.bits(),
    <o:CursorOptions> "SCROLL" => o | CursorOptions::SCROLL.bits(),
    <o:CursorOptions> "BINARY" => o | CursorOptions::BINARY.bits(),
    <o:CursorOptions> "ASENSITIVE" => o | CursorOptions::ASENSITIVE.bits(),
    <o:CursorOptions> "INSENSITIVE" => o | CursorOptions::INSENSITIVE.bits(),
};

// gram.y `opt_hold: /*EMPTY*/ | WITH HOLD | WITHOUT HOLD`.
OptHold: i32 = {
    => 0,
    "WITH" "HOLD" => CursorOptions::HOLD.bits(),
    "WITHOUT" "HOLD" => 0,
};

// gram.y `ClosePortalStmt: CLOSE cursor_name | CLOSE ALL`.
ClosePortalStmt: Node = {
    "CLOSE" <n:ColId> => make_close_portal_stmt(Some(n)),
    "CLOSE" "ALL" => make_close_portal_stmt(None),
};

// gram.y `FetchStmt: FETCH fetch_args | MOVE fetch_args`. The fetch_args build a
// FetchStmt with ismove=false; the MOVE wrapper flips ismove. The grammar uses
// `opt_from_in` (FROM/IN/empty) after the direction keyword.
//
// STAGED (dropped) fetch_args forms vs PG gram.y, to keep the LALR table
// conflict-free for M9: none -- every PG fetch_args alternative is reachable here.
// (SignedIconst is ICONST-only; a negative-count `FETCH -1 c` is staged with the
// signed-iconst minus, matching the task's M9 scope.)
FetchStmt: Node = {
    "FETCH" <f:FetchArgs> => f,
    "MOVE" <f:FetchArgs> => set_fetch_ismove(f),
};

FetchArgs: Node = {
    <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    FromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "NEXT" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "PRIOR" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "FIRST" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, 1, n, false),
    "LAST" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, -1, n, false),
    "ABSOLUTE" <i:SignedIconst> OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::ABSOLUTE, i, n, false),
    "RELATIVE" <i:SignedIconst> OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::RELATIVE, i, n, false),
    <i:SignedIconst> OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    "ALL" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "FORWARD" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "FORWARD" <i:SignedIconst> OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    "FORWARD" "ALL" OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "BACKWARD" OptFromIn <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "BACKWARD" <i:SignedIconst> OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, i, n, false),
    "BACKWARD" "ALL" OptFromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, FETCH_ALL, n, false),
};

// gram.y `from_in: FROM | IN_P`.
FromIn: () = {
    "FROM" => (),
    "IN" => (),
};

// gram.y `opt_from_in: from_in | /*EMPTY*/`.
OptFromIn: () = {
    FromIn => (),
    => (),
};

// gram.y `SignedIconst: Iconst | '+' Iconst | '-' Iconst`. M9 reaches the plain
// ICONST (a leading sign is staged: `FETCH -1 c` is deferred to keep the count an
// i64 without a sign-prefix conflict against the unary-minus expression path).
SignedIconst: i64 = {
    <i:"ICONST"> => i64::from(i),
};

// gram.y `NumericOnly` (sequence-option subset): a signed integer. Reached only
// after a sequence-option keyword (INCREMENT/START/...), where a leading `-`/`+` is
// unambiguous (no expression tier here), so it needs no UMINUS conflict guard.
SeqNumeric: i64 = {
    <i:"ICONST"> => i64::from(i),
    "+" <i:"ICONST"> => i64::from(i),
    "-" <i:"ICONST"> => -i64::from(i),
};

// ===========================================================================
//  SELECT
// ===========================================================================

// gram.y `SelectStmt`: select_no_parens | select_with_parens. The paren form and
// the with/sort/locking/limit wrappers in select_no_parens arrive at their
// milestones (M5 sort/limit, M12 set ops).
SelectStmt: Node = {
    SelectNoParens,
};

// gram.y `select_no_parens`: a `simple_select` optionally followed by ORDER BY and
// LIMIT/OFFSET (the trailing `opt_sort_clause opt_select_limit` arm). The sort and
// limit clauses are stamped onto the SelectStmt built by `simple_select` (PG's
// insertSelectOptions). The WITH / FOR-locking wrappers grow at their milestones.
SelectNoParens: Node = {
    SimpleSelect,
    <s:SimpleSelect> <sort:SortClause> => insert_select_options(s, sort, None, None),
    <s:SimpleSelect> <lim:SelectLimit> =>
        insert_select_options(s, Vec::new(), lim.0, lim.1),
    <s:SimpleSelect> <sort:SortClause> <lim:SelectLimit> =>
        insert_select_options(s, sort, lim.0, lim.1),
    // M8 (step 34): the `for_locking_clause` wrapper (`SELECT ... FOR UPDATE`).
    // The grammar allows it after an optional ORDER BY (PG's opt_sort_clause).
    <s:SimpleSelect> <lock:ForLockingClause> => set_select_locking(s, lock),
    <s:SimpleSelect> <sort:SortClause> <lock:ForLockingClause> =>
        set_select_locking(insert_select_options(s, sort, None, None), lock),
};

SelectClause: Node = {
    SimpleSelect,
};

// gram.y `simple_select`. M5 (step 26) reaches the `SELECT [DISTINCT] target_list
// FROM ... WHERE ... GROUP BY ...` shape; HAVING/WINDOW/VALUES/TABLE and the set
// operations are added at their milestones.
SimpleSelect: Node = {
    "SELECT" <distinct:OptDistinctClause> <targets:OptTargetList> <frm:FromClause>
        <whr:WhereClause> <grp:GroupClause> => {
        let n = SelectStmt {
            distinctClause: distinct,
            intoClause: None,
            targetList: targets,
            fromClause: frm,
            whereClause: whr,
            groupClause: grp,
            groupDistinct: false,
            havingClause: None,
            windowClause: Vec::new(),
            valuesLists: Vec::new(),
            sortClause: Vec::new(),
            limitOffset: None,
            limitCount: None,
            limitOption: crate::nodes::nodes::LimitOption::COUNT,  // makeNode zero default
            lockingClause: Vec::new(),
            withClause: None,
            op: crate::nodes::parsenodes::SetOperation::NONE,
            all: false,
            larg: None,
            rarg: None,
        };
        Node::SelectStmt(Box::new(n))
    },
};

// gram.y `distinct_clause` / `opt_all_clause` (the `SELECT [ALL|DISTINCT]` prefix).
// gram.y `distinct_clause: DISTINCT` returns `list_make1(NIL)` -- a one-element
// list whose lone element is NULL, distinguishing "DISTINCT (over all columns)"
// from "no DISTINCT" (an empty list). The port has no NIL Node, so the marker is a
// bare `A_Star` (transformDistinctClause keys off the list being non-empty with a
// NULL/A_Star head). `DISTINCT ON (...)` grows later.
OptDistinctClause: Vec<Node> = {
    "DISTINCT" => vec![Node::A_Star(Box::new(crate::nodes::parsenodes::A_Star {}))],
    "ALL" => Vec::new(),
    => Vec::new(),
};

// gram.y `group_clause: GROUP BY set_quantifier group_by_list | /*EMPTY*/`. M5
// covers `GROUP BY a, b, ...` (plain expression group items); ROLLUP/CUBE/GROUPING
// SETS grow with the grouping-set machinery.
GroupClause: Vec<Node> = {
    "GROUP" "BY" <list:GroupByList> => list,
    => Vec::new(),
};

GroupByList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:GroupByList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  ORDER BY  (gram.y sort_clause -> sortby_list -> sortby)
// ===========================================================================

// gram.y `sort_clause: ORDER BY sortby_list`.
SortClause: Vec<Node> = {
    "ORDER" "BY" <list:SortbyList> => list,
};

SortbyList: Vec<Node> = {
    <s:Sortby> => vec![s],
    <mut list:SortbyList> "," <s:Sortby> => { list.push(s); list },
};

// gram.y `sortby: a_expr opt_asc_desc opt_nulls_order`. The USING-operator form
// (`a_expr USING op`) grows with operator-class ordering. Builds a SortBy node.
Sortby: Node = {
    <e:AExpr> <dir:OptAscDesc> <nulls:OptNullsOrder> => make_sortby(e, dir, nulls),
};

OptAscDesc: SortByDir = {
    "ASC"  => SortByDir::ASC,
    "DESC" => SortByDir::DESC,
    => SortByDir::DEFAULT,
};

OptNullsOrder: SortByNulls = {
    "NULLS" "FIRST" => SortByNulls::FIRST,
    "NULLS" "LAST"  => SortByNulls::LAST,
    => SortByNulls::DEFAULT,
};

// ===========================================================================
//  LIMIT / OFFSET  (gram.y select_limit -> limit_clause / offset_clause)
// ===========================================================================

// gram.y `select_limit`: any combination of LIMIT and OFFSET, in either order.
// Returns (limitOffset, limitCount). FETCH FIRST / WITH TIES grow at their
// milestone; M5 covers `LIMIT count`, `OFFSET n`, and both orders.
SelectLimit: (Option<Node>, Option<Node>) = {
    <c:LimitClause> <o:OffsetClause> => (Some(o), c),
    <o:OffsetClause> <c:LimitClause> => (Some(o), c),
    <c:LimitClause> => (None, c),
    <o:OffsetClause> => (Some(o), None),
};

// gram.y `limit_clause: LIMIT select_limit_value`. `LIMIT ALL` is no count (None).
LimitClause: Option<Node> = {
    "LIMIT" <e:AExpr> => Some(e),
    "LIMIT" "ALL" => None,
};

// gram.y `offset_clause: OFFSET select_offset_value`.
OffsetClause: Node = {
    "OFFSET" <e:AExpr> => e,
};

// ===========================================================================
//  FOR locking clause  (gram.y for_locking_clause -> for_locking_items -> for_locking_item)
//  M8 (step 34): `FOR UPDATE/SHARE/NO KEY UPDATE/KEY SHARE [OF rel,...] [NOWAIT|SKIP LOCKED]`.
// ===========================================================================

ForLockingClause: LockingClause = {
    "FOR" <s:LockStrength> <of:LockedRelsList> <wp:OptNowait> =>
        make_locking_clause(s, of, wp),
};

LockStrength: LockClauseStrength = {
    "UPDATE"          => LockClauseStrength::FORUPDATE,
    "NO" "KEY" "UPDATE" => LockClauseStrength::FORNOKEYUPDATE,
    "SHARE"           => LockClauseStrength::FORSHARE,
    "KEY" "SHARE"     => LockClauseStrength::FORKEYSHARE,
};

// gram.y `locked_rels_list: OF qualified_name_list | /*EMPTY*/`. Each named rel
// is a RangeVar marking which FROM items the lock applies to.
LockedRelsList: Vec<Node> = {
    "OF" <list:QualifiedNameList> => list,
    => Vec::new(),
};

QualifiedNameList: Vec<Node> = {
    <n:QualifiedName> => vec![Node::RangeVar(Box::new(n))],
    <mut list:QualifiedNameList> "," <n:QualifiedName> =>
        { list.push(Node::RangeVar(Box::new(n))); list },
};

// gram.y `opt_nowait_or_skip: NOWAIT | SKIP LOCKED | /*EMPTY*/`.
OptNowait: LockWaitPolicy = {
    "NOWAIT"        => LockWaitPolicy::LockWaitError,
    "SKIP" "LOCKED" => LockWaitPolicy::LockWaitSkip,
    => LockWaitPolicy::LockWaitBlock,
};

// ===========================================================================
//  FROM clause  (gram.y from_clause -> from_list -> table_ref)
// ===========================================================================

// gram.y `from_clause: FROM from_list | /*EMPTY*/`. M2 covers a comma-separated
// list of plain table references (cross-product, no JOIN syntax yet).
FromClause: Vec<Node> = {
    "FROM" <list:FromList> => list,
    => Vec::new(),
};

FromList: Vec<Node> = {
    <t:TableRef> => vec![t],
    <mut list:FromList> "," <t:TableRef> => { list.push(t); list },
};

// gram.y `table_ref`: a FROM item. M7 (step 32) covers a plain table (with an
// optional alias), a parenthesized joined table (with an optional alias), and the
// left-recursive `joined_table` JOIN chain. Subquery / function FROM items grow at
// their milestones.
//
// To keep the LALR table unambiguous, the JOIN chain (`JoinedTable`) is
// left-recursive over `TableRef` with a NON-join right operand (`TableAtom`):
// `a JOIN b JOIN c` parses left-associatively as `(a JOIN b) JOIN c`, matching PG.
TableRef: Node = {
    TableAtom,
    JoinedTable,
};

// A non-join FROM atom: a plain (aliased) table or a parenthesized join (aliased).
TableAtom: Node = {
    <r:QualifiedName> <a:OptAliasClause> => make_range_var_table_ref(apply_rangevar_alias(r, a)),
    "(" <j:JoinedTable> ")" <a:OptAliasClause> => apply_join_alias(j, a),
};

// gram.y `joined_table`. M7 reaches the cross join (`a CROSS JOIN b`), the
// qualified join (`a [INNER] JOIN b ON expr` / `... USING (cols)`), and the outer
// join spellings (LEFT/RIGHT/FULL [OUTER] JOIN ... ON/USING). The executor only
// emits INNER joins this milestone; the outer-join parse is accepted so the
// grammar is complete (the planner/executor outer-join emit grows next). The join
// type is split into explicit productions rather than an optional nonterminal, so
// the LALR table has no empty-reduction conflict on the first JOIN keyword.
JoinedTable: Node = {
    <l:TableRef> "CROSS" "JOIN" <r:TableAtom> =>
        make_join_expr(JoinType::INNER, l, r, None, Vec::new()),
    <l:TableRef> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> "INNER" "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> <jt:OuterJoinType> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(jt, l, r, q.0, q.1),
};

// gram.y `join_type: LEFT/RIGHT/FULL [OUTER]` (the OUTER noise word is optional).
OuterJoinType: JoinType = {
    "LEFT" OptOuter => JoinType::LEFT,
    "RIGHT" OptOuter => JoinType::RIGHT,
    "FULL" OptOuter => JoinType::FULL,
};

OptOuter: () = { "OUTER" => (), => () };

// gram.y `join_qual: ON a_expr | USING '(' name_list ')'`. Returns the ON-quals or
// the USING column list (mutually exclusive).
JoinQual: (Option<Node>, Vec<String>) = {
    "ON" <q:AExpr> => (Some(q), Vec::new()),
    "USING" "(" <cols:NameList> ")" => (None, cols),
};

// gram.y `opt_alias_clause`: alias_clause | /*EMPTY*/.
OptAliasClause: Option<crate::nodes::primnodes::Alias> = {
    AliasClause => Some(<>),
    => None,
};

// gram.y `alias_clause: AS ColId | ColId` (the column-alias-list form grows later).
AliasClause: crate::nodes::primnodes::Alias = {
    "AS" <n:ColId> => make_alias(n),
    <n:ColId> => make_alias(n),
};

// gram.y `name_list: name | name_list ',' name` (USING column list).
NameList: Vec<String> = {
    <n:ColId> => vec![n],
    <mut list:NameList> "," <n:ColId> => { list.push(n); list },
};

// gram.y `where_clause: WHERE a_expr | /*EMPTY*/`. The qual expression is
// transformed (-> bool) at analysis time; CURRENT OF grows at its milestone.
WhereClause: Option<Node> = {
    "WHERE" <e:AExpr> => Some(e),
    => None,
};

// ===========================================================================
//  Target list
// ===========================================================================

OptTargetList: Vec<Node> = {
    TargetList,
    => Vec::new(),         // gram.y opt_target_list: /*EMPTY*/
};

TargetList: Vec<Node> = {
    <t:TargetEl> => vec![t],
    <mut list:TargetList> "," <t:TargetEl> => { list.push(t); list },
};

// gram.y `target_el`. '*', a bare expression, and `a_expr AS ColLabel` are the
// M1 reachable forms; the bare-label (no-AS) and full ColLabel keyword set arrive
// with the keyword/label machinery. ColLabel is restricted to IDENT for now.
TargetEl: Node = {
    <v:AExpr> "AS" <n:"IDENT"> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    <v:AExpr> => {
        let rt = ResTarget { name: None, indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    "*" => make_star_target(),
};

// ===========================================================================
//  Expressions  (gram.y a_expr -> c_expr -> AexprConst).  The full operator /
//  comparison / function tower is built out in M3+.
// ===========================================================================

// gram.y `a_expr` is one big rule whose alternatives carry %prec annotations; we
// reproduce its operator precedence (gram.y's %left/%nonassoc/%right table) with
// a precedence-tier nonterminal cascade instead. Loosest binding first:
//   OR  <  AND  <  NOT  <  comparison(nonassoc)  <  '+' '-'  <  '*' '/' '%'  <
//   unary '-'  <  c_expr.
// M3 reaches the boolean (AND/OR/NOT), comparison, and arithmetic operators over
// the c_expr leaves; IS / BETWEEN / IN / LIKE / casts etc. grow at their
// milestones. Every alternative is complete.
AExpr: Node = {
    OrExpr,
};

// gram.y `a_expr OR a_expr` (%left OR). A_Expr boolean op -> BoolExpr(OR).
OrExpr: Node = {
    <l:OrExpr> "OR" <r:AndExpr> => make_or_expr(l, r),
    AndExpr,
};

// gram.y `a_expr AND a_expr` (%left AND).
AndExpr: Node = {
    <l:AndExpr> "AND" <r:NotExpr> => make_and_expr(l, r),
    NotExpr,
};

// gram.y `NOT a_expr` (%right NOT).
NotExpr: Node = {
    "NOT" <e:NotExpr> => make_not_expr(e),
    CompareExpr,
};

// gram.y comparison operators (%nonassoc: no chaining, so the operands are the
// next-tighter tier). Each builds an A_Expr(OP) over the named operator.
CompareExpr: Node = {
    <l:AddExpr> "<"  <r:AddExpr> => make_a_expr("<", l, r),
    <l:AddExpr> ">"  <r:AddExpr> => make_a_expr(">", l, r),
    <l:AddExpr> "="  <r:AddExpr> => make_a_expr("=", l, r),
    <l:AddExpr> "<=" <r:AddExpr> => make_a_expr("<=", l, r),
    <l:AddExpr> ">=" <r:AddExpr> => make_a_expr(">=", l, r),
    <l:AddExpr> "<>" <r:AddExpr> => make_a_expr("<>", l, r),
    AddExpr,
};

// gram.y `a_expr '+'/'-' a_expr` (%left '+' '-').
AddExpr: Node = {
    <l:AddExpr> "+" <r:MulExpr> => make_a_expr("+", l, r),
    <l:AddExpr> "-" <r:MulExpr> => make_a_expr("-", l, r),
    MulExpr,
};

// gram.y `a_expr '*'/'/'/'%' a_expr` (%left '*' '/' '%').
MulExpr: Node = {
    <l:MulExpr> "*" <r:UnaryExpr> => make_a_expr("*", l, r),
    <l:MulExpr> "/" <r:UnaryExpr> => make_a_expr("/", l, r),
    <l:MulExpr> "%" <r:UnaryExpr> => make_a_expr("%", l, r),
    UnaryExpr,
};

// gram.y `'-' a_expr %prec UMINUS` / `'+' a_expr %prec UMINUS` (%right UMINUS).
// A leading '-' on a constant negates it in place (doNegate); over a non-constant
// it becomes the unary-minus operator A_Expr (deferred to its milestone in
// do_negate). A leading '+' is a no-op.
UnaryExpr: Node = {
    "-" <e:UnaryExpr> => do_negate(e),
    "+" <e:UnaryExpr> => e,
    TypecastExpr,
};

// gram.y `a_expr TYPECAST Typename` (%left TYPECAST -- binds tighter than the
// arithmetic/unary operators). A postfix chain of `:: Typename` casts; each builds a
// TypeCast node over the inner expression (M4, step 23).
TypecastExpr: Node = {
    <e:TypecastExpr> "::" <t:Typename> => make_type_cast(e, t),
    CExpr,
};

CExpr: Node = {
    AexprConst,
    // gram.y `c_expr: PARAM opt_indirection`. A `$n` positional parameter; the
    // opt_indirection (subscript/field on the param) grows with A_Indirection.
    <l:@L> <n:"PARAM"> => make_param_ref(n, l),
    // gram.y `c_expr: columnref`. A bare or table-qualified column reference.
    ColumnRef,
    // gram.y `c_expr: '(' a_expr ')'`.
    "(" <e:AExpr> ")" => e,
    // gram.y `c_expr: func_expr`.
    FuncExpr,
    // gram.y `c_expr: case_expr` (M4, step 23).
    CaseExpr,
};

// gram.y `func_expr: func_application ... | func_expr_common_subexpr`. M3 reaches a
// plain function call `name ( arglist )`; M4 (step 23) adds the cast/conditional
// special forms (CAST, COALESCE, NULLIF, GREATEST, LEAST). WITHIN GROUP / FILTER /
// OVER and the remaining common-subexpr forms (CURRENT_DATE, ...) grow later.
FuncExpr: Node = {
    FuncApplication,
    FuncExprCommonSubexpr,
};

// gram.y `func_expr_common_subexpr` (M4 subset): the SQL-keyword "function" forms.
//   CAST '(' a_expr AS Typename ')'   -> a TypeCast (explicit cast)
//   COALESCE '(' expr_list ')'        -> a CoalesceExpr
//   GREATEST '(' expr_list ')'        -> a MinMaxExpr(IS_GREATEST)
//   LEAST '(' expr_list ')'           -> a MinMaxExpr(IS_LEAST)
//   NULLIF '(' a_expr ',' a_expr ')'  -> an A_Expr(AEXPR_NULLIF, "=")
FuncExprCommonSubexpr: Node = {
    "CAST" "(" <e:AExpr> "AS" <t:Typename> ")" => make_type_cast(e, t),
    "COALESCE" "(" <args:ExprList> ")" => make_coalesce_expr(args),
    "GREATEST" "(" <args:ExprList> ")" => make_min_max_expr(true, args),
    "LEAST" "(" <args:ExprList> ")" => make_min_max_expr(false, args),
    "NULLIF" "(" <l:AExpr> "," <r:AExpr> ")" => make_nullif_expr(l, r),
};

// gram.y `case_expr: CASE case_arg when_clause_list case_default END`.
// The optional `case_arg` is the simple-CASE test value; `when_clause_list` is one
// or more WHEN..THEN arms; `case_default` is the optional ELSE.
CaseExpr: Node = {
    "CASE" <arg:CaseArg> <whens:WhenClauseList> <def:CaseDefault> "END" =>
        make_case_expr(arg, whens, def),
};

// gram.y `case_arg: a_expr | /*EMPTY*/`.
CaseArg: Option<Node> = {
    <e:AExpr> => Some(e),
    => None,
};

// gram.y `when_clause_list: when_clause | when_clause_list when_clause`.
WhenClauseList: Vec<Node> = {
    <w:WhenClause> => vec![w],
    <mut list:WhenClauseList> <w:WhenClause> => { list.push(w); list },
};

// gram.y `when_clause: WHEN a_expr THEN a_expr` -> a CaseWhen node.
WhenClause: Node = {
    "WHEN" <c:AExpr> "THEN" <r:AExpr> => make_case_when(c, r),
};

// gram.y `case_default: ELSE a_expr | /*EMPTY*/`.
CaseDefault: Option<Node> = {
    "ELSE" <e:AExpr> => Some(e),
    => None,
};

// gram.y `func_application: func_name '(' func_arg_list ')' | func_name '(' '*' ')'
// | func_name '(' DISTINCT func_arg_list ')' | func_name '(' ')'`. M5 (step 26)
// adds the aggregate spellings: `count(*)` (agg_star) and `agg(DISTINCT expr)`
// (agg_distinct). VARIADIC / ORDER BY / named args grow at their milestones.
FuncApplication: Node = {
    <n:ColId> "(" ")" => make_func_call(vec![n], Vec::new()),
    <n:ColId> "(" <args:ExprList> ")" => make_func_call(vec![n], args),
    <n:ColId> "(" "*" ")" => make_agg_star_call(vec![n]),
    <n:ColId> "(" "DISTINCT" <args:ExprList> ")" => make_distinct_func_call(vec![n], args),
};

// gram.y `columnref: ColId | ColId indirection`. M2 covers `col` and
// `table.col`; the general indirection (subscripts, `.*` mid-chain) grows with
// the A_Indirection machinery.
ColumnRef: Node = {
    <n:ColId> => make_column_ref(vec![n]),
    <t:ColId> "." <n:ColId> => make_column_ref(vec![t, n]),
};

// gram.y `AexprConst`. Iconst/FCONST/Sconst are the plain forms; M4 (step 23) adds
// the typed-literal forms `Numeric Sconst` / `ConstTypename Sconst` (e.g.
// `NUMERIC '1.5'`, `DATE '2024-01-15'`), which PG builds as a string A_Const wrapped
// in a TypeCast to the named type (makeStringConstCast). BCONST/XCONST and the
// func_name-Sconst / typmod'd forms grow later.
AexprConst: Node = {
    <i:"ICONST"> => make_int_const(i),
    <f:"FCONST"> => make_float_const(f),
    <s:"SCONST"> => make_string_const(s),
    // gram.y `ConstTypename Sconst` / `Numeric Sconst`: the typed-literal form
    // `typename 'string'` (e.g. `NUMERIC '1.5'`, `DATE '2024-01-15'`). Reuses the
    // single shared `SimpleTypename` (no duplicate keyword nonterminal) so the only
    // decision after a type keyword is shift-SCONST vs reduce-to-SimpleTypename --
    // resolved by lalrpop toward the typed-literal on SCONST lookahead.
    <t:SimpleTypename> <s:"SCONST"> => make_string_const_cast(s, t),
};

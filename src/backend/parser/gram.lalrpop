// ===========================================================================
//  Transaction control (M9, step 36): gram.y `TransactionStmt` +
//  `TransactionStmtLegacy`.
// ===========================================================================

// gram.y `TransactionStmt`: the non-legacy transaction-control statements.
TransactionStmt: Node = {
    "ABORT" OptTransaction =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, false),
    "ABORT" OptTransaction "AND" "CHAIN" =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, true),
    "ABORT" OptTransaction "AND" "NO" "CHAIN" =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, false),
    "START" "TRANSACTION" <m:TransactionModeListOrEmpty> =>
        make_transaction_stmt(TxKind::START, m, None, None, false),
    "COMMIT" OptTransaction =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, false),
    "COMMIT" OptTransaction "AND" "CHAIN" =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, true),
    "COMMIT" OptTransaction "AND" "NO" "CHAIN" =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, false),
    "ROLLBACK" OptTransaction =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, false),
    "ROLLBACK" OptTransaction "AND" "CHAIN" =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, true),
    "ROLLBACK" OptTransaction "AND" "NO" "CHAIN" =>
        make_transaction_stmt(TxKind::ROLLBACK, Vec::new(), None, None, false),
    "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::SAVEPOINT, Vec::new(), Some(n), None, false),
    "RELEASE" "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::RELEASE, Vec::new(), Some(n), None, false),
    "RELEASE" <n:ColId> =>
        make_transaction_stmt(TxKind::RELEASE, Vec::new(), Some(n), None, false),
    "ROLLBACK" OptTransaction "TO" "SAVEPOINT" <n:ColId> =>
        make_transaction_stmt(TxKind::ROLLBACK_TO, Vec::new(), Some(n), None, false),
    "ROLLBACK" OptTransaction "TO" <n:ColId> =>
        make_transaction_stmt(TxKind::ROLLBACK_TO, Vec::new(), Some(n), None, false),
    "PREPARE" "TRANSACTION" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::PREPARE, Vec::new(), None, Some(gid), false),
    "COMMIT" "PREPARED" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::COMMIT_PREPARED, Vec::new(), None, Some(gid), false),
    "ROLLBACK" "PREPARED" <gid:"SCONST"> =>
        make_transaction_stmt(TxKind::ROLLBACK_PREPARED, Vec::new(), None, Some(gid), false),
};

// gram.y `TransactionStmtLegacy`: BEGIN / END (top level only).
TransactionStmtLegacy: Node = {
    "BEGIN" OptTransaction <m:TransactionModeListOrEmpty> =>
        make_transaction_stmt(TxKind::BEGIN, m, None, None, false),
    "END" OptTransaction =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, false),
    "END" OptTransaction "AND" "CHAIN" =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, true),
    "END" OptTransaction "AND" "NO" "CHAIN" =>
        make_transaction_stmt(TxKind::COMMIT, Vec::new(), None, None, false),
};

// gram.y `opt_transaction`: WORK | TRANSACTION | empty (noise words).
OptTransaction: () = {
    "WORK" => (),
    "TRANSACTION" => (),
    => (),
};


// gram.y `transaction_mode_list_or_empty`.
TransactionModeListOrEmpty: Vec<Node> = {
    TransactionModeList,
    => Vec::new(),
};

// gram.y `transaction_mode_list`: comma-separated OR space-separated (PG historic).
TransactionModeList: Vec<Node> = {
    <i:TransactionModeItem> => vec![i],
    <mut l:TransactionModeList> "," <i:TransactionModeItem> => { l.push(i); l },
    <mut l:TransactionModeList> <i:TransactionModeItem> => { l.push(i); l },
};

// gram.y `transaction_mode_item`.
TransactionModeItem: Node = {
    "ISOLATION" "LEVEL" <lv:IsoLevel> =>
        make_def_elem_str("transaction_isolation", lv),
    "READ" "ONLY" => make_def_elem_bool("transaction_read_only", true),
    "READ" "WRITE" => make_def_elem_bool("transaction_read_only", false),
    "DEFERRABLE" => make_def_elem_bool("transaction_deferrable", true),
    "NOT" "DEFERRABLE" => make_def_elem_bool("transaction_deferrable", false),
};

// gram.y `iso_level`.
IsoLevel: &'static str = {
    "READ" "UNCOMMITTED" => "read uncommitted",
    "READ" "COMMITTED" => "read committed",
    "REPEATABLE" "READ" => "repeatable read",
    "SERIALIZABLE" => "serializable",
};

// ===========================================================================
//  SET / RESET / SHOW (M9, step 36): gram.y `VariableSetStmt` / `VariableShowStmt`.
// ===========================================================================

// gram.y `VariableSetStmt`: SET [SESSION|LOCAL] set_rest | RESET reset_rest.
VariableSetStmt: Node = {
    "SET" <r:SetRest> => set_variable_local(r, false),
    "SET" "LOCAL" <r:SetRest> => set_variable_local(r, true),
    "SET" "SESSION" <r:SetRest> => set_variable_local(r, false),
    "RESET" <r:ResetRest> => r,
};

// gram.y `set_rest`: TRANSACTION / SESSION CHARACTERISTICS + set_rest_more.
SetRest: Node = {
    "TRANSACTION" <m:TransactionModeList> => make_set_multi("TRANSACTION", m),
    "SESSION" "CHARACTERISTICS" "AS" "TRANSACTION" <m:TransactionModeList> =>
        make_set_multi("SESSION CHARACTERISTICS", m),
    SetRestMore,
};

// gram.y `set_rest_more`: generic_set + the special syntaxes M9 reaches.
SetRestMore: Node = {
    GenericSet,
    <n:VarName> "FROM" "CURRENT" => make_set_current(n),
    "TIME" "ZONE" <v:ZoneValue> => make_set_timezone(v),
    "TRANSACTION" "SNAPSHOT" <s:"SCONST"> => make_set_transaction_snapshot(s),
};

// gram.y `generic_set`: var_name {TO|=} {var_list|DEFAULT}.
GenericSet: Node = {
    <n:VarName> "TO" <v:VarList> => make_set_value(n, v),
    <n:VarName> "=" <v:VarList> => make_set_value(n, v),
    <n:VarName> "TO" "DEFAULT" => make_set_default(n),
    <n:VarName> "=" "DEFAULT" => make_set_default(n),
};

// gram.y `reset_rest`: generic_reset | TIME ZONE | TRANSACTION ISOLATION LEVEL.
ResetRest: Node = {
    <n:VarName> => make_reset(n),
    "ALL" => make_reset_all(),
    "TIME" "ZONE" => make_reset("timezone".to_string()),
    "TRANSACTION" "ISOLATION" "LEVEL" => make_reset("transaction_isolation".to_string()),
};

// gram.y `var_name`: ColId | var_name '.' ColId.
VarName: String = {
    ColId,
    <l:VarName> "." <r:ColId> => format!("{l}.{r}"),
};

// gram.y `var_list`: comma-separated var_value.
VarList: Vec<Node> = {
    <v:VarValue> => vec![v],
    <mut l:VarList> "," <v:VarValue> => { l.push(v); l },
};

// gram.y `var_value`: opt_boolean_or_string -> string const | NumericOnly -> const.
VarValue: Node = {
    <s:BooleanOrString> => make_string_const(s),
    <i:"ICONST"> => make_int_const(i),
    <f:"FCONST"> => make_float_const(f),
    "-" <i:"ICONST"> => make_int_const(-i),
};

// gram.y `opt_boolean_or_string`: TRUE | FALSE | ON | NonReservedWord | Sconst.
BooleanOrString: String = {
    "TRUE" => "true".to_string(),
    "FALSE" => "false".to_string(),
    "ON" => "on".to_string(),
    <n:ColId> => n,
    <s:"SCONST"> => s,
};

// gram.y `zone_value` (the M9-reachable forms): Sconst | IDENT | DEFAULT | LOCAL.
ZoneValue: Option<String> = {
    <s:"SCONST"> => Some(s),
    <i:"IDENT"> => Some(i),
    "DEFAULT" => None,
    "LOCAL" => None,
};

// gram.y `VariableShowStmt`.
VariableShowStmt: Node = {
    "SHOW" <n:VarName> => make_variable_show(n),
    "SHOW" "TIME" "ZONE" => make_variable_show("timezone".to_string()),
    "SHOW" "TRANSACTION" "ISOLATION" "LEVEL" =>
        make_variable_show("transaction_isolation".to_string()),
    "SHOW" "SESSION" "AUTHORIZATION" => make_variable_show("session_authorization".to_string()),
    "SHOW" "ALL" => make_variable_show("all".to_string()),
};

// ===========================================================================
//  PREPARE / EXECUTE / DEALLOCATE  (M9, step 37): gram.y `PrepareStmt`,
//  `ExecuteStmt`, `DeallocateStmt`.
// ===========================================================================

// gram.y `PrepareStmt: PREPARE name prep_type_clause AS PreparableStmt`. The
// `CREATE TABLE AS EXECUTE` form is staged (deferred) for this milestone.
PrepareStmt: Node = {
    "PREPARE" <n:ColId> <argtypes:PrepTypeClause> "AS" <q:PreparableStmt> =>
        make_prepare_stmt(n, argtypes, q),
};

// gram.y `prep_type_clause: '(' type_list ')' | /*EMPTY*/`.
PrepTypeClause: Vec<TypeName> = {
    "(" <l:TypeList> ")" => l,
    => Vec::new(),
};

// gram.y `type_list: Typename (',' Typename)*`.
TypeList: Vec<TypeName> = {
    <t:Typename> => vec![t],
    <mut l:TypeList> "," <t:Typename> => { l.push(t); l },
};

// gram.y `PreparableStmt: SelectStmt | InsertStmt | UpdateStmt | DeleteStmt | MergeStmt`.
PreparableStmt: Node = {
    SelectStmt,
    InsertStmt,
    UpdateStmt,
    DeleteStmt,
    MergeStmt,
};

// gram.y `ExecuteStmt: EXECUTE name execute_param_clause`. The `CREATE TABLE AS
// EXECUTE` form is staged (deferred) for this milestone.
ExecuteStmt: Node = {
    "EXECUTE" <n:ColId> => make_execute_stmt(n, Vec::new()),
    "EXECUTE" <n:ColId> "(" <params:ExprList> ")" => make_execute_stmt(n, params),
};


// gram.y `DeallocateStmt`: DEALLOCATE [PREPARE] name | DEALLOCATE [PREPARE] ALL.
DeallocateStmt: Node = {
    "DEALLOCATE" <l:@L> <n:ColId> => make_deallocate_stmt(Some(n), l),
    "DEALLOCATE" "PREPARE" <l:@L> <n:ColId> => make_deallocate_stmt(Some(n), l),
    "DEALLOCATE" "ALL" => make_deallocate_stmt(None, -1),
    "DEALLOCATE" "PREPARE" "ALL" => make_deallocate_stmt(None, -1),
};

// ===========================================================================
//  DECLARE CURSOR / CLOSE / FETCH / MOVE  (M9, step 37): gram.y
//  `DeclareCursorStmt`, `ClosePortalStmt`, `FetchStmt`.
// ===========================================================================

// gram.y `DeclareCursorStmt: DECLARE cursor_name cursor_options CURSOR opt_hold
// FOR SelectStmt`. PG always folds in CURSOR_OPT_FAST_PLAN.
DeclareCursorStmt: Node = {
    "DECLARE" <n:ColId> <opts:CursorOptions> "CURSOR" <hold:OptHold> "FOR" <q:SelectStmt> =>
        make_declare_cursor_stmt(n, opts | hold | CursorOptions::FAST_PLAN.bits(), q),
};

// gram.y `cursor_options`: accumulating left-recursive option list (NO SCROLL /
// SCROLL / BINARY / ASENSITIVE / INSENSITIVE).
CursorOptions: i32 = {
    => 0,
    <o:CursorOptions> "NO" "SCROLL" => o | CursorOptions::NO_SCROLL.bits(),
    <o:CursorOptions> "SCROLL" => o | CursorOptions::SCROLL.bits(),
    <o:CursorOptions> "BINARY" => o | CursorOptions::BINARY.bits(),
    <o:CursorOptions> "ASENSITIVE" => o | CursorOptions::ASENSITIVE.bits(),
    <o:CursorOptions> "INSENSITIVE" => o | CursorOptions::INSENSITIVE.bits(),
};

// gram.y `opt_hold: /*EMPTY*/ | WITH HOLD | WITHOUT HOLD`.
OptHold: i32 = {
    => 0,
    "WITH" "HOLD" => CursorOptions::HOLD.bits(),
    "WITHOUT" "HOLD" => 0,
};

// gram.y `ClosePortalStmt: CLOSE cursor_name | CLOSE ALL`.
ClosePortalStmt: Node = {
    "CLOSE" <n:ColId> => make_close_portal_stmt(Some(n)),
    "CLOSE" "ALL" => make_close_portal_stmt(None),
};

// gram.y `FetchStmt: FETCH fetch_args | MOVE fetch_args`. The fetch_args build a
// FetchStmt with ismove=false; the MOVE wrapper flips ismove. The grammar uses
// `opt_from_in` (FROM/IN/empty) after the direction keyword.
//
// STAGED (dropped) fetch_args forms vs PG gram.y, to keep the LALR table
// conflict-free for M9: none -- every PG fetch_args alternative is reachable here.
// (SignedIconst is ICONST-only; a negative-count `FETCH -1 c` is staged with the
// signed-iconst minus, matching the task's M9 scope.)
FetchStmt: Node = {
    "FETCH" <f:FetchArgs> => f,
    "MOVE" <f:FetchArgs> => set_fetch_ismove(f),
};

FetchArgs: Node = {
    <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    FromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "NEXT" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "NEXT" <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "PRIOR" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "PRIOR" <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "FIRST" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, 1, n, false),
    "FIRST" <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, 1, n, false),
    "LAST" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, -1, n, false),
    "LAST" <n:ColId> => make_fetch_stmt(FetchDirection::ABSOLUTE, -1, n, false),
    "ABSOLUTE" <i:SignedIconst> FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::ABSOLUTE, i, n, false),
    "ABSOLUTE" <i:SignedIconst> <n:ColId> =>
        make_fetch_stmt(FetchDirection::ABSOLUTE, i, n, false),
    "RELATIVE" <i:SignedIconst> FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::RELATIVE, i, n, false),
    "RELATIVE" <i:SignedIconst> <n:ColId> =>
        make_fetch_stmt(FetchDirection::RELATIVE, i, n, false),
    <i:SignedIconst> FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    <i:SignedIconst> <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    "ALL" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "ALL" <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "FORWARD" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "FORWARD" <n:ColId> => make_fetch_stmt(FetchDirection::FORWARD, 1, n, false),
    "FORWARD" <i:SignedIconst> FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    "FORWARD" <i:SignedIconst> <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, i, n, false),
    "FORWARD" "ALL" FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "FORWARD" "ALL" <n:ColId> =>
        make_fetch_stmt(FetchDirection::FORWARD, FETCH_ALL, n, false),
    "BACKWARD" FromIn <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "BACKWARD" <n:ColId> => make_fetch_stmt(FetchDirection::BACKWARD, 1, n, false),
    "BACKWARD" <i:SignedIconst> FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, i, n, false),
    "BACKWARD" <i:SignedIconst> <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, i, n, false),
    "BACKWARD" "ALL" FromIn <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, FETCH_ALL, n, false),
    "BACKWARD" "ALL" <n:ColId> =>
        make_fetch_stmt(FetchDirection::BACKWARD, FETCH_ALL, n, false),
};

// gram.y `from_in: FROM | IN_P`.
FromIn: () = {
    "FROM" => (),
    "IN" => (),
};


// gram.y `SignedIconst: Iconst | '+' Iconst | '-' Iconst`. M9 reaches the plain
// ICONST (a leading sign is staged: `FETCH -1 c` is deferred to keep the count an
// i64 without a sign-prefix conflict against the unary-minus expression path).
SignedIconst: i64 = {
    <i:"ICONST"> => i64::from(i),
};

// gram.y `NumericOnly` (sequence-option subset): a signed integer. Reached only
// after a sequence-option keyword (INCREMENT/START/...), where a leading `-`/`+` is
// unambiguous (no expression tier here), so it needs no UMINUS conflict guard.
SeqNumeric: i64 = {
    <i:"ICONST"> => i64::from(i),
    "+" <i:"ICONST"> => i64::from(i),
    "-" <i:"ICONST"> => -i64::from(i),
};

// ===========================================================================
//  SELECT
// ===========================================================================

// gram.y `SelectStmt`: select_no_parens | select_with_parens. The parenthesized
// form (`select_with_parens`, used to override the INTERSECT-binds-tighter
// precedence via `(a UNION b) INTERSECT c`) shares the `(` prefix with the CTE body
// `AS ( PreparableStmt )` and the expression `( a_expr )`, which lalrpop (LALR(1),
// no %prec) cannot disambiguate. It is STAGED; the two-tier cascade below already
// gives the spec precedence (`a UNION b INTERSECT c` == `a UNION (b INTERSECT c)`)
// without parentheses.
SelectStmt: Node = {
    SelectNoParens,
};

// gram.y `select_with_parens: '(' select_no_parens ')'`. The parenthesized select
// form, used as the scalar/EXISTS/IN/ANY/ALL subquery body in an expression. LALR(1)
// disambiguates `( SELECT ... )` (this rule) from the expression `( a_expr )`
// (c_expr) by the token after `(`. The `'(' select_with_parens ')'` self-nesting
// (extra parens around a sub-select) and the set-op-leaf use are omitted to keep the
// LALR table small (they are not needed by the supported subquery forms).
SelectWithParens: Node = {
    "(" <s:SelectNoParens> ")" => s,
};

// gram.y `select_no_parens`: an optional `with_clause`, a `select_clause` (the
// set-operation tier), optionally followed by ORDER BY / LIMIT/OFFSET / FOR-locking
// (PG's insertSelectOptions). The sort/limit/locking wrappers and the WITH clause
// are OUTSIDE the set-op tier so `a UNION b ORDER BY c` binds the ORDER BY to the
// whole union (gram.y's structure).
SelectNoParens: Node = {
    SelectClause,
    <s:SelectClause> <sort:SortClause> => insert_select_options(s, sort, None, None),
    <s:SelectClause> <lim:SelectLimit> =>
        insert_select_options(s, Vec::new(), lim.0, lim.1),
    <s:SelectClause> <sort:SortClause> <lim:SelectLimit> =>
        insert_select_options(s, sort, lim.0, lim.1),
    // M8 (step 34): the `for_locking_clause` wrapper (`SELECT ... FOR UPDATE`).
    // The grammar allows it after an optional ORDER BY (PG's opt_sort_clause).
    <s:SelectClause> <lock:ForLockingClause> => set_select_locking(s, lock),
    <s:SelectClause> <sort:SortClause> <lock:ForLockingClause> =>
        set_select_locking(insert_select_options(s, sort, None, None), lock),
    // WITH [RECURSIVE] cte_list prefixing the select (M12, step 43).
    <w:WithClause> <s:SelectClause> => set_select_with_clause(s, w),
    <w:WithClause> <s:SelectClause> <sort:SortClause> =>
        set_select_with_clause(insert_select_options(s, sort, None, None), w),
    <w:WithClause> <s:SelectClause> <lim:SelectLimit> =>
        set_select_with_clause(insert_select_options(s, Vec::new(), lim.0, lim.1), w),
    <w:WithClause> <s:SelectClause> <sort:SortClause> <lim:SelectLimit> =>
        set_select_with_clause(insert_select_options(s, sort, lim.0, lim.1), w),
};

// gram.y `select_clause: simple_select | select_with_parens`, with the set-op
// operators folded in. lalrpop has no %left/%nonassoc, so PG's
// `%left UNION EXCEPT` / `%left INTERSECT` precedence is encoded as a two-tier
// nonterminal cascade (the same idiom as OrExpr/AndExpr): the LOOSER UNION/EXCEPT
// tier (`SelectClause`) is left-recursive over the TIGHTER INTERSECT tier
// (`IntersectClause`), which is left-recursive over the select atom. Left-recursion
// gives left-associativity; the tier nesting gives "INTERSECT binds tighter".
SelectClause: Node = {
    IntersectClause,
    <l:SelectClause> "UNION" <q:SetQuantifier> <r:IntersectClause> =>
        make_set_op(SetOperation::UNION, q, l, r),
    <l:SelectClause> "EXCEPT" <q:SetQuantifier> <r:IntersectClause> =>
        make_set_op(SetOperation::EXCEPT, q, l, r),
};

// The INTERSECT precedence tier (binds tighter than UNION/EXCEPT).
IntersectClause: Node = {
    SelectAtom,
    <l:IntersectClause> "INTERSECT" <q:SetQuantifier> <r:SelectAtom> =>
        make_set_op(SetOperation::INTERSECT, q, l, r),
};

// A set-op leaf: a `simple_select` (the parenthesized-select set-op leaf is omitted
// to keep the LALR table small; the two-tier cascade already gives the precedence).
SelectAtom: Node = {
    SimpleSelect,
};

// gram.y `set_quantifier: ALL | DISTINCT | /*EMPTY*/`. ALL -> keep duplicates;
// DISTINCT or empty -> deduplicate (the bool is `all`).
SetQuantifier: bool = {
    "ALL"      => true,
    "DISTINCT" => false,
    =>           false,
};

// gram.y `simple_select`. M5 (step 26) reaches the `SELECT [DISTINCT] target_list
// FROM ... WHERE ... GROUP BY ...` shape and the bare `values_clause`; HAVING/WINDOW/
// TABLE and the set operations are added at their milestones.
SimpleSelect: Node = {
    // No INTO: the plain SELECT (the common case).
    "SELECT" <distinct:OptDistinctClause> <targets:OptTargetList>
        <frm:FromClause>
        <whr:WhereClause> <grp:GroupClause> <win:WindowClause> =>
        make_simple_select(distinct, None, targets, frm, whr, grp, win),
    // SELECT ... INTO target: `intoClause` set (transformOptionalSelectInto rewrites
    // it into a CREATE TABLE AS). Separate arm (not a nullable mid-rule `into_clause`)
    // to keep the LALR(1) table small.
    "SELECT" <distinct:OptDistinctClause> <targets:OptTargetList>
        "INTO" <rel:OptTempTableName>
        <frm:FromClause>
        <whr:WhereClause> <grp:GroupClause> <win:WindowClause> =>
        make_simple_select(distinct, Some(make_into_clause(rel, Vec::new())), targets, frm, whr, grp, win),
    // gram.y `simple_select: values_clause`. A bare `VALUES (...), ...` used as a
    // standalone SELECT (transformValuesClause). `make_values_select` builds the
    // SelectStmt with `valuesLists` set and every other clause defaulted.
    "VALUES" <rows:ValuesLists> => make_values_select(rows),
};

// gram.y `OptTempTableName`: the SELECT INTO target's optional persistence prefix +
// optional TABLE noise word, then the name. Returns the RangeVar with relpersistence
// set. (GLOBAL is deprecated in PG but accepted.)
OptTempTableName: crate::nodes::primnodes::RangeVar = {
    "TEMPORARY" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "TEMP" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "LOCAL" "TEMPORARY" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "LOCAL" "TEMP" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "GLOBAL" "TEMPORARY" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "GLOBAL" "TEMP" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_TEMP),
    "UNLOGGED" <r:OptTableQualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_UNLOGGED),
    "TABLE" <r:QualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_PERMANENT),
    <r:QualifiedName> => set_rangevar_persistence(r, crate::catalog::pg_class::RELPERSISTENCE_PERMANENT),
};

// gram.y `opt_table qualified_name`: an optional TABLE noise word before the name.
OptTableQualifiedName: crate::nodes::primnodes::RangeVar = {
    "TABLE" <r:QualifiedName> => r,
    <r:QualifiedName> => r,
};

// ===========================================================================
//  WITH [RECURSIVE] cte_list  (M12, step 43): gram.y `with_clause`, `cte_list`,
//  `common_table_expr`.
// ===========================================================================

// gram.y `with_clause: WITH cte_list | WITH_LA cte_list | WITH RECURSIVE cte_list`.
// The WITH_LA lookahead hack (so a CTE can be named after a bare-label keyword) is
// not needed here -- there is a single WITH token.
WithClause: Box<crate::nodes::parsenodes::WithClause> = {
    "WITH" <l:CteList> <loc:@L> => make_with_clause(l, false, loc),
    "WITH" "RECURSIVE" <l:CteList> <loc:@L> => make_with_clause(l, true, loc),
};

// gram.y `cte_list: common_table_expr (',' common_table_expr)*`.
CteList: Vec<Node> = {
    <c:CommonTableExpr> => vec![c],
    <mut l:CteList> "," <c:CommonTableExpr> => { l.push(c); l },
};

// gram.y `common_table_expr: name opt_name_list AS opt_materialized
// '(' PreparableStmt ')' opt_search_clause opt_cycle_clause`. SEARCH/CYCLE are
// staged (deferred; they need the search/cycle rewrite). The body is any
// PreparableStmt (SELECT/INSERT/UPDATE/DELETE).
CommonTableExpr: Node = {
    <n:ColId> <cols:OptCteColumnList> "AS" <m:OptMaterialized> "(" <q:PreparableStmt> ")" =>
        make_common_table_expr(n, cols, m, q),
};

// gram.y `opt_name_list: '(' name_list ')' | /*EMPTY*/` (the CTE column aliases).
OptCteColumnList: Vec<Node> = {
    "(" <l:NameList> ")" => l.into_iter().map(make_string_value_node).collect(),
    => Vec::new(),
};

// gram.y `opt_materialized: MATERIALIZED | NOT MATERIALIZED | /*EMPTY*/`.
OptMaterialized: crate::nodes::parsenodes::CTEMaterialize = {
    "MATERIALIZED"     => crate::nodes::parsenodes::CTEMaterialize::CTEMaterializeAlways,
    "NOT" "MATERIALIZED" => crate::nodes::parsenodes::CTEMaterialize::CTEMaterializeNever,
    =>                   crate::nodes::parsenodes::CTEMaterialize::CTEMaterializeDefault,
};

// gram.y `distinct_clause` / `opt_all_clause` (the `SELECT [ALL|DISTINCT]` prefix).
// gram.y `distinct_clause: DISTINCT` returns `list_make1(NIL)` -- a one-element
// list whose lone element is NULL, distinguishing "DISTINCT (over all columns)"
// from "no DISTINCT" (an empty list). The port has no NIL Node, so the marker is a
// bare `A_Star` (transformDistinctClause keys off the list being non-empty with a
// NULL/A_Star head). `DISTINCT ON (...)` grows later.
OptDistinctClause: Vec<Node> = {
    "DISTINCT" => vec![Node::A_Star(Box::new(crate::nodes::parsenodes::A_Star {}))],
    "ALL" => Vec::new(),
    => Vec::new(),
};

// gram.y `group_clause: GROUP BY set_quantifier group_by_list | /*EMPTY*/`. M5
// covers `GROUP BY a, b, ...` (plain expression group items); ROLLUP/CUBE/GROUPING
// SETS grow with the grouping-set machinery.
GroupClause: Vec<Node> = {
    "GROUP" "BY" <list:GroupByList> => list,
    => Vec::new(),
};

GroupByList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:GroupByList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  WINDOW clause  (gram.y window_clause -> window_definition_list -> window_definition)
// ===========================================================================

// gram.y `window_clause: WINDOW window_definition_list | /*EMPTY*/`. Each
// `window_definition` is `ColId AS window_specification` -> a named WindowDef.
WindowClause: Vec<Node> = {
    "WINDOW" <list:WindowDefinitionList> => list,
    => Vec::new(),
};

WindowDefinitionList: Vec<Node> = {
    <d:WindowDefinition> => vec![d],
    <mut list:WindowDefinitionList> "," <d:WindowDefinition> => { list.push(d); list },
};

// gram.y `window_definition: ColId AS window_specification`. The name is the
// window's own name; the spec carries PARTITION BY / ORDER BY / frame.
WindowDefinition: Node = {
    <n:ColId> "AS" <w:WindowSpecification> => {
        let mut w = w;
        w.name = Some(n);
        Node::WindowDef(w)
    },
};

// gram.y `window_specification: '(' opt_existing_window_name opt_partition_clause
// opt_sort_clause opt_frame_clause ')'`. Builds an anonymous WindowDef (the name is
// stamped by the caller for a named WINDOW definition). `opt_existing_window_name`
// (window inheritance, `(base ...)`) grows later.
WindowSpecification: Box<crate::nodes::parsenodes::WindowDef> = {
    "(" <part:OptPartitionClause> <ord:OptWindowSortClause> <frame:OptFrameClause> ")" =>
        make_window_def(part, ord, frame),
};

// gram.y `opt_partition_clause: PARTITION BY expr_list | /*EMPTY*/`.
OptPartitionClause: Vec<Node> = {
    "PARTITION" "BY" <list:ExprList> => list,
    => Vec::new(),
};

// The window spec's ORDER BY (gram.y opt_sort_clause inside window_specification).
OptWindowSortClause: Vec<Node> = {
    SortClause,
    => Vec::new(),
};

// gram.y `opt_frame_clause`: `{RANGE|ROWS|GROUPS} frame_extent opt_window_exclusion
// | /*EMPTY*/`. Returns the assembled frameOptions bitmask + (start,end) offset
// exprs. EMPTY -> the default frame (RANGE UNBOUNDED PRECEDING .. CURRENT ROW).
OptFrameClause: (i32, Option<Node>, Option<Node>) = {
    <mode:FrameMode> <ext:FrameExtent> <excl:OptFrameExclusion> =>
        assemble_frame_options(mode, ext, excl),
    => (frame_defaults(), None, None),
};

FrameMode: i32 = {
    "RANGE"  => frameopt_range(),
    "ROWS"   => frameopt_rows(),
    "GROUPS" => frameopt_groups(),
};

// gram.y `frame_extent: frame_bound | BETWEEN frame_bound AND frame_bound`. The
// single-bound form is `start .. CURRENT ROW`; the BETWEEN form gives both bounds.
// Each bound is (start_bits, end_bits-mask, offset-expr); assemble_frame_options
// combines them. We carry the raw start/end FrameBound results.
FrameExtent: (FrameBoundTok, Option<FrameBoundTok>) = {
    <b:FrameBound> => (b, None),
    "BETWEEN" <s:FrameBound> "AND" <e:FrameBound> => (s, Some(e)),
};

// gram.y `frame_bound`: UNBOUNDED PRECEDING/FOLLOWING | CURRENT ROW | a_expr
// PRECEDING/FOLLOWING. Carries a discriminant + the offset expr (for OFFSET forms).
FrameBound: FrameBoundTok = {
    "UNBOUNDED" "PRECEDING" => FrameBoundTok::UnboundedPreceding,
    "UNBOUNDED" "FOLLOWING" => FrameBoundTok::UnboundedFollowing,
    "CURRENT" "ROW"         => FrameBoundTok::CurrentRow,
    <e:AExpr> "PRECEDING"   => FrameBoundTok::OffsetPreceding(e),
    <e:AExpr> "FOLLOWING"   => FrameBoundTok::OffsetFollowing(e),
};

// gram.y `opt_window_exclusion`: EXCLUDE {CURRENT ROW|GROUP|TIES|NO OTHERS}.
OptFrameExclusion: i32 = {
    "EXCLUDE" "CURRENT" "ROW" => frameopt_exclude_current_row(),
    "EXCLUDE" "GROUP"         => frameopt_exclude_group(),
    "EXCLUDE" "TIES"          => frameopt_exclude_ties(),
    "EXCLUDE" "NO" "OTHERS"   => 0,
    => 0,
};

// ===========================================================================
//  ORDER BY  (gram.y sort_clause -> sortby_list -> sortby)
// ===========================================================================

// gram.y `sort_clause: ORDER BY sortby_list`.
SortClause: Vec<Node> = {
    "ORDER" "BY" <list:SortbyList> => list,
};

SortbyList: Vec<Node> = {
    <s:Sortby> => vec![s],
    <mut list:SortbyList> "," <s:Sortby> => { list.push(s); list },
};

// gram.y `sortby: a_expr opt_asc_desc opt_nulls_order`. The USING-operator form
// (`a_expr USING op`) grows with operator-class ordering. Builds a SortBy node.
Sortby: Node = {
    <e:AExpr> <dir:OptAscDesc> <nulls:OptNullsOrder> => make_sortby(e, dir, nulls),
};

OptAscDesc: SortByDir = {
    "ASC"  => SortByDir::ASC,
    "DESC" => SortByDir::DESC,
    => SortByDir::DEFAULT,
};

OptNullsOrder: SortByNulls = {
    "NULLS" "FIRST" => SortByNulls::FIRST,
    "NULLS" "LAST"  => SortByNulls::LAST,
    => SortByNulls::DEFAULT,
};

// ===========================================================================
//  LIMIT / OFFSET  (gram.y select_limit -> limit_clause / offset_clause)
// ===========================================================================

// gram.y `select_limit`: any combination of LIMIT and OFFSET, in either order.
// Returns (limitOffset, limitCount). FETCH FIRST / WITH TIES grow at their
// milestone; M5 covers `LIMIT count`, `OFFSET n`, and both orders.
SelectLimit: (Option<Node>, Option<Node>) = {
    <c:LimitClause> <o:OffsetClause> => (Some(o), c),
    <o:OffsetClause> <c:LimitClause> => (Some(o), c),
    <c:LimitClause> => (None, c),
    <o:OffsetClause> => (Some(o), None),
};

// gram.y `limit_clause: LIMIT select_limit_value`. `LIMIT ALL` is no count (None).
LimitClause: Option<Node> = {
    "LIMIT" <e:AExpr> => Some(e),
    "LIMIT" "ALL" => None,
};

// gram.y `offset_clause: OFFSET select_offset_value`.
OffsetClause: Node = {
    "OFFSET" <e:AExpr> => e,
};

// ===========================================================================
//  FOR locking clause  (gram.y for_locking_clause -> for_locking_items -> for_locking_item)
//  M8 (step 34): `FOR UPDATE/SHARE/NO KEY UPDATE/KEY SHARE [OF rel,...] [NOWAIT|SKIP LOCKED]`.
// ===========================================================================

ForLockingClause: LockingClause = {
    "FOR" <s:LockStrength> <of:LockedRelsList> <wp:OptNowait> =>
        make_locking_clause(s, of, wp),
};

LockStrength: LockClauseStrength = {
    "UPDATE"          => LockClauseStrength::FORUPDATE,
    "NO" "KEY" "UPDATE" => LockClauseStrength::FORNOKEYUPDATE,
    "SHARE"           => LockClauseStrength::FORSHARE,
    "KEY" "SHARE"     => LockClauseStrength::FORKEYSHARE,
};

// gram.y `locked_rels_list: OF qualified_name_list | /*EMPTY*/`. Each named rel
// is a RangeVar marking which FROM items the lock applies to.
LockedRelsList: Vec<Node> = {
    "OF" <list:QualifiedNameList> => list,
    => Vec::new(),
};

QualifiedNameList: Vec<Node> = {
    <n:QualifiedName> => vec![Node::RangeVar(Box::new(n))],
    <mut list:QualifiedNameList> "," <n:QualifiedName> =>
        { list.push(Node::RangeVar(Box::new(n))); list },
};

// gram.y `opt_nowait_or_skip: NOWAIT | SKIP LOCKED | /*EMPTY*/`.
OptNowait: LockWaitPolicy = {
    "NOWAIT"        => LockWaitPolicy::LockWaitError,
    "SKIP" "LOCKED" => LockWaitPolicy::LockWaitSkip,
    => LockWaitPolicy::LockWaitBlock,
};

// ===========================================================================
//  FROM clause  (gram.y from_clause -> from_list -> table_ref)
// ===========================================================================

// gram.y `from_clause: FROM from_list | /*EMPTY*/`. M2 covers a comma-separated
// list of plain table references (cross-product, no JOIN syntax yet).
FromClause: Vec<Node> = {
    "FROM" <list:FromList> => list,
    => Vec::new(),
};

FromList: Vec<Node> = {
    <t:TableRef> => vec![t],
    <mut list:FromList> "," <t:TableRef> => { list.push(t); list },
};

// gram.y `table_ref`: a FROM item. M7 (step 32) covers a plain table (with an
// optional alias), a parenthesized joined table (with an optional alias), and the
// left-recursive `joined_table` JOIN chain. Subquery / function FROM items grow at
// their milestones.
//
// To keep the LALR table unambiguous, the JOIN chain (`JoinedTable`) is
// left-recursive over `TableRef` with a NON-join right operand (`TableAtom`):
// `a JOIN b JOIN c` parses left-associatively as `(a JOIN b) JOIN c`, matching PG.
TableRef: Node = {
    TableAtom,
    JoinedTable,
};

// A non-join FROM atom: a plain (aliased) table, a parenthesized join (aliased),
// or a function call in FROM (gram.y `func_table`).
TableAtom: Node = {
    <r:QualifiedName> <a:OptAliasClause> => make_range_var_table_ref(apply_rangevar_alias(r, a)),
    "(" <j:JoinedTable> ")" <a:OptAliasClause> => apply_join_alias(j, a),
    // gram.y `table_ref: func_table func_alias_clause`. M8 (step 08) reaches the
    // simple `func_expr_windowless` form (a single function call, optional alias).
    // WITH ORDINALITY / ROWS FROM() / per-function coldeflists / LATERAL grow later.
    <f:FuncExprWindowless> <a:OptAliasClause> => make_range_function(f, false, a),
};

// gram.y `func_expr_windowless: func_application | func_expr_common_subexpr`. The
// function-in-FROM position does not allow FILTER/OVER (windowed) suffixes.
FuncExprWindowless: Node = {
    FuncApplication,
    FuncExprCommonSubexpr,
};

// gram.y `joined_table`. M7 reaches the cross join (`a CROSS JOIN b`), the
// qualified join (`a [INNER] JOIN b ON expr` / `... USING (cols)`), and the outer
// join spellings (LEFT/RIGHT/FULL [OUTER] JOIN ... ON/USING). The executor only
// emits INNER joins this milestone; the outer-join parse is accepted so the
// grammar is complete (the planner/executor outer-join emit grows next). The join
// type is split into explicit productions rather than an optional nonterminal, so
// the LALR table has no empty-reduction conflict on the first JOIN keyword.
JoinedTable: Node = {
    <l:TableRef> "CROSS" "JOIN" <r:TableAtom> =>
        make_join_expr(JoinType::INNER, l, r, None, Vec::new()),
    <l:TableRef> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> "INNER" "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> <jt:OuterJoinType> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(jt, l, r, q.0, q.1),
};

// gram.y `join_type: LEFT/RIGHT/FULL [OUTER]` (the OUTER noise word is optional).
OuterJoinType: JoinType = {
    "LEFT" OptOuter => JoinType::LEFT,
    "RIGHT" OptOuter => JoinType::RIGHT,
    "FULL" OptOuter => JoinType::FULL,
};

OptOuter: () = { "OUTER" => (), => () };

// gram.y `join_qual: ON a_expr | USING '(' name_list ')'`. Returns the ON-quals or
// the USING column list (mutually exclusive).
JoinQual: (Option<Node>, Vec<String>) = {
    "ON" <q:AExpr> => (Some(q), Vec::new()),
    "USING" "(" <cols:NameList> ")" => (None, cols),
};

// gram.y `opt_alias_clause`: alias_clause | /*EMPTY*/.
OptAliasClause: Option<crate::nodes::primnodes::Alias> = {
    AliasClause => Some(<>),
    => None,
};

// gram.y `alias_clause: AS ColId | ColId` (the column-alias-list form grows later).
AliasClause: crate::nodes::primnodes::Alias = {
    "AS" <n:ColId> => make_alias(n),
    <n:ColId> => make_alias(n),
};

// gram.y `name_list: name | name_list ',' name` (USING column list).
NameList: Vec<String> = {
    <n:ColId> => vec![n],
    <mut list:NameList> "," <n:ColId> => { list.push(n); list },
};

// gram.y `where_clause: WHERE a_expr | /*EMPTY*/`. The qual expression is
// transformed (-> bool) at analysis time; CURRENT OF grows at its milestone.
WhereClause: Option<Node> = {
    "WHERE" <e:AExpr> => Some(e),
    => None,
};

// ===========================================================================
//  Target list
// ===========================================================================

OptTargetList: Vec<Node> = {
    TargetList,
    => Vec::new(),         // gram.y opt_target_list: /*EMPTY*/
};

TargetList: Vec<Node> = {
    <t:TargetEl> => vec![t],
    <mut list:TargetList> "," <t:TargetEl> => { list.push(t); list },
};

// gram.y `target_el`. '*', a bare expression, and `a_expr AS ColLabel` are the
// reachable forms. The AS-form label admits any keyword (ColLabel); the bare-label
// (no-AS) form is deferred (it needs BareColLabel + the LALR precedence gram.y gets
// from bison %prec, which lalrpop lacks -- every boolean.sql alias uses explicit AS).
TargetEl: Node = {
    <v:AExpr> "AS" <n:ColLabel> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    <v:AExpr> => {
        let rt = ResTarget { name: None, indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    "*" => make_star_target(),
};

// ===========================================================================
//  Expressions  (gram.y a_expr -> c_expr -> AexprConst).  The full operator /
//  comparison / function tower is built out in M3+.
// ===========================================================================

// gram.y `a_expr` is one big rule whose alternatives carry %prec annotations; we
// reproduce its operator precedence (gram.y's %left/%nonassoc/%right table) with
// a precedence-tier nonterminal cascade instead. Loosest binding first:
//   OR  <  AND  <  NOT  <  comparison(nonassoc)  <  '+' '-'  <  '*' '/' '%'  <
//   unary '-'  <  c_expr.
// M3 reaches the boolean (AND/OR/NOT), comparison, and arithmetic operators over
// the c_expr leaves; IS / BETWEEN / IN / LIKE / casts etc. grow at their
// milestones. Every alternative is complete.
AExpr: Node = {
    OrExpr,
};

// gram.y `a_expr OR a_expr` (%left OR). A_Expr boolean op -> BoolExpr(OR).
OrExpr: Node = {
    <l:OrExpr> "OR" <r:AndExpr> => make_or_expr(l, r),
    AndExpr,
};

// gram.y `a_expr AND a_expr` (%left AND).
AndExpr: Node = {
    <l:AndExpr> "AND" <r:NotExpr> => make_and_expr(l, r),
    NotExpr,
};

// gram.y `NOT a_expr` (%right NOT).
NotExpr: Node = {
    "NOT" <e:NotExpr> => make_not_expr(e),
    CompareExpr,
};

// gram.y comparison operators (%nonassoc: no chaining, so the operands are the
// next-tighter tier). Each builds an A_Expr(OP) over the named operator.
CompareExpr: Node = {
    <l:QualOpExpr> "<"  <r:QualOpExpr> => make_a_expr("<", l, r),
    <l:QualOpExpr> ">"  <r:QualOpExpr> => make_a_expr(">", l, r),
    <l:QualOpExpr> "="  <r:QualOpExpr> => make_a_expr("=", l, r),
    <l:QualOpExpr> "<=" <r:QualOpExpr> => make_a_expr("<=", l, r),
    <l:QualOpExpr> ">=" <r:QualOpExpr> => make_a_expr(">=", l, r),
    <l:QualOpExpr> "<>" <r:QualOpExpr> => make_ne_expr(l, r),
    // gram.y `a_expr IN_P in_expr` (%nonassoc IN_P). The RHS is either a sub-SELECT
    // (`x IN (SELECT ...)` -> `x = ANY (sub)`) or a parenthesized expr_list
    // (`x IN (a,b,c)` -> OR-chain of `=`). NOT IN negates.
    <l:QualOpExpr> "IN" <s:SelectWithParens> => make_in_sublink(l, s, false),
    <l:QualOpExpr> "IN" "(" <e:ExprList> ")" => make_in_list(l, e, false),
    <l:QualOpExpr> "NOT" "IN" <s:SelectWithParens> => make_in_sublink(l, s, true),
    <l:QualOpExpr> "NOT" "IN" "(" <e:ExprList> ")" => make_in_list(l, e, true),
    // gram.y `a_expr subquery_Op sub_type select_with_parens` (%nonassoc): the
    // ANY/SOME/ALL quantified comparison against a sub-SELECT.
    <l:QualOpExpr> <op:SubqueryOp> <a:SubType> <s:SelectWithParens> =>
        make_any_all_sublink(l, op, a, s),
    // gram.y `a_expr IS [NOT] {TRUE|FALSE|UNKNOWN}` (%nonassoc IS) -> a BooleanTest.
    <l:QualOpExpr> "IS" "TRUE"     => make_bool_test(l, BoolTest::TRUE),
    <l:QualOpExpr> "IS" "NOT" "TRUE"    => make_bool_test(l, BoolTest::NOT_TRUE),
    <l:QualOpExpr> "IS" "FALSE"    => make_bool_test(l, BoolTest::FALSE),
    <l:QualOpExpr> "IS" "NOT" "FALSE"   => make_bool_test(l, BoolTest::NOT_FALSE),
    <l:QualOpExpr> "IS" "UNKNOWN"  => make_bool_test(l, BoolTest::UNKNOWN),
    <l:QualOpExpr> "IS" "NOT" "UNKNOWN" => make_bool_test(l, BoolTest::NOT_UNKNOWN),
    QualOpExpr,
};

// gram.y `a_expr qual_Op a_expr` (%left Op OPERATOR): generic/multi-character
// operators bind tighter than the comparisons and looser than '+'/'-'. The
// currently lexed subset is `||` (string concatenation).
QualOpExpr: Node = {
    <l:QualOpExpr> "||" <r:AddExpr> => make_a_expr("||", l, r),
    AddExpr,
};

// gram.y `sub_type: ANY | SOME | ALL`. ANY/SOME -> ANY_SUBLINK (the bool is `any`),
// ALL -> ALL_SUBLINK.
SubType: bool = {
    "ANY"  => true,
    "SOME" => true,
    "ALL"  => false,
};

// gram.y `subquery_Op` (the comparison-operator subset usable before ANY/ALL).
SubqueryOp: &'static str = {
    "<"  => "<",
    ">"  => ">",
    "="  => "=",
    "<=" => "<=",
    ">=" => ">=",
    "<>" => NE_OP_NAME,
};

// gram.y `a_expr '+'/'-' a_expr` (%left '+' '-').
AddExpr: Node = {
    <l:AddExpr> "+" <r:MulExpr> => make_a_expr("+", l, r),
    <l:AddExpr> "-" <r:MulExpr> => make_a_expr("-", l, r),
    MulExpr,
};

// gram.y `a_expr '*'/'/'/'%' a_expr` (%left '*' '/' '%').
MulExpr: Node = {
    <l:MulExpr> "*" <r:UnaryExpr> => make_a_expr("*", l, r),
    <l:MulExpr> "/" <r:UnaryExpr> => make_a_expr("/", l, r),
    <l:MulExpr> "%" <r:UnaryExpr> => make_a_expr("%", l, r),
    UnaryExpr,
};

// gram.y `'-' a_expr %prec UMINUS` / `'+' a_expr %prec UMINUS` (%right UMINUS).
// A leading '-' on a constant negates it in place (doNegate); over a non-constant
// it becomes the unary-minus operator A_Expr (deferred to its milestone in
// do_negate). A leading '+' is a no-op.
UnaryExpr: Node = {
    "-" <e:UnaryExpr> => do_negate(e),
    "+" <e:UnaryExpr> => e,
    TypecastExpr,
};

// gram.y `a_expr TYPECAST Typename` (%left TYPECAST -- binds tighter than the
// arithmetic/unary operators). A postfix chain of `:: Typename` casts; each builds a
// TypeCast node over the inner expression (M4, step 23).
TypecastExpr: Node = {
    <e:TypecastExpr> "::" <t:Typename> => make_type_cast(e, t),
    CExpr,
};

CExpr: Node = {
    AexprConst,
    // gram.y `c_expr: PARAM opt_indirection`. A `$n` positional parameter; the
    // opt_indirection (subscript/field on the param) grows with A_Indirection.
    <l:@L> <n:"PARAM"> => make_param_ref(n, l),
    // gram.y `c_expr: columnref`. A bare or table-qualified column reference.
    ColumnRef,
    // gram.y `c_expr: '(' a_expr ')'`.
    "(" <e:AExpr> ")" => e,
    // gram.y `c_expr: func_expr`.
    FuncExpr,
    // gram.y `c_expr: case_expr` (M4, step 23).
    CaseExpr,
    // gram.y `c_expr: NULL_P` (the SQL NULL literal -> a null A_Const).
    "NULL" => make_null_const(),
    // gram.y `c_expr: select_with_parens %prec UMINUS` -- a scalar sub-SELECT as an
    // expression (EXPR_SUBLINK). LALR(1) picks this over `( a_expr )` by the
    // token after `(` (SELECT/WITH/`(`-select).
    <s:SelectWithParens> => make_expr_sublink(s),
    // gram.y `c_expr: EXISTS select_with_parens` (EXISTS_SUBLINK).
    "EXISTS" <s:SelectWithParens> => make_exists_sublink(s),
};

// gram.y `func_expr: func_application within_group_clause filter_clause over_clause
// | func_expr_common_subexpr`. M3 reaches a plain function call `name ( arglist )`;
// M4 (step 23) adds the cast/conditional special forms (CAST, COALESCE, NULLIF,
// GREATEST, LEAST). M12 (step 42) adds the `[FILTER (WHERE ...)] OVER window`
// suffix that turns an aggregate / window function into a windowed call (the
// `over_clause` sets `FuncCall.over`). WITHIN GROUP and the remaining
// common-subexpr forms (CURRENT_DATE, ...) grow later.
FuncExpr: Node = {
    FuncApplication,
    <f:FuncApplication> <filter:FilterClause> <over:OverClause> =>
        attach_over_clause(f, filter, over),
    FuncExprCommonSubexpr,
};

// gram.y `filter_clause: FILTER '(' WHERE a_expr ')' | /*EMPTY*/`. Staged: the
// per-row FILTER over a windowed aggregate is not yet executed, so a present FILTER
// fails loudly in parse-analysis (clean not_yet_reachable); the grammar accepts it.
FilterClause: Option<Node> = {
    "FILTER" "(" "WHERE" <e:AExpr> ")" => Some(e),
    => None,
};

// gram.y `over_clause: OVER window_specification | OVER ColId | /*EMPTY*/`. The
// inline `OVER ( ... )` builds an anonymous WindowDef; `OVER name` references a
// named WINDOW clause (refname). An OVER clause is always present in this rule
// (the no-OVER alternative is the bare FuncApplication arm above).
OverClause: Box<crate::nodes::parsenodes::WindowDef> = {
    "OVER" <w:WindowSpecification> => w,
    "OVER" <n:ColId> => make_window_ref(n),
};

// gram.y `func_expr_common_subexpr` (M4 subset): the SQL-keyword "function" forms.
//   CAST '(' a_expr AS Typename ')'   -> a TypeCast (explicit cast)
//   COALESCE '(' expr_list ')'        -> a CoalesceExpr
//   GREATEST '(' expr_list ')'        -> a MinMaxExpr(IS_GREATEST)
//   LEAST '(' expr_list ')'           -> a MinMaxExpr(IS_LEAST)
//   NULLIF '(' a_expr ',' a_expr ')'  -> an A_Expr(AEXPR_NULLIF, "=")
FuncExprCommonSubexpr: Node = {
    "CAST" "(" <e:AExpr> "AS" <t:Typename> ")" => make_type_cast(e, t),
    "COALESCE" "(" <args:ExprList> ")" => make_coalesce_expr(args),
    "GREATEST" "(" <args:ExprList> ")" => make_min_max_expr(true, args),
    "LEAST" "(" <args:ExprList> ")" => make_min_max_expr(false, args),
    "NULLIF" "(" <l:AExpr> "," <r:AExpr> ")" => make_nullif_expr(l, r),
};

// gram.y `case_expr: CASE case_arg when_clause_list case_default END`.
// The optional `case_arg` is the simple-CASE test value; `when_clause_list` is one
// or more WHEN..THEN arms; `case_default` is the optional ELSE.
CaseExpr: Node = {
    "CASE" <arg:CaseArg> <whens:WhenClauseList> <def:CaseDefault> "END" =>
        make_case_expr(arg, whens, def),
};

// gram.y `case_arg: a_expr | /*EMPTY*/`.
CaseArg: Option<Node> = {
    <e:AExpr> => Some(e),
    => None,
};

// gram.y `when_clause_list: when_clause | when_clause_list when_clause`.
WhenClauseList: Vec<Node> = {
    <w:WhenClause> => vec![w],
    <mut list:WhenClauseList> <w:WhenClause> => { list.push(w); list },
};

// gram.y `when_clause: WHEN a_expr THEN a_expr` -> a CaseWhen node.
WhenClause: Node = {
    "WHEN" <c:AExpr> "THEN" <r:AExpr> => make_case_when(c, r),
};

// gram.y `case_default: ELSE a_expr | /*EMPTY*/`.
CaseDefault: Option<Node> = {
    "ELSE" <e:AExpr> => Some(e),
    => None,
};

// gram.y `func_application: func_name '(' func_arg_list ')' | func_name '(' '*' ')'
// | func_name '(' DISTINCT func_arg_list ')' | func_name '(' ')'`. M5 (step 26)
// adds the aggregate spellings: `count(*)` (agg_star) and `agg(DISTINCT expr)`
// (agg_distinct). VARIADIC / ORDER BY / named args grow at their milestones.
FuncApplication: Node = {
    <n:TypeFunctionName> "(" ")" => make_func_call(vec![n], Vec::new()),
    <n:TypeFunctionName> "(" <args:ExprList> ")" => make_func_call(vec![n], args),
    <n:TypeFunctionName> "(" "*" ")" => make_agg_star_call(vec![n]),
    <n:TypeFunctionName> "(" "DISTINCT" <args:ExprList> ")" => make_distinct_func_call(vec![n], args),
};

// gram.y `columnref: ColId | ColId indirection`. M2 covers `col` and
// `table.col`; the general indirection (subscripts, `.*` mid-chain) grows with
// the A_Indirection machinery.
ColumnRef: Node = {
    <n:ColId> => make_column_ref(vec![n]),
    <t:ColId> "." <n:ColId> => make_column_ref(vec![t, n]),
    // gram.y `columnref: ColId indirection` where indirection ends in `.*` -- the
    // whole-row reference `table.*` (a ColumnRef whose last field is an A_Star).
    <t:ColId> "." "*" => make_column_ref_star(vec![t]),
};

// gram.y `AexprConst`. Iconst/FCONST/Sconst are the plain forms; M4 (step 23) adds
// the typed-literal forms `Numeric Sconst` / `ConstTypename Sconst` (e.g.
// `NUMERIC '1.5'`, `DATE '2024-01-15'`), which PG builds as a string A_Const wrapped
// in a TypeCast to the named type (makeStringConstCast). BCONST/XCONST and the
// func_name-Sconst / typmod'd forms grow later.
AexprConst: Node = {
    <l:@L> <i:"ICONST"> => make_int_const_at(i, l),
    <l:@L> <f:"FCONST"> => make_float_const_at(f, l),
    <l:@L> <s:"SCONST"> => make_string_const_at(s, l),
    // gram.y `AexprConst: TRUE_P | FALSE_P` -> makeBoolAConst (a TypeCast of the
    // string 't'/'f' to pg_catalog.bool, exactly as PG builds a boolean literal).
    <l:@L> "TRUE"  => make_bool_const_at(true, l),
    <l:@L> "FALSE" => make_bool_const_at(false, l),
    // gram.y `ConstTypename Sconst` / `Numeric Sconst`: the typed-literal form
    // `typename 'string'` (e.g. `NUMERIC '1.5'`, `DATE '2024-01-15'`). Reuses the
    // single shared `SimpleTypename` (no duplicate keyword nonterminal) so the only
    // decision after a type keyword is shift-SCONST vs reduce-to-SimpleTypename --
    // resolved by lalrpop toward the typed-literal on SCONST lookahead. The `@L` is
    // the SCONST location (PG points the error caret at the literal).
    <t:SimpleTypename> <l:@L> <s:"SCONST"> => make_string_const_cast_at(s, t, l),
};

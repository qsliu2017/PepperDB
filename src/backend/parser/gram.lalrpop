        "NOT"     => Token::Keyword("not"),
        // M4 (step 23): cast + conditional-expression keywords.
        "CAST"     => Token::Keyword("cast"),
        "CASE"     => Token::Keyword("case"),
        "WHEN"     => Token::Keyword("when"),
        "THEN"     => Token::Keyword("then"),

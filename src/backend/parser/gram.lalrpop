// gram.y `ColLabel`: IDENT plus EVERY keyword category (used after an explicit
// `AS` in a target/alias position, where any keyword is a legal column label).
ColLabel: String = {
    <n:"IDENT"> => n,
    UnreservedKeyword,
    ColNameKeyword,
    TypeFuncNameKeyword,
    ReservedKeyword,
};

// ===========================================================================
//  Keyword-category nonterminals (gram.y `unreserved_keyword` /
//  `col_name_keyword` / `type_func_name_keyword` / `reserved_keyword`).
//  Each admits exactly the keywords of its kwlist.h category that the grammar
//  has declared terminals for (the set grows as terminals are declared), and
//  reduces to the keyword's canonical lowercase spelling.
// ===========================================================================


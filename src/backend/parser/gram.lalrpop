        "LOGGED" => Token::Keyword("logged"),
        "MAPPING" => Token::Keyword("mapping"),
        "MERGE_ACTION" => Token::Keyword("merge_action"),
        "METHOD" => Token::Keyword("method"),
        "MINUTE_P" => Token::Keyword("minute"),
        "MODE" => Token::Keyword("mode"),
        "MONTH_P" => Token::Keyword("month"),
        "NAMES" => Token::Keyword("names"),
        "NATURAL" => Token::Keyword("natural"),
        "NESTED" => Token::Keyword("nested"),
        "NEW" => Token::Keyword("new"),
        "NFC" => Token::Keyword("nfc"),
        "NFD" => Token::Keyword("nfd"),
        "NFKC" => Token::Keyword("nfkc"),
        "NFKD" => Token::Keyword("nfkd"),
        "NONE" => Token::Keyword("none"),
        "NORMALIZE" => Token::Keyword("normalize"),
        "NORMALIZED" => Token::Keyword("normalized"),
        "NOTIFY" => Token::Keyword("notify"),
        "NOTNULL" => Token::Keyword("notnull"),
        "OBJECT_P" => Token::Keyword("object"),
        "OBJECTS_P" => Token::Keyword("objects"),
        "OIDS" => Token::Keyword("oids"),
        "OLD" => Token::Keyword("old"),
        "OMIT" => Token::Keyword("omit"),
        "OPERATOR" => Token::Keyword("operator"),
        "OPTIONS" => Token::Keyword("options"),
        "ORDINALITY" => Token::Keyword("ordinality"),
        "OUT_P" => Token::Keyword("out"),
        "OVERLAPS" => Token::Keyword("overlaps"),
        "OVERLAY" => Token::Keyword("overlay"),
        "OVERRIDING" => Token::Keyword("overriding"),
        "OWNER" => Token::Keyword("owner"),
        "PARALLEL" => Token::Keyword("parallel"),
        "PARAMETER" => Token::Keyword("parameter"),
        "PARSER" => Token::Keyword("parser"),
        "PASSING" => Token::Keyword("passing"),
        "PASSWORD" => Token::Keyword("password"),
        "PATH" => Token::Keyword("path"),
        "PERIOD" => Token::Keyword("period"),
        "PLACING" => Token::Keyword("placing"),
        "PLAN" => Token::Keyword("plan"),
        "PLANS" => Token::Keyword("plans"),
        "POLICY" => Token::Keyword("policy"),
        "POSITION" => Token::Keyword("position"),
        "PRESERVE" => Token::Keyword("preserve"),
        "PROCEDURAL" => Token::Keyword("procedural"),
        "PROCEDURES" => Token::Keyword("procedures"),
        "PUBLICATION" => Token::Keyword("publication"),
        "QUOTES" => Token::Keyword("quotes"),
        "REASSIGN" => Token::Keyword("reassign"),
        "REF_P" => Token::Keyword("ref"),
        "REFERENCING" => Token::Keyword("referencing"),
        "REFRESH" => Token::Keyword("refresh"),
        "REINDEX" => Token::Keyword("reindex"),
        "REPLICA" => Token::Keyword("replica"),
        "RESTART" => Token::Keyword("restart"),
        "RETURN" => Token::Keyword("return"),
        "ROLE" => Token::Keyword("role"),
        "ROLLUP" => Token::Keyword("rollup"),
        "ROUTINE" => Token::Keyword("routine"),
        "ROUTINES" => Token::Keyword("routines"),
        "SCALAR" => Token::Keyword("scalar"),
        "SCHEMAS" => Token::Keyword("schemas"),
        "SEARCH" => Token::Keyword("search"),
        "SECOND_P" => Token::Keyword("second"),
        "SECURITY" => Token::Keyword("security"),
        "SEQUENCES" => Token::Keyword("sequences"),
        "SERVER" => Token::Keyword("server"),
        "SESSION_USER" => Token::Keyword("session_user"),
        "SETOF" => Token::Keyword("setof"),
        "SETS" => Token::Keyword("sets"),
        "SIMILAR" => Token::Keyword("similar"),
        "SOURCE" => Token::Keyword("source"),
        "SQL_P" => Token::Keyword("sql"),
        "STABLE" => Token::Keyword("stable"),
        "STANDALONE_P" => Token::Keyword("standalone"),
        "STATISTICS" => Token::Keyword("statistics"),
        "STORAGE" => Token::Keyword("storage"),
        "STORED" => Token::Keyword("stored"),
        "STRICT_P" => Token::Keyword("strict"),
        "STRING_P" => Token::Keyword("string"),
        "STRIP_P" => Token::Keyword("strip"),
        "SUBSCRIPTION" => Token::Keyword("subscription"),
        "SUBSTRING" => Token::Keyword("substring"),
        "SUPPORT" => Token::Keyword("support"),
        "SYMMETRIC" => Token::Keyword("symmetric"),
        "SYSID" => Token::Keyword("sysid"),
        "SYSTEM_P" => Token::Keyword("system"),
        "SYSTEM_USER" => Token::Keyword("system_user"),
        "TABLES" => Token::Keyword("tables"),
        "TABLESAMPLE" => Token::Keyword("tablesample"),
        "TARGET" => Token::Keyword("target"),
        "TEMPLATE" => Token::Keyword("template"),
        "TRAILING" => Token::Keyword("trailing"),
        "TRANSFORM" => Token::Keyword("transform"),
        "TREAT" => Token::Keyword("treat"),
        "TRIM" => Token::Keyword("trim"),
        "TRUNCATE" => Token::Keyword("truncate"),
        "TRUSTED" => Token::Keyword("trusted"),
        "TYPES_P" => Token::Keyword("types"),
        "UESCAPE" => Token::Keyword("uescape"),
        "UNCONDITIONAL" => Token::Keyword("unconditional"),
        "UNENCRYPTED" => Token::Keyword("unencrypted"),
        "UNLISTEN" => Token::Keyword("unlisten"),
        "UNTIL" => Token::Keyword("until"),
        "USER" => Token::Keyword("user"),
        "VALID" => Token::Keyword("valid"),
        "VALIDATE" => Token::Keyword("validate"),
        "VALIDATOR" => Token::Keyword("validator"),
        "VALUE_P" => Token::Keyword("value"),
        "VARIADIC" => Token::Keyword("variadic"),
        "VERSION_P" => Token::Keyword("version"),
        "VIEWS" => Token::Keyword("views"),
        "VIRTUAL" => Token::Keyword("virtual"),
        "VOLATILE" => Token::Keyword("volatile"),
        "WHITESPACE_P" => Token::Keyword("whitespace"),
        "WITHIN" => Token::Keyword("within"),
        "WRAPPER" => Token::Keyword("wrapper"),
        "XML_P" => Token::Keyword("xml"),
        "XMLATTRIBUTES" => Token::Keyword("xmlattributes"),
        "XMLCONCAT" => Token::Keyword("xmlconcat"),
        "XMLELEMENT" => Token::Keyword("xmlelement"),
        "XMLEXISTS" => Token::Keyword("xmlexists"),
        "XMLFOREST" => Token::Keyword("xmlforest"),
        "XMLNAMESPACES" => Token::Keyword("xmlnamespaces"),
        "XMLPARSE" => Token::Keyword("xmlparse"),
        "XMLPI" => Token::Keyword("xmlpi"),
        "XMLROOT" => Token::Keyword("xmlroot"),
        "XMLSERIALIZE" => Token::Keyword("xmlserialize"),
        "XMLTABLE" => Token::Keyword("xmltable"),
        "YEAR_P" => Token::Keyword("year"),
        "YES_P" => Token::Keyword("yes"),
        // literals / identifiers
        "IDENT"   => Token::Ident(<String>),
        "ICONST"  => Token::IConst(<i32>),
        "FCONST"  => Token::FConst(<String>),
        "SCONST"  => Token::SConst(<String>),
        // PARAM ($n) - carries the parameter number (M9, step 37).
        "PARAM"   => Token::Param(<i32>),
        // punctuation
        ";"       => Token::Semi,
        ","       => Token::Comma,
        "*"       => Token::Star,
        "("       => Token::LParen,
        ")"       => Token::RParen,
        "."       => Token::Dot,
        "+"       => Token::Plus,
        "-"       => Token::Minus,
        "/"       => Token::Slash,
        "%"       => Token::Percent,
        "<"       => Token::Lt,
        ">"       => Token::Gt,
        "="       => Token::Eq,
        "::"      => Token::Typecast,
        "<="      => Token::LessEquals,
        ">="      => Token::GreaterEquals,
        "<>"      => Token::NotEquals,
        "||"      => Token::Concat,
    }
}

// ===========================================================================
//  Top level: a semicolon-separated list of statements, each wrapped in RawStmt.
//  (gram.y `stmtmulti`; the MODE_* alternate entry points are added when plpgsql
//  / type-name parsing lands.)
// ===========================================================================

// gram.y wraps the whole result in `parse_toplevel`; the driver calls this rule.
pub Stmtmulti: RawStmtVec = {
    <mut list:Stmtmulti> ";" <s:TopLevelStmt> => {
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
    <s:TopLevelStmt> => {
        let mut list = Vec::new();
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
};

// gram.y `toplevel_stmt`: stmt | TransactionStmtLegacy. BEGIN/END are accepted
// only at top level (PG's toplevel_stmt), keeping them usable as labels elsewhere.
TopLevelStmt: Option<Node> = {
    Stmt,
    <s:TransactionStmtLegacy> => Some(s),
};

// gram.y `stmt`: the giant alternation over every statement kind. Grows one
// statement type per milestone; an empty statement yields None (dropped above).
Stmt: Option<Node> = {
    <s:SelectStmt> => Some(s),
    <s:CreateStmt> => Some(s),          // CREATE TABLE + CREATE TABLE AS (unified)
    <s:IndexStmt> => Some(s),
    <s:AlterTableStmt> => Some(s),
    <s:RenameStmt> => Some(s),
    <s:DropStmt> => Some(s),
    <s:GrantStmt> => Some(s),
    <s:CommentStmt> => Some(s),
    <s:CreateSeqStmt> => Some(s),
    <s:AlterSeqStmt> => Some(s),
    <s:CreateSchemaStmt> => Some(s),
    <s:DefineStmt> => Some(s),
    <s:CreateDomainStmt> => Some(s),
    <s:CreateFunctionStmt> => Some(s),
    <s:CreateConversionStmt> => Some(s),
    <s:CreatedbStmt> => Some(s),
    <s:DropdbStmt> => Some(s),
    <s:CreateTableSpaceStmt> => Some(s),
    <s:ViewStmt> => Some(s),
    <s:RuleStmt> => Some(s),
    <s:CreateTrigStmt> => Some(s),
    <s:CopyStmt> => Some(s),
    <s:VacuumStmt> => Some(s),
    <s:AnalyzeStmt> => Some(s),
    <s:ClusterStmt> => Some(s),
    <s:InsertStmt> => Some(s),
    <s:UpdateStmt> => Some(s),
    <s:DeleteStmt> => Some(s),
    <s:MergeStmt> => Some(s),
    <s:TransactionStmt> => Some(s),
    <s:VariableSetStmt> => Some(s),
    <s:VariableShowStmt> => Some(s),
    <s:PrepareStmt> => Some(s),
    <s:ExecuteStmt> => Some(s),
    <s:DeallocateStmt> => Some(s),
    <s:DeclareCursorStmt> => Some(s),
    <s:ClosePortalStmt> => Some(s),
    <s:FetchStmt> => Some(s),
    => None,            // empty statement (e.g. trailing ';')
};

// ===========================================================================
//  UPDATE / DELETE / MERGE  (M8, step 34)
// ===========================================================================

// gram.y `UpdateStmt`: opt_with_clause UPDATE relation_expr_opt_alias SET
// set_clause_list from_clause where_or_current_clause returning_clause. M8 reaches
// `UPDATE t SET col = expr, ... [FROM ...] [WHERE ...] [RETURNING ...]`; WITH and
// WHERE CURRENT OF grow at their milestones.
UpdateStmt: Node = {
    "UPDATE" <rel:QualifiedName> "SET" <sets:SetClauseList>
        <frm:FromClause> <whr:WhereClause> <ret:ReturningClause> =>
        make_update_stmt(rel, sets, frm, whr, ret),
};

// gram.y `set_clause_list: set_clause (',' set_clause)*`.
SetClauseList: Vec<Node> = {
    <c:SetClause> => vec![c],
    <mut list:SetClauseList> "," <c:SetClause> => { list.push(c); list },
};

// gram.y `set_clause: set_target '=' a_expr` (the multiple-column form
// `(a,b) = (...)` grows later). Builds a ResTarget naming the column with the
// assigned expression as its `val`.
SetClause: Node = {
    <col:ColId> "=" <val:AExpr> => make_set_target(col, val),
};

// gram.y `DeleteStmt`: opt_with_clause DELETE_P FROM relation_expr_opt_alias
// using_clause where_or_current_clause returning_clause. M8 reaches
// `DELETE FROM t [USING ...] [WHERE ...] [RETURNING ...]`.
DeleteStmt: Node = {
    "DELETE" "FROM" <rel:QualifiedName> <using:UsingClause> <whr:WhereClause>
        <ret:ReturningClause> =>
        make_delete_stmt(rel, using, whr, ret),
};

// gram.y `using_clause: USING from_list | /*EMPTY*/`.
UsingClause: Vec<Node> = {
    "USING" <list:FromList> => list,
    => Vec::new(),
};

// gram.y `returning_clause: RETURNING returning_with_clause target_list | /*EMPTY*/`.
// M8 covers the plain `RETURNING target_list` (the OLD/NEW alias form grows later).
ReturningClause: Vec<Node> = {
    "RETURNING" <list:TargetList> => list,
    => Vec::new(),
};

// gram.y `MergeStmt`: opt_with_clause MERGE INTO relation_expr_opt_alias USING
// table_ref ON a_expr merge_when_list returning_clause. M8 reaches the basic
// `MERGE INTO t USING src ON cond WHEN ...` shape.
MergeStmt: Node = {
    "MERGE" "INTO" <rel:QualifiedName> "USING" <src:TableRef> "ON" <cond:AExpr>
        <whens:MergeWhenList> <ret:ReturningClause> =>
        make_merge_stmt(rel, src, cond, whens, ret),
};

// gram.y `merge_when_list: merge_when_clause+`.
MergeWhenList: Vec<Node> = {
    <w:MergeWhenClause> => vec![w],
    <mut list:MergeWhenList> <w:MergeWhenClause> => { list.push(w); list },
};

// gram.y `merge_when_clause`. M8 covers the common forms:
//   WHEN MATCHED THEN UPDATE SET ...    /  WHEN MATCHED THEN DELETE
//   WHEN NOT MATCHED THEN INSERT VALUES (...)  /  ... DO NOTHING
MergeWhenClause: Node = {
    "WHEN" "MATCHED" "THEN" "UPDATE" "SET" <sets:SetClauseList> =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::UPDATE, sets, Vec::new()),
    "WHEN" "MATCHED" "THEN" "DELETE" =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::DELETE, Vec::new(), Vec::new()),
    "WHEN" "MATCHED" "THEN" "DO" "NOTHING" =>
        make_merge_when(MergeMatchKind::MATCHED, CmdType::NOTHING, Vec::new(), Vec::new()),
    "WHEN" "NOT" "MATCHED" "THEN" "INSERT" "VALUES" "(" <vals:ExprList> ")" =>
        make_merge_when(MergeMatchKind::NOT_MATCHED_BY_TARGET, CmdType::INSERT, Vec::new(), vals),
    "WHEN" "NOT" "MATCHED" "THEN" "DO" "NOTHING" =>
        make_merge_when(MergeMatchKind::NOT_MATCHED_BY_TARGET, CmdType::NOTHING, Vec::new(), Vec::new()),
};

// ===========================================================================
//  INSERT
// ===========================================================================

// gram.y `InsertStmt`: opt_with_clause INSERT INTO insert_target insert_rest
// opt_on_conflict returning_clause. M2 reaches `INSERT INTO qname [(collist)]
// (VALUES (...) | SelectStmt)`; WITH / ON CONFLICT / RETURNING / OVERRIDING and
// the DEFAULT VALUES form grow at their milestones.
InsertStmt: Node = {
    "INSERT" "INTO" <rel:QualifiedName> <cols:OptInsertColumnList> <src:InsertRest> => {
        make_insert_stmt(rel, cols, src)
    },
};

// gram.y `insert_rest`: the source after the target. The `VALUES (...)` list is
// reached through `SelectStmt` (its `simple_select: values_clause` production), as
// in gram.y; the `DEFAULT VALUES` and column-list+SELECT forms grow.
InsertRest: Option<Node> = {
    <s:SelectStmt> => Some(s),
};

// gram.y `'(' insert_column_list ')' | /*EMPTY*/`. A ColumnRef per column.
OptInsertColumnList: Vec<Node> = {
    "(" <cols:InsertColumnList> ")" => cols,
    => Vec::new(),
};

InsertColumnList: Vec<Node> = {
    <c:InsertColumnItem> => vec![c],
    <mut list:InsertColumnList> "," <c:InsertColumnItem> => { list.push(c); list },
};

// gram.y `insert_column_item: ColId opt_indirection` -> a ResTarget naming the
// target column. M2 takes the bare column name (no indirection).
InsertColumnItem: Node = {
    <n:ColId> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: None, location: -1 };
        Node::ResTarget(Box::new(rt))
    },
};

// gram.y `values_clause`: VALUES ctext_row [, ...]. Each row is a parenthesized
// expression list. M2 covers one or more rows of constant expressions.
ValuesLists: Vec<Node> = {
    <r:ValuesRow> => vec![r],
    <mut list:ValuesLists> "," <r:ValuesRow> => { list.push(r); list },
};

// gram.y `ctext_row: '(' ctext_expr_list ')'`. In PG the row is a bare `List *`
// element of valuesLists; the port has no `List` Node type (pg_list tombstone),
// so a row's expr list is carried as the `args` of a RowExpr node (an exact-fit
// Vec<Node> carrier). transformInsertStmt reads `RowExpr.args` as the sublist.
ValuesRow: Node = {
    "(" <exprs:ExprList> ")" => {
        Node::RowExpr(Box::new(crate::nodes::primnodes::RowExpr {
            args: exprs,
            row_typeid: crate::postgres_ext::InvalidOid,
            row_format: crate::nodes::primnodes::CoercionForm::IMPLICIT_CAST,
            colnames: Vec::new(),
            location: -1,
        }))
    },
};

ExprList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:ExprList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  CREATE TABLE
// ===========================================================================

// gram.y `CreateStmt`. M2 reaches the plain `CREATE TABLE name ( elts )` form;
// IF NOT EXISTS, OF type, PARTITION OF, inheritance, partition spec, WITH options,
// ON COMMIT, tablespace and access-method clauses arrive at their milestones.
// CREATE TABLE and CREATE TABLE AS share the `CREATE OptTemp TABLE QualifiedName`
// prefix. Keeping them as separate top-level productions makes lalrpop's LALR(1)
// table blow up (after `CREATE TABLE name (` it cannot cheaply distinguish a
// `TableElementList` from a CTAS `columnList`). So they are UNIFIED under one
// `CreateStmt` whose tail (`CreateStmtTail`) is either the parenthesized element
// list (plain table) or `AS SelectStmt opt_with_data` (CTAS). The optional CTAS
// column-name list `( cols )` -- which is what collides with `( elts )` -- is
// DEFERRED (create_ctas_nodata / intorel accept "too few column names"; the
// column-name-list forms are a later refinement, and every regress test that needs
// them is gated on other modules anyway).
CreateStmt: Node = {
    "CREATE" <persist:CreateOptTemp> "TABLE" <name:QualifiedName>
        <tail:CreateStmtTail> => make_create_or_ctas(persist, name, false, tail),
    "CREATE" <persist:CreateOptTemp> "TABLE" "IF" "NOT" "EXISTS" <name:QualifiedName>
        <tail:CreateStmtTail> => make_create_or_ctas(persist, name, true, tail),
};

// The two CREATE TABLE tails: `( elts )` (plain table) or `AS SelectStmt
// opt_with_data` (CTAS). Wrapped in `CreateTail` so one production covers both.
CreateStmtTail: crate::backend::parser::parser::CreateTail = {
    "(" <elts:OptTableElementList> ")" =>
        crate::backend::parser::parser::CreateTail::Plain(elts),
    "AS" <query:SelectStmt> <with_data:OptWithData> =>
        crate::backend::parser::parser::CreateTail::As { query, with_data },
};

// gram.y `opt_with_data`: WITH DATA | WITH NO DATA | /*EMPTY*/. Returns whether the
// query's data is materialized (true = WITH DATA / default; false = WITH NO DATA).
OptWithData: bool = {
    "WITH" "DATA"      => true,
    "WITH" "NO" "DATA" => false,
    =>                    true,
};

// gram.y `OptTemp`: the persistence marker before TABLE. Returns the relpersistence
// char. GLOBAL is accepted (deprecated) like PG; the empty arm is PERMANENT.
CreateOptTemp: i8 = {
    "TEMP"                => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "TEMPORARY"           => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "LOCAL" "TEMP"        => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "LOCAL" "TEMPORARY"   => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "GLOBAL" "TEMP"       => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "GLOBAL" "TEMPORARY"  => crate::catalog::pg_class::RELPERSISTENCE_TEMP,
    "UNLOGGED"            => crate::catalog::pg_class::RELPERSISTENCE_UNLOGGED,
    =>                       crate::catalog::pg_class::RELPERSISTENCE_PERMANENT,
};

// gram.y `qualified_name`: ColId | ColId indirection. M2 supports the bare and
// schema-qualified (`schema.name`) forms; the general indirection (subscripts) is
// rejected by makeRangeVarFromQualifiedName in PG and is not reached here.
QualifiedName: crate::nodes::primnodes::RangeVar = {
    <n:ColId> => crate::nodes::makefuncs::makeRangeVar(None, Some(n), -1),
    <s:ColId> "." <n:ColId> =>
        crate::nodes::makefuncs::makeRangeVar(Some(s), Some(n), -1),
};

// gram.y `OptTableElementList` / `TableElementList`. M2 element = columnDef;
// TableConstraint and TableLikeClause grow with constraints / LIKE.
OptTableElementList: Vec<Node> = {
    TableElementList,
    => Vec::new(),
};

TableElementList: Vec<Node> = {
    <e:TableElement> => vec![e],
    <mut list:TableElementList> "," <e:TableElement> => { list.push(e); list },
};

TableElement: Node = {
    ColumnDef,
};

// gram.y `columnDef`: ColId Typename ColQualList. M2 builds the plain
// `name type` ColumnDef; M11 (step 41) adds the column-level REFERENCES
// constraint. Other column constraints (NOT NULL / DEFAULT / ...) grow with
// the full ColQualList machinery.
ColumnDef: Node = {
    <name:ColId> <typ:Typename> => make_column_def_elt(name, typ),
    <name:ColId> <typ:Typename> <c:ColRefConstraint> => {
        let mut col = make_column_def_elt(name, typ);
        if let Node::ColumnDef(cd) = &mut col { cd.constraints.push(c); }
        col
    },
};

// gram.y `ColConstraintElem: REFERENCES qualified_name opt_column_list
// key_match key_actions`. M11 (step 41): the column-level foreign key. The
// referenced columns default to the PK of the referenced table.
ColRefConstraint: Node = {
    "REFERENCES" <pktable:QualifiedName> <pkcols:OptColumnList>
        <m:KeyMatch> <a:KeyActions> =>
        make_column_fk_constraint(pktable, pkcols, m, a.0, a.1),
};

// ===========================================================================
//  CREATE INDEX
// ===========================================================================

// gram.y `IndexStmt`: CREATE [UNIQUE] INDEX [name] ON relation [USING am]
// '(' index_params ')'. M6 reaches the plain single-/multi-column btree index;
// CONCURRENTLY, IF NOT EXISTS, INCLUDE, WITH options, tablespace, WHERE (partial),
// and the constraint forms grow at their milestones.
IndexStmt: Node = {
    "CREATE" <uniq:OptUnique> "INDEX" <name:OptIndexName> "ON" <rel:QualifiedName>
        <am:OptAccessMethodClause> "(" <params:IndexParams> ")" =>
        make_index_stmt(uniq, name, rel, am, params),
};

OptUnique: bool = {
    "UNIQUE" => true,
    => false,
};

OptIndexName: Option<String> = {
    <n:ColId> => Some(n),
    => None,
};

// gram.y `access_method_clause: USING name | /*EMPTY*/`. Defaults to btree.
OptAccessMethodClause: Option<String> = {
    "USING" <n:ColId> => Some(n),
    => None,
};

// gram.y `index_params: index_elem (',' index_elem)*`.
IndexParams: Vec<Node> = {
    <e:IndexElem> => vec![e],
    <mut list:IndexParams> "," <e:IndexElem> => { list.push(e); list },
};

// gram.y `index_elem: ColId index_elem_options ...`. M6 covers a bare column name
// (with ASC/DESC); opclasses, expressions, collations, and NULLS ordering grow.
IndexElem: Node = {
    <n:ColId> <dir:OptAscDesc> => make_index_elem(n, dir),
};

// ===========================================================================
//  ALTER TABLE / RENAME / DROP  (M10, step 38)
// ===========================================================================

// gram.y `AlterTableStmt: ALTER TABLE relation_expr alter_table_cmds`. M10 reaches
// `ALTER TABLE [IF EXISTS] name <cmd> [, <cmd>]...` for tables; the MATERIALIZED
// VIEW / INDEX / TYPE / partition / SET-clause forms grow at their milestones.
AlterTableStmt: Node = {
    "ALTER" "TABLE" <rel:QualifiedName> <cmds:AlterTableCmds> =>
        make_alter_table_stmt(rel, cmds, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> <cmds:AlterTableCmds> =>
        make_alter_table_stmt(rel, cmds, true),
};

AlterTableCmds: Vec<Node> = {
    <c:AlterTableCmd> => vec![c],
    <mut list:AlterTableCmds> "," <c:AlterTableCmd> => { list.push(c); list },
};

// gram.y `alter_table_cmd`: the M10-reachable subcommands (ADD/DROP COLUMN,
// ALTER COLUMN SET/DROP DEFAULT, SET/DROP NOT NULL, ALTER COLUMN TYPE, ADD/DROP
// CONSTRAINT). The rarely-hit AT_* forms grow at their milestones.
AlterTableCmd: Node = {
    "ADD" "COLUMN" <c:ColumnDef> => make_at_add_column(c),
    "ADD" <c:ColumnDef> => make_at_add_column(c),
    "DROP" "COLUMN" <n:ColId> <b:OptDropBehavior> => make_at_drop_column(n, false, b),
    "DROP" "COLUMN" "IF" "EXISTS" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_column(n, true, b),
    "DROP" <n:ColId> <b:OptDropBehavior> => make_at_drop_column(n, false, b),
    "ALTER" "COLUMN" <n:ColId> "SET" "DEFAULT" <e:AExpr> =>
        make_at_column_default(n, Some(e)),
    "ALTER" <n:ColId> "SET" "DEFAULT" <e:AExpr> => make_at_column_default(n, Some(e)),
    "ALTER" "COLUMN" <n:ColId> "DROP" "DEFAULT" => make_at_column_default(n, None),
    "ALTER" <n:ColId> "DROP" "DEFAULT" => make_at_column_default(n, None),
    "ALTER" "COLUMN" <n:ColId> "SET" "NOT" "NULL" => make_at_set_not_null(n, true),
    "ALTER" <n:ColId> "SET" "NOT" "NULL" => make_at_set_not_null(n, true),
    "ALTER" "COLUMN" <n:ColId> "DROP" "NOT" "NULL" => make_at_set_not_null(n, false),
    "ALTER" <n:ColId> "DROP" "NOT" "NULL" => make_at_set_not_null(n, false),
    "ADD" <c:TableConstraint> => make_at_add_constraint(c),
    "DROP" "CONSTRAINT" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_constraint(n, false, b),
    "DROP" "CONSTRAINT" "IF" "EXISTS" <n:ColId> <b:OptDropBehavior> =>
        make_at_drop_constraint(n, true, b),
};

// gram.y `TableConstraint: CONSTRAINT name ConstraintElem | ConstraintElem`. M10
// reaches a named/unnamed CHECK constraint; M11 (step 41) adds the table-level
// FOREIGN KEY constraint.
TableConstraint: Node = {
    "CONSTRAINT" <n:ColId> "CHECK" "(" <e:AExpr> ")" =>
        make_check_constraint(Some(n), e),
    "CHECK" "(" <e:AExpr> ")" => make_check_constraint(None, e),
    "CONSTRAINT" <n:ColId> <c:FkConstraintElem> => set_constraint_name(c, n),
    <c:FkConstraintElem> => c,
};

// gram.y `ConstraintElem: FOREIGN KEY '(' columnList ')' REFERENCES qualified_name
// opt_column_list key_match key_actions ConstraintAttributeSpec`. M11 (step 41):
// the column-array + referenced-columns + MATCH + ON DELETE/UPDATE actions.
FkConstraintElem: Node = {
    "FOREIGN" "KEY" "(" <fkcols:ColumnList> ")" "REFERENCES" <pktable:QualifiedName>
        <pkcols:OptColumnList> <m:KeyMatch> <a:KeyActions> =>
        make_fk_constraint(fkcols, pktable, pkcols, m, a.0, a.1),
};

// gram.y `columnList: columnElem (',' columnElem)*`. Each element is a String_
// value node naming a column.
ColumnList: Vec<Node> = {
    <n:ColId> => vec![make_string_value_node(n)],
    <mut list:ColumnList> "," <n:ColId> => { list.push(make_string_value_node(n)); list },
};

// gram.y `opt_column_list: '(' columnList ')' | /*EMPTY*/`.
OptColumnList: Vec<Node> = {
    "(" <list:ColumnList> ")" => list,
    => Vec::new(),
};

// gram.y `key_match`: MATCH FULL | MATCH PARTIAL | MATCH SIMPLE | /*EMPTY*/.
// Defaults to MATCH SIMPLE. (FULL/PARTIAL parse but enforcement stages.)
KeyMatch: i8 = {
    "MATCH" "FULL" => crate::nodes::parsenodes::FKCONSTR_MATCH_FULL,
    "MATCH" "PARTIAL" => crate::nodes::parsenodes::FKCONSTR_MATCH_PARTIAL,
    "MATCH" "SIMPLE" => crate::nodes::parsenodes::FKCONSTR_MATCH_SIMPLE,
    => crate::nodes::parsenodes::FKCONSTR_MATCH_SIMPLE,
};

// gram.y `key_actions`: an optional ON UPDATE and/or ON DELETE action. Returns
// (upd_action, del_action); each defaults to NO ACTION.
KeyActions: (i8, i8) = {
    => (crate::nodes::parsenodes::FKCONSTR_ACTION_NOACTION,
        crate::nodes::parsenodes::FKCONSTR_ACTION_NOACTION),
    "ON" "UPDATE" <u:KeyAction> =>
        (u, crate::nodes::parsenodes::FKCONSTR_ACTION_NOACTION),
    "ON" "DELETE" <d:KeyAction> =>
        (crate::nodes::parsenodes::FKCONSTR_ACTION_NOACTION, d),
    "ON" "UPDATE" <u:KeyAction> "ON" "DELETE" <d:KeyAction> => (u, d),
    "ON" "DELETE" <d:KeyAction> "ON" "UPDATE" <u:KeyAction> => (u, d),
};

// gram.y `key_action`: NO ACTION | RESTRICT | CASCADE | SET NULL | SET DEFAULT.
KeyAction: i8 = {
    "NO" "ACTION" => crate::nodes::parsenodes::FKCONSTR_ACTION_NOACTION,
    "RESTRICT"    => crate::nodes::parsenodes::FKCONSTR_ACTION_RESTRICT,
    "CASCADE"     => crate::nodes::parsenodes::FKCONSTR_ACTION_CASCADE,
    "SET" "NULL"  => crate::nodes::parsenodes::FKCONSTR_ACTION_SETNULL,
    "SET" "DEFAULT" => crate::nodes::parsenodes::FKCONSTR_ACTION_SETDEFAULT,
};

// ===========================================================================
//  CREATE TRIGGER  (M11, step 41)
// ===========================================================================

// gram.y `CreateTrigStmt`: CREATE [OR REPLACE] [CONSTRAINT] TRIGGER name
// {BEFORE|AFTER|INSTEAD OF} events ON qualified_name [FROM ...] [deferrable]
// [FOR [EACH] {ROW|STATEMENT}] [WHEN (cond)] EXECUTE {FUNCTION|PROCEDURE} func(args).
// M11 (step 41) reaches the row/statement, BEFORE/AFTER, INSERT/UPDATE/DELETE form;
// CONSTRAINT triggers, FROM reftable, deferrable, transition tables stage.
CreateTrigStmt: Node = {
    "CREATE" <repl:OptOrReplace> "TRIGGER" <name:ColId>
        <timing:TriggerActionTime> <events:TriggerEvents> "ON" <rel:QualifiedName>
        <row:TriggerForSpec> <whn:TriggerWhen>
        "EXECUTE" <_fp:FuncOrProcedure> <fname:AnyNameParts> "(" <args:TriggerFuncArgs> ")" =>
        make_create_trig_stmt(repl, name, timing, events, rel, row, whn, fname, args),
};

// gram.y `TriggerActionTime`: BEFORE | AFTER | INSTEAD OF.
TriggerActionTime: TrigTiming = {
    "BEFORE"  => TrigTiming::Before,
    "AFTER"   => TrigTiming::After,
    "INSTEAD" "OF" => TrigTiming::InsteadOf,
};

// gram.y `TriggerEvents`: TriggerOneEvent (OR TriggerOneEvent)*.
TriggerEvents: Vec<TrigEvent> = {
    <e:TriggerOneEvent> => vec![e],
    <mut list:TriggerEvents> "OR" <e:TriggerOneEvent> => { list.push(e); list },
};

TriggerOneEvent: TrigEvent = {
    "INSERT" => TrigEvent::Insert,
    "DELETE" => TrigEvent::Delete,
    "UPDATE" => TrigEvent::Update,
};

// gram.y `TriggerForSpec: FOR TriggerForOptEach TriggerForType | /*EMPTY*/`.
// Returns true for FOR EACH ROW, false for STATEMENT (the default).
TriggerForSpec: bool = {
    => false,
    "FOR" <r:TriggerForType> => r,
    "FOR" "EACH" <r:TriggerForType> => r,
};

TriggerForType: bool = {
    "ROW"       => true,
    "STATEMENT" => false,
};

// gram.y `TriggerWhen: WHEN '(' a_expr ')' | /*EMPTY*/`.
TriggerWhen: Option<Node> = {
    => None,
    "WHEN" "(" <e:AExpr> ")" => Some(e),
};

FuncOrProcedure: () = {
    "FUNCTION"  => (),
    "PROCEDURE" => (),
};

// gram.y `TriggerFuncArgs: TriggerFuncArg (',' TriggerFuncArg)* | /*EMPTY*/`.
TriggerFuncArgs: Vec<Node> = {
    => Vec::new(),
    <a:TriggerFuncArg> => vec![a],
    <mut list:TriggerFuncArgs> "," <a:TriggerFuncArg> => { list.push(a); list },
};

TriggerFuncArg: Node = {
    <i:"ICONST"> => make_string_value_node(i.to_string()),
    <s:"SCONST"> => make_string_value_node(s),
    <n:ColId>    => make_string_value_node(n),
};

// gram.y `CopyStmt` (M13, step 45): COPY table [(cols)] {FROM|TO} {'file'|STDIN|
// STDOUT|PROGRAM 'cmd'} [[WITH] (options)] [WHERE ...], and COPY (query) TO ....
// The legacy `opt_binary` prefix and `USING DELIMITERS` delimiter forms are
// staged (the WITH-paren and legacy bare-WITH option lists cover the common
// syntax). Kept LALR-conflict-free by funneling both option syntaxes through
// CopyOptions after the (optional) WITH.
CopyStmt: Node = {
    "COPY" <rel:QualifiedName> <cols:OptColumnList> <is_from:CopyFrom>
        <prog:OptProgram> <file:CopyFileName> <opts:CopyOptions> <whr:WhereClause> =>
        make_copy_stmt(Some(rel), None, cols, is_from, prog, file, opts, whr),
    "COPY" "(" <q:PreparableStmt> ")" "TO" <prog:OptProgram> <file:CopyFileName>
        <opts:CopyOptions> =>
        make_copy_stmt(None, Some(q), Vec::new(), false, prog, file, opts, None),
};

// ===========================================================================
//  VACUUM / ANALYZE  (M13, step 46). gram.y `VacuumStmt` / `AnalyzeStmt`.
// ===========================================================================

// gram.y `VacuumStmt`: the modern paren-option form and the legacy keyword form.
//   VACUUM [(opt, ...)] [table [(cols)] [, ...]]
//   VACUUM [FULL] [FREEZE] [VERBOSE] [ANALYZE] [table [(cols)] [, ...]]
// The legacy option keywords are funneled through `VacLegacyOptList` (each maps to
// a DefElem) to keep the LALR table conflict-free; the trailing optional relation
// list reuses `VacuumRelationList`.
VacuumStmt: Node = {
    "VACUUM" "(" <opts:VacGenericOptList> ")" <rels:OptVacuumRelationList> =>
        make_vacuum_stmt(opts, rels, true),
    "VACUUM" <opts:VacLegacyOptList> <rels:OptVacuumRelationList> =>
        make_vacuum_stmt(opts, rels, true),
};

// gram.y `AnalyzeStmt`: ANALYZE/ANALYSE [(opts)] | [VERBOSE], then opt relations.
AnalyzeStmt: Node = {
    <_kw:AnalyzeKeyword> "(" <opts:VacGenericOptList> ")" <rels:OptVacuumRelationList> =>
        make_vacuum_stmt(opts, rels, false),
    <_kw:AnalyzeKeyword> <verbose:OptVerbose> <rels:OptVacuumRelationList> => {
        let mut opts = Vec::new();
        if verbose { opts.push(make_generic_def_elem("verbose", None)); }
        make_vacuum_stmt(opts, rels, false)
    },
};

AnalyzeKeyword: () = {
    "ANALYZE" => (),
    "ANALYSE" => (),
};

OptVerbose: bool = {
    "VERBOSE" => true,
    => false,
};

// gram.y `utility_option_list` (the paren form): comma-separated option elems.
VacGenericOptList: Vec<Node> = {
    <e:VacGenericOptElem> => vec![e],
    <mut l:VacGenericOptList> "," <e:VacGenericOptElem> => { l.push(e); l },
};

// gram.y `utility_option_elem`: option name (a keyword) with optional boolean arg.
VacGenericOptElem: Node = {
    "FULL"    <a:VacOptArg> => make_generic_def_elem("full", a),
    "FREEZE"  <a:VacOptArg> => make_generic_def_elem("freeze", a),
    "VERBOSE" <a:VacOptArg> => make_generic_def_elem("verbose", a),
    "ANALYZE" <a:VacOptArg> => make_generic_def_elem("analyze", a),
};

// Optional boolean argument to a paren option (e.g. `VACUUM (FULL true) t`).
VacOptArg: Option<Node> = {
    "TRUE"  => Some(make_string_value_node("true".to_string())),
    "FALSE" => Some(make_string_value_node("false".to_string())),
    => None,
};

// gram.y legacy `VACUUM [FULL] [FREEZE] [VERBOSE] [ANALYZE]`: zero or more flags,
// each a boolean DefElem. A left-recursive list with the empty base case (the
// redundant single-element rule is omitted to avoid a reduce-reduce ambiguity).
VacLegacyOptList: Vec<Node> = {
    => Vec::new(),
    <mut l:VacLegacyOptList> <e:VacLegacyOptElem> => { l.push(e); l },
};

VacLegacyOptElem: Node = {
    "FULL"    => make_generic_def_elem("full", None),
    "FREEZE"  => make_generic_def_elem("freeze", None),
    "VERBOSE" => make_generic_def_elem("verbose", None),
    "ANALYZE" => make_generic_def_elem("analyze", None),
};

// gram.y `opt_vacuum_relation_list`: empty (all tables) or a list of relations.
OptVacuumRelationList: Vec<Node> = {
    => Vec::new(),
    VacuumRelationList,
};

VacuumRelationList: Vec<Node> = {
    <e:VacuumRelation> => vec![e],
    <mut l:VacuumRelationList> "," <e:VacuumRelation> => { l.push(e); l },
};

// gram.y `vacuum_relation`: qualified_name opt_name_list (the column list).
VacuumRelation: Node = {
    <rel:QualifiedName> <cols:OptColumnList> => make_vacuum_relation(rel, cols),
};

// ===========================================================================
//  CLUSTER  (M13, step 47). gram.y `ClusterStmt`.
// ===========================================================================

// gram.y `ClusterStmt`: the modern paren-option form and the legacy VERBOSE
// forms. The pre-8.3 `CLUSTER opt_verbose name ON qualified_name` spelling is
// omitted (it collides with the `CLUSTER opt_verbose qualified_name USING name`
// form once ColId reductions are considered; the two supported spellings cover
// M13). VERBOSE is funneled through `opt_verbose` -> a `verbose` DefElem to match
// the paren form's option carrier.
ClusterStmt: Node = {
    "CLUSTER" "(" <opts:VacGenericOptList> ")" <rel:QualifiedName> <idx:ClusterIndexSpec> =>
        make_cluster_stmt(Some(rel), idx, opts),
    "CLUSTER" "(" <opts:VacGenericOptList> ")" =>
        make_cluster_stmt(None, None, opts),
    "CLUSTER" <verbose:OptVerbose> <rel:QualifiedName> <idx:ClusterIndexSpec> =>
        make_cluster_stmt(Some(rel), idx, verbose_opts(verbose)),
    "CLUSTER" <verbose:OptVerbose> =>
        make_cluster_stmt(None, None, verbose_opts(verbose)),
};

// gram.y `cluster_index_specification: USING name | /*EMPTY*/`.
ClusterIndexSpec: Option<String> = {
    "USING" <n:ColId> => Some(n),
    => None,
};

// gram.y `copy_from`: FROM (true) | TO (false).
CopyFrom: bool = {
    "FROM" => true,
    "TO"   => false,
};

// gram.y `opt_program`: PROGRAM | /*EMPTY*/.
OptProgram: bool = {
    "PROGRAM" => true,
    => false,
};

// gram.y `copy_file_name`: Sconst | STDIN | STDOUT. None = stdin/stdout pipe.
CopyFileName: Option<String> = {
    <s:"SCONST"> => Some(s),
    "STDIN"  => None,
    "STDOUT" => None,
};

// gram.y `copy_options`: [WITH] '(' copy_generic_opt_list ')' (new syntax) or
// the legacy bare option list (optionally introduced by WITH). The empty case
// (no options) is also covered. The option names are explicit keyword tokens
// (the lexer emits `format`/`csv`/... as keywords, not IDENT, so the generic
// `ColLabel` form is staged), which keeps the LALR table conflict-free.
CopyOptions: Vec<Node> = {
    => Vec::new(),
    "WITH" "(" <l:CopyGenericOptList> ")" => l,
    "(" <l:CopyGenericOptList> ")" => l,
    "WITH" <l:CopyOptList> => l,
};

// gram.y `copy_generic_opt_list`: copy_generic_opt_elem (',' ...)*.
CopyGenericOptList: Vec<Node> = {
    <e:CopyGenericOptElem> => vec![e],
    <mut l:CopyGenericOptList> "," <e:CopyGenericOptElem> => { l.push(e); l },
};

// gram.y `copy_generic_opt_elem`: each known option name (a keyword) with its arg.
CopyGenericOptElem: Node = {
    "FORMAT" <a:CopyWordArg>    => make_generic_def_elem("format", Some(a)),
    "DELIMITER" <a:CopyTextArg> => make_generic_def_elem("delimiter", Some(a)),
    "NULL" <a:CopyTextArg>      => make_generic_def_elem("null", Some(a)),
    "QUOTE" <a:CopyTextArg>     => make_generic_def_elem("quote", Some(a)),
    "ESCAPE" <a:CopyTextArg>    => make_generic_def_elem("escape", Some(a)),
    "HEADER"                    => make_generic_def_elem("header", None),
    "HEADER" <a:CopyWordArg>    => make_generic_def_elem("header", Some(a)),
};

// A bare-word or string option value (e.g. FORMAT csv, FORMAT 'csv', HEADER true).
CopyWordArg: Node = {
    <s:"SCONST"> => make_string_const(s),
    "CSV"        => make_string_value_node("csv".to_string()),
    "BINARY"     => make_string_value_node("binary".to_string()),
    "TRUE"       => make_string_value_node("true".to_string()),
    "FALSE"      => make_string_value_node("false".to_string()),
    "MATCH"      => make_string_value_node("match".to_string()),
    <n:ColId>    => make_string_value_node(n),
};

// A string option value (DELIMITER/NULL/QUOTE/ESCAPE require a string literal).
CopyTextArg: Node = {
    <s:"SCONST"> => make_string_const(s),
};

// gram.y legacy `copy_opt_list` / `copy_opt_item`: the bare WITH options.
CopyOptList: Vec<Node> = {
    <e:CopyOptItem> => vec![e],
    <mut l:CopyOptList> <e:CopyOptItem> => { l.push(e); l },
};

CopyOptItem: Node = {
    "BINARY"           => make_def_elem_str("format", "binary"),
    "CSV"              => make_def_elem_str("format", "csv"),
    "HEADER"           => make_def_elem_bool("header", true),
    "DELIMITER" <s:"SCONST"> => make_def_elem_str("delimiter", &s),
    "NULL" <s:"SCONST">      => make_def_elem_str("null", &s),
    "QUOTE" <s:"SCONST">     => make_def_elem_str("quote", &s),
    "ESCAPE" <s:"SCONST">    => make_def_elem_str("escape", &s),
};

// gram.y `opt_drop_behavior: CASCADE | RESTRICT | /*EMPTY*/`.
OptDropBehavior: DropBehaviorTok = {
    "CASCADE"  => DropBehaviorTok::Cascade,
    "RESTRICT" => DropBehaviorTok::Restrict,
    => DropBehaviorTok::Restrict,
};

// gram.y `RenameStmt`: the M10-reachable forms -- RENAME a table/index/view/...
// or one of its columns. `ALTER TABLE name RENAME [COLUMN] col TO new` and
// `ALTER TABLE name RENAME TO new`.
RenameStmt: Node = {
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Table, rel, new, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Table, rel, new, true),
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" "COLUMN" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, false),
    "ALTER" "TABLE" <rel:QualifiedName> "RENAME" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, false),
    "ALTER" "TABLE" "IF" "EXISTS" <rel:QualifiedName> "RENAME" "COLUMN" <col:ColId> "TO" <new:ColId> =>
        make_rename_column(ObjType::Table, rel, col, new, true),
    "ALTER" "INDEX" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::Index, rel, new, false),
    "ALTER" "VIEW" <rel:QualifiedName> "RENAME" "TO" <new:ColId> =>
        make_rename_relation(ObjType::View, rel, new, false),
};

// gram.y `DropStmt`: the generic `DROP <objtype> [IF EXISTS] names [CASCADE|RESTRICT]`.
// M10 reaches TABLE/INDEX/VIEW/SEQUENCE/TYPE/SCHEMA; the table/index forms route to
// RemoveRelations, the rest to RemoveObjects.
DropStmt: Node = {
    "DROP" <t:DropObjectType> "IF" "EXISTS" <names:AnyNameList> <b:OptDropBehavior> =>
        make_drop_stmt(t, names, true, b),
    "DROP" <t:DropObjectType> <names:AnyNameList> <b:OptDropBehavior> =>
        make_drop_stmt(t, names, false, b),
};

DropObjectType: ObjType = {
    "TABLE"      => ObjType::Table,
    "INDEX"      => ObjType::Index,
    "VIEW"       => ObjType::View,
    "SEQUENCE"   => ObjType::Sequence,
    "TYPE"       => ObjType::Type,
    "SCHEMA"     => ObjType::Schema,
    "FUNCTION"   => ObjType::Function,
    "PROCEDURE"  => ObjType::Procedure,
    "COLLATION"  => ObjType::Collation,
    "CONVERSION" => ObjType::Conversion,
};

OptIfExists: bool = {
    "IF" "EXISTS" => true,
    => false,
};

// gram.y `any_name_list`: a comma-separated list of (possibly qualified) names.
// Each name is carried as a List of String parts (the DropStmt `objects` shape).
AnyNameList: Vec<Node> = {
    <n:AnyName> => vec![n],
    <mut list:AnyNameList> "," <n:AnyName> => { list.push(n); list },
};

AnyName: Node = {
    <n:ColId> => make_any_name(vec![n]),
    <s:ColId> "." <n:ColId> => make_any_name(vec![s, n]),
};

// ===========================================================================
//  GRANT / COMMENT  (M10 step 39: real privilege + comment machinery)
// ===========================================================================

// gram.y `GrantStmt`: GRANT|REVOKE priv_list ON TABLE name [, ...] TO|FROM role_list
// [WITH GRANT OPTION]. M10 reaches the table-object form; other object kinds + the
// schema-wide / default-privileges forms grow at their milestones.
GrantStmt: Node = {
    "GRANT" <p:GrantPrivList> "ON" "TABLE" <objs:QualifiedNameList> "TO" <r:GranteeList>
        <go:OptGrantGrantOption> =>
        make_grant_stmt(true, p, ObjectType::TABLE, objs, r, go),
    "REVOKE" <p:GrantPrivList> "ON" "TABLE" <objs:QualifiedNameList> "FROM" <r:GranteeList> =>
        make_grant_stmt(false, p, ObjectType::TABLE, objs, r, false),
};

// gram.y `privileges`: ALL [PRIVILEGES] | privilege_list. ALL is one AccessPriv with
// a NULL privname; a list is one AccessPriv per named privilege.
GrantPrivList: Vec<Node> = {
    "ALL" => vec![make_access_priv(None)],
    "ALL" "PRIVILEGES" => vec![make_access_priv(None)],
    <list:PrivilegeList> => list,
};

PrivilegeList: Vec<Node> = {
    <p:Privilege> => vec![p],
    <mut list:PrivilegeList> "," <p:Privilege> => { list.push(p); list },
};

// gram.y `privilege`: the named privileges are keywords (SELECT/INSERT/UPDATE/
// DELETE), so each is an explicit alternative; any other privilege name arrives as
// a ColId (PG's `privilege: ... | ColId opt_column_list`).
Privilege: Node = {
    "SELECT" => make_access_priv(Some("select".to_string())),
    "INSERT" => make_access_priv(Some("insert".to_string())),
    "UPDATE" => make_access_priv(Some("update".to_string())),
    "DELETE" => make_access_priv(Some("delete".to_string())),
    <n:ColId> => make_access_priv(Some(n)),
};

// gram.y `grantee_list`: comma-separated role specs.
GranteeList: Vec<Node> = {
    <n:ColId> => vec![make_role_spec(n)],
    <mut list:GranteeList> "," <n:ColId> => { list.push(make_role_spec(n)); list },
};

// gram.y `opt_grant_grant_option: WITH GRANT OPTION | /*EMPTY*/`.
OptGrantGrantOption: bool = {
    "WITH" "GRANT" "OPTION" => true,
    => false,
};

// gram.y `CommentStmt`: COMMENT ON <object> IS 'text'|NULL. M10 reaches TABLE /
// COLUMN / INDEX / SEQUENCE / SCHEMA (the relation-shaped kinds carried as a
// RangeVar); the function/type/... forms grow at their milestones.
CommentStmt: Node = {
    "COMMENT" "ON" "TABLE" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::TABLE, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "INDEX" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::INDEX, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "SEQUENCE" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::SEQUENCE, Some(Node::RangeVar(Box::new(n))), c),
    "COMMENT" "ON" "SCHEMA" <n:ColId> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::SCHEMA, Some(make_any_name(vec![n])), c),
    "COMMENT" "ON" "VIEW" <n:QualifiedName> "IS" <c:CommentText> =>
        make_comment_stmt(ObjectType::VIEW, Some(Node::RangeVar(Box::new(n))), c),
};

CommentText: Option<String> = {
    <s:"SCONST"> => Some(s),
    "NULL" => None,
};

// ===========================================================================
//  CREATE / ALTER SEQUENCE  (M10, step 39)
// ===========================================================================

// gram.y `CreateSeqStmt`: CREATE [TEMP] SEQUENCE [IF NOT EXISTS] qualified_name
// OptSeqOptList. The TEMP qualifier is parsed (relpersistence handling stages).
CreateSeqStmt: Node = {
    "CREATE" "SEQUENCE" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, false),
    "CREATE" "SEQUENCE" "IF" "NOT" "EXISTS" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, true),
    "CREATE" TempMarker "SEQUENCE" <name:QualifiedName> <opts:OptSeqOptList> =>
        make_create_seq_stmt(name, opts, false),
};

// gram.y `AlterSeqStmt`: ALTER SEQUENCE [IF EXISTS] qualified_name SeqOptList.
AlterSeqStmt: Node = {
    "ALTER" "SEQUENCE" <name:QualifiedName> <opts:SeqOptList> =>
        make_alter_seq_stmt(name, opts, false),
    "ALTER" "SEQUENCE" "IF" "EXISTS" <name:QualifiedName> <opts:SeqOptList> =>
        make_alter_seq_stmt(name, opts, true),
};

// gram.y `opt_temp`: TEMP | TEMPORARY (the GLOBAL/LOCAL noise + UNLOGGED grow
// later). Non-empty to avoid a `CREATE`-prefix reduce/reduce ambiguity with the
// other CREATE forms; the "no temp" case is a separate grammar arm at each use.
TempMarker: () = {
    "TEMP" => (),
    "TEMPORARY" => (),
};

// gram.y `OptSeqOptList: SeqOptList | /*EMPTY*/` and `SeqOptList: SeqOptElem+`.
OptSeqOptList: Vec<Node> = {
    SeqOptList,
    => Vec::new(),
};

SeqOptList: Vec<Node> = {
    <e:SeqOptElem> => vec![e],
    <mut list:SeqOptList> <e:SeqOptElem> => { list.push(e); list },
};

// gram.y `SeqOptElem` (the M10-reachable options). INCREMENT/START/CACHE/MINVALUE/
// MAXVALUE carry a signed integer; CYCLE/NO CYCLE is a flag; AS type + OWNED BY are
// accepted and dropped (their handling stages). NumericOnly is ICONST [+/-].
SeqOptElem: Node = {
    "INCREMENT" <i:SeqNumeric> => make_seq_def_elem_int("increment", i),
    "INCREMENT" "BY" <i:SeqNumeric> => make_seq_def_elem_int("increment", i),
    "START" <i:SeqNumeric> => make_seq_def_elem_int("start", i),
    "START" "WITH" <i:SeqNumeric> => make_seq_def_elem_int("start", i),
    "MINVALUE" <i:SeqNumeric> => make_seq_def_elem_int("minvalue", i),
    "NO" "MINVALUE" => make_seq_def_elem_bool("no_minvalue", true),
    "MAXVALUE" <i:SeqNumeric> => make_seq_def_elem_int("maxvalue", i),
    "NO" "MAXVALUE" => make_seq_def_elem_bool("no_maxvalue", true),
    "CACHE" <i:SeqNumeric> => make_seq_def_elem_int("cache", i),
    "CYCLE" => make_seq_def_elem_bool("cycle", true),
    "NO" "CYCLE" => make_seq_def_elem_bool("cycle", false),
    "AS" <_t:SimpleTypename> => make_seq_def_elem_bool("as", true),
    "OWNED" "BY" <_n:AnyName> => make_seq_def_elem_bool("owned_by", true),
};

// ===========================================================================
//  CREATE SCHEMA  (M10, step 39)
// ===========================================================================

// gram.y `CreateSchemaStmt`. M10 reaches `CREATE SCHEMA [IF NOT EXISTS] name
// [AUTHORIZATION role]`; the nested schema_element_list (CREATE TABLE inside the
// schema) is parsed-and-staged (an element list routes its members at exec time).
CreateSchemaStmt: Node = {
    "CREATE" "SCHEMA" <n:ColId> <auth:OptSchemaAuth> =>
        make_create_schema_stmt(Some(n), auth, Vec::new(), false),
    "CREATE" "SCHEMA" "IF" "NOT" "EXISTS" <n:ColId> <auth:OptSchemaAuth> =>
        make_create_schema_stmt(Some(n), auth, Vec::new(), true),
    "CREATE" "SCHEMA" "AUTHORIZATION" <r:ColId> =>
        make_create_schema_stmt(None, Some(make_role_spec(r)), Vec::new(), false),
};

// gram.y `OptSchemaName` AUTHORIZATION role tail.
OptSchemaAuth: Option<Node> = {
    "AUTHORIZATION" <r:ColId> => Some(make_role_spec(r)),
    => None,
};

// ===========================================================================
//  CREATE TYPE / DOMAIN / COLLATION  (M10, step 39: DefineStmt + CreateDomainStmt)
// ===========================================================================

// gram.y `DefineStmt` for CREATE TYPE: composite `AS (col type, ...)`, enum
// `AS ENUM ('a', ...)`. The base-type `CREATE TYPE n (INPUT=.., ...)` form stages.
DefineStmt: Node = {
    "CREATE" "TYPE" <n:AnyNameParts> "AS" "(" <cols:OtColumnList> ")" =>
        make_define_type_stmt(n, cols),
    "CREATE" "TYPE" <n:AnyNameParts> "AS" "ENUM" "(" <labels:EnumLabelList> ")" =>
        make_define_type_stmt(n, labels),
    "CREATE" "COLLATION" <n:AnyNameParts> "(" <defs:DefList> ")" =>
        make_define_collation_stmt(n, defs),
};

// gram.y `TableFuncElementList` (the composite column list `colname type, ...`).
OtColumnList: Vec<Node> = {
    <c:OtColumn> => vec![c],
    <mut list:OtColumnList> "," <c:OtColumn> => { list.push(c); list },
};

OtColumn: Node = {
    <n:ColId> <t:Typename> => make_ot_column_def(n, t),
};

// gram.y `enum_val_list`: the quoted enum labels.
EnumLabelList: Vec<Node> = {
    <s:"SCONST"> => vec![make_string_const(s)],
    <mut list:EnumLabelList> "," <s:"SCONST"> => { list.push(make_string_const(s)); list },
};

// gram.y `CreateDomainStmt`: CREATE DOMAIN n [AS] type [DEFAULT e] [constraints].
// M10 reaches the type + optional DEFAULT (constraints stage to phase B).
CreateDomainStmt: Node = {
    "CREATE" "DOMAIN" <n:AnyNameParts> <t:Typename> =>
        make_create_domain_stmt(n, t, Vec::new()),
    "CREATE" "DOMAIN" <n:AnyNameParts> "AS" <t:Typename> =>
        make_create_domain_stmt(n, t, Vec::new()),
};

// gram.y `any_name` parts as a Vec<String> (1- or 2-part).
AnyNameParts: Vec<String> = {
    <n:ColId> => vec![n],
    <s:ColId> "." <n:ColId> => vec![s, n],
};

// gram.y `def_list: def_elem (',' def_elem)*` (the parenthesized definition list).
DefList: Vec<Node> = {
    <e:DefElemItem> => vec![e],
    <mut list:DefList> "," <e:DefElemItem> => { list.push(e); list },
};

// gram.y `def_elem: ColLabel '=' def_arg | ColLabel`.
DefElemItem: Node = {
    <n:ColId> "=" <s:"SCONST"> => make_generic_def_elem(&n, Some(make_string_const(s))),
    <n:ColId> "=" <i:SignedIconst> => make_generic_def_elem(&n, Some(make_int_const(i32::try_from(i).unwrap_or(0)))),
    <n:ColId> => make_generic_def_elem(&n, None),
};

// ===========================================================================
//  CREATE FUNCTION / PROCEDURE  (M10, step 39)
// ===========================================================================

// gram.y `CreateFunctionStmt`: CREATE [OR REPLACE] FUNCTION|PROCEDURE name(args)
// [RETURNS rettype] LANGUAGE lang AS 'body' [opts]. The body/language are options.
CreateFunctionStmt: Node = {
    "CREATE" <repl:OptOrReplace> "FUNCTION" <n:AnyNameParts> "(" <args:FuncArgsOrEmpty> ")"
        <ret:OptFuncReturns> <opts:OptCreateFuncOptList> =>
        make_create_function_stmt(false, repl, n, args, ret, opts),
    "CREATE" <repl:OptOrReplace> "PROCEDURE" <n:AnyNameParts> "(" <args:FuncArgsOrEmpty> ")"
        <opts:OptCreateFuncOptList> =>
        make_create_function_stmt(true, repl, n, args, None, opts),
};

OptOrReplace: bool = {
    "OR" "REPLACE" => true,
    => false,
};

// gram.y `func_args_with_defaults: '(' func_args_with_defaults_list ')' | '(' ')'`.
FuncArgsOrEmpty: Vec<Node> = {
    => Vec::new(),
    <list:FuncArgList> => list,
};

FuncArgList: Vec<Node> = {
    <a:FuncArg> => vec![a],
    <mut list:FuncArgList> "," <a:FuncArg> => { list.push(a); list },
};

// gram.y `func_arg`: [arg_class] [param_name] func_type. M10 reaches `[name] type`.
FuncArg: Node = {
    <t:Typename> => make_function_parameter(None, t),
    <n:ColId> <t:Typename> => make_function_parameter(Some(n), t),
};

// gram.y `RETURNS func_type | /*EMPTY*/`.
OptFuncReturns: Option<TypeName> = {
    "RETURNS" <t:Typename> => Some(t),
    => None,
};

// gram.y `createfunc_opt_list`: the LANGUAGE / AS body options. Non-empty
// left-recursive list with an Opt wrapper for emptiness (avoids the empty-vs-single
// reduction ambiguity).
OptCreateFuncOptList: Vec<Node> = {
    CreateFuncOptList,
    => Vec::new(),
};

CreateFuncOptList: Vec<Node> = {
    <e:CreateFuncOptItem> => vec![e],
    <mut list:CreateFuncOptList> <e:CreateFuncOptItem> => { list.push(e); list },
};

// gram.y `createfunc_opt_item` (the M10-reachable subset): LANGUAGE name | AS 'body'.
// PG's LANGUAGE arg is NonReservedWord_or_Sconst; the common language names (`sql`,
// `plpgsql`) are unreserved keywords, so the quoted form `LANGUAGE 'sql'` is the
// portable spelling here (a bare unreserved-keyword ColId is a broader grammar
// change). A plain-identifier language name is also accepted.
CreateFuncOptItem: Node = {
    "LANGUAGE" <n:ColId> => make_generic_def_elem("language", Some(make_string_const(n))),
    "LANGUAGE" <s:"SCONST"> => make_generic_def_elem("language", Some(make_string_const(s))),
    "AS" <s:"SCONST"> => make_generic_def_elem("as", Some(make_string_const(s))),
};

// ===========================================================================
//  CREATE DATABASE / DROP DATABASE / CREATE CONVERSION / CREATE TABLESPACE
//  (M10, step 39: parse-and-route; bodies in phase B)
// ===========================================================================

// gram.y `CreatedbStmt`: CREATE DATABASE name [createdb_opt_list].
CreatedbStmt: Node = {
    "CREATE" "DATABASE" <n:ColId> <opts:DefListOrEmpty> => make_createdb_stmt(n, opts),
};

// gram.y `DropdbStmt`: DROP DATABASE [IF EXISTS] name.
DropdbStmt: Node = {
    "DROP" "DATABASE" <n:ColId> => make_dropdb_stmt(n, false),
    "DROP" "DATABASE" "IF" "EXISTS" <n:ColId> => make_dropdb_stmt(n, true),
};

DefListOrEmpty: Vec<Node> = {
    <list:DefList> => list,
    => Vec::new(),
};

// gram.y `CreateConversionStmt` (minimal stub-parse): routed to its phase-B body.
CreateConversionStmt: Node = {
    "CREATE" "CONVERSION" <n:AnyNameParts> => make_create_conversion_stmt(n),
};

// gram.y `CreateTableSpaceStmt` (minimal): CREATE TABLESPACE name LOCATION 'path'.
CreateTableSpaceStmt: Node = {
    "CREATE" "TABLESPACE" <n:ColId> "LOCATION" <loc:"SCONST"> =>
        make_create_tablespace_stmt(n, Some(loc)),
};

// ===========================================================================
//  CREATE VIEW  (M11, step 40)
// ===========================================================================

// gram.y `ViewStmt`: CREATE [OR REPLACE] [TEMP] VIEW name [(cols)] [WITH opts]
// AS SelectStmt [WITH [CASCADED|LOCAL] CHECK OPTION]. The RECURSIVE form
// (makeRecursiveViewSelect builds a UNION-ALL CTE) grows with M12 set-ops/CTEs.
// The TEMP marker is a separate arm (see TempMarker) to keep `CREATE` LALR-clean.
ViewStmt: Node = {
    "CREATE" "VIEW" <view:QualifiedName> <cols:OptViewColumnList>
        "AS" <query:SelectStmt> <co:OptCheckOption> =>
        make_view_stmt(view, cols, query, false, co, false),
    "CREATE" TempMarker "VIEW" <view:QualifiedName> <cols:OptViewColumnList>
        "AS" <query:SelectStmt> <co:OptCheckOption> =>
        make_view_stmt(view, cols, query, false, co, true),
    "CREATE" "OR" "REPLACE" "VIEW" <view:QualifiedName>
        <cols:OptViewColumnList> "AS" <query:SelectStmt> <co:OptCheckOption> =>
        make_view_stmt(view, cols, query, true, co, false),
    "CREATE" "OR" "REPLACE" TempMarker "VIEW" <view:QualifiedName>
        <cols:OptViewColumnList> "AS" <query:SelectStmt> <co:OptCheckOption> =>
        make_view_stmt(view, cols, query, true, co, true),
};

// gram.y `opt_column_list`: `( name (',' name)* )` of view-column aliases, each a
// String value node (the ViewStmt.aliases shape).
OptViewColumnList: Vec<Node> = {
    "(" <list:ViewColumnList> ")" => list,
    => Vec::new(),
};

ViewColumnList: Vec<Node> = {
    <n:ColId> => vec![make_string_value_node(n)],
    <mut list:ViewColumnList> "," <n:ColId> => { list.push(make_string_value_node(n)); list },
};

// gram.y `opt_check_option`: WITH [CASCADED|LOCAL] CHECK OPTION.
OptCheckOption: crate::nodes::parsenodes::ViewCheckOption = {
    "WITH" "CHECK" "OPTION" => crate::nodes::parsenodes::ViewCheckOption::CASCADED_CHECK_OPTION,
    "WITH" "CASCADED" "CHECK" "OPTION" => crate::nodes::parsenodes::ViewCheckOption::CASCADED_CHECK_OPTION,
    "WITH" "LOCAL" "CHECK" "OPTION" => crate::nodes::parsenodes::ViewCheckOption::LOCAL_CHECK_OPTION,
    => crate::nodes::parsenodes::ViewCheckOption::NO_CHECK_OPTION,
};

// ===========================================================================
//  CREATE RULE  (M11, step 40)
// ===========================================================================

// gram.y `RuleStmt`: CREATE [OR REPLACE] RULE name AS ON event TO table
// [WHERE qual] DO [ALSO|INSTEAD] (commands | NOTHING).
RuleStmt: Node = {
    "CREATE" <repl:OptOrReplace> "RULE" <name:ColId> "AS" "ON" <ev:RuleEvent>
        "TO" <rel:QualifiedName> <whr:WhereClause> "DO" <instead:OptInstead>
        <actions:RuleActionList> =>
        make_rule_stmt(repl, rel, name, whr, ev, instead, actions),
};

// gram.y `event`: SELECT | UPDATE | DELETE | INSERT.
RuleEvent: CmdType = {
    "SELECT" => CmdType::SELECT,
    "UPDATE" => CmdType::UPDATE,
    "DELETE" => CmdType::DELETE,
    "INSERT" => CmdType::INSERT,
};

// gram.y `opt_instead`: INSTEAD | ALSO | /*EMPTY*/.
OptInstead: bool = {
    "INSTEAD" => true,
    "ALSO"    => false,
    => false,
};

// gram.y `RuleActionList`: NOTHING | RuleActionStmt | '(' RuleActionMulti ')'.
// The multi-statement parenthesized form grows with the action transform; M11
// reaches NOTHING and a single statement.
RuleActionList: Vec<Node> = {
    "NOTHING" => Vec::new(),
    <s:RuleActionStmt> => vec![s],
};

// gram.y `RuleActionStmt`: SelectStmt | InsertStmt | UpdateStmt | DeleteStmt | NotifyStmt.
RuleActionStmt: Node = {
    SelectStmt,
    InsertStmt,
    UpdateStmt,
    DeleteStmt,
};

// ===========================================================================
//  Type names  (gram.y Typename -> SimpleTypename -> Numeric / GenericType).
//  The full type tower (arrays, intervals, character types, typmods, %TYPE,
//  SETOF) grows at later milestones; M2 covers int/integer and a bare generic
//  type name resolved by catalog lookup.
// ===========================================================================

Typename: TypeName = {
    SimpleTypename,
};

SimpleTypename: TypeName = {
    Numeric,
    // The keyword-spelled non-Numeric built-in types. `date` is not a SQL keyword
    // in PG so it arrives via GenericType (a bare catalog name); `text` is an
    // UNRESERVED keyword and also arrives via GenericType (TypeFunctionName);
    // `timestamp` is a col_name keyword and needs its explicit arm (gram.y
    // ConstDatetime).
    "TIMESTAMP" => system_type_name("timestamp"),
    Character,
    GenericType,
};

// gram.y `Character` / `CharacterWithLength` / `CharacterWithoutLength`: the SQL
// character types. `character`/`char`/`nchar`/`national character` -> bpchar (with
// a default length of 1 when no `(n)` is given); `varchar`/`character varying` ->
// varchar (no default length -- an unbounded varchar). `char(n)`/`varchar(n)` carry
// the length as an encoded typmod (see `char_type_name`).
Character: TypeName = {
    <c:CharacterKind> "(" <n:"ICONST"> ")" => char_type_name(c, Some(n)),
    // Bare `char`/`character` (no length) is char(1); bare `varchar` is unbounded.
    <c:CharacterKind> => {
        if c == "bpchar" { char_type_name("bpchar", Some(1)) }
        else { char_type_name(c, None) }
    },
};

// The character-type spellings that resolve to `bpchar` vs `varchar`.
CharacterKind: &'static str = {
    "CHARACTER" "VARYING" => "varchar",
    "CHAR_P" "VARYING"    => "varchar",
    "VARCHAR"             => "varchar",
    "NATIONAL" "CHARACTER" "VARYING" => "varchar",
    "NATIONAL" "CHAR_P" "VARYING"    => "varchar",
    "CHARACTER" => "bpchar",
    "CHAR_P"    => "bpchar",
    "NCHAR"     => "bpchar",
    "NATIONAL" "CHARACTER" => "bpchar",
    "NATIONAL" "CHAR_P"    => "bpchar",
};

// gram.y `Numeric`: the built-in numeric/boolean spellings. The integer aliases map
// to their pg_catalog type; M4 (step 23) adds smallint/bigint/real/float/double
// precision/numeric/decimal/boolean (typmods on numeric/decimal/float grow with the
// opt_type_modifiers machinery). `float8`/`numeric` etc. resolve to their seeded
// pg_type rows.
Numeric: TypeName = {
    "INT"     => system_type_name("int4"),
    "INTEGER" => system_type_name("int4"),
    "SMALLINT" => system_type_name("int2"),
    "BIGINT"  => system_type_name("int8"),
    "REAL"    => system_type_name("float4"),
    "FLOAT"   => system_type_name("float8"),
    "DOUBLE" "PRECISION" => system_type_name("float8"),
    "BOOLEAN" => system_type_name("bool"),
    "NUMERIC" => system_type_name("numeric"),
    "DECIMAL" => system_type_name("numeric"),
};


// gram.y `GenericType`: a (possibly schema-qualified) user/catalog type name,
// resolved by catalog lookup at analysis time. M2 takes a bare type identifier;
// the qualified form + opt_type_modifiers + array bounds grow later.
GenericType: TypeName = {
    <n:TypeFunctionName> => generic_type_name(n),
};

// gram.y `type_function_name`: IDENT | unreserved_keyword | type_func_name_keyword
// (col_name keywords are excluded: their type/function syntax is hardwired).
TypeFunctionName: String = {
    <n:"IDENT"> => n,
    UnreservedKeyword,
    TypeFuncNameKeyword,
};

// gram.y `ColId`: an identifier usable as a column/table name: IDENT plus the
// unreserved + col_name keyword categories (type_func_name / reserved excluded).
// gram.y `ColId`: an identifier usable as a column/table name: IDENT plus the
// FULL unreserved + col_name keyword categories, spelled inline, EXCEPT 10
// keywords lalrpop (lane-table LR(1), no bison precedence) cannot build the
// table with -- each is a genuine per-keyword conflict PG resolves with bison
// %prec/LALR merging:
//   CSV                    [copy_options legacy-list conflict]
//   DELETE INSERT UPDATE   [privilege / rule-event productions take them first]
//   MATCH                  [FK `MATCH SIMPLE/PARTIAL/FULL` clause conflict]
//   BETWEEN                [needs PG's %prec BETWEEN disambiguation]
//   UNBOUNDED              [needs PG's UNBOUNDED precedence hack in frame bounds]
//   CHAR / CHARACTER / NATIONAL [bare `char` (no length) Character arm conflict]
// The arms are spelled inline (not via the category nonterminals below): this
// exact shape was verified to generate in ~2s, while routing ColId through the
// shared category nonterminals sends lalrpop's lane-table splitting into 40+
// minute state explosions.
ColId: String = {
    <n:"IDENT"> => n,
    "ABORT" => "abort".to_string(),
    "ABSENT" => "absent".to_string(),
    "ABSOLUTE" => "absolute".to_string(),
    "ACCESS" => "access".to_string(),
    "ACTION" => "action".to_string(),
    "ADD" => "add".to_string(),
    "ADMIN" => "admin".to_string(),
    "AFTER" => "after".to_string(),
    "AGGREGATE" => "aggregate".to_string(),
    "ALSO" => "also".to_string(),
    "ALTER" => "alter".to_string(),
    "ALWAYS" => "always".to_string(),
    "ASENSITIVE" => "asensitive".to_string(),
    "ASSERTION" => "assertion".to_string(),
    "ASSIGNMENT" => "assignment".to_string(),
    "AT" => "at".to_string(),
    "ATOMIC" => "atomic".to_string(),
    "ATTACH" => "attach".to_string(),
    "ATTRIBUTE" => "attribute".to_string(),
    "BACKWARD" => "backward".to_string(),
    "BEFORE" => "before".to_string(),
    "BEGIN" => "begin".to_string(),
    "BIGINT" => "bigint".to_string(),
    "BIT" => "bit".to_string(),
    "BOOLEAN" => "boolean".to_string(),
    "BREADTH" => "breadth".to_string(),
    "BY" => "by".to_string(),
    "CACHE" => "cache".to_string(),
    "CALL" => "call".to_string(),
    "CALLED" => "called".to_string(),
    "CASCADE" => "cascade".to_string(),
    "CASCADED" => "cascaded".to_string(),
    "CATALOG_P" => "catalog".to_string(),
    "CHAIN" => "chain".to_string(),
    "CHARACTERISTICS" => "characteristics".to_string(),
    "CHECKPOINT" => "checkpoint".to_string(),
    "CLASS" => "class".to_string(),
    "CLOSE" => "close".to_string(),
    "CLUSTER" => "cluster".to_string(),
    "COALESCE" => "coalesce".to_string(),
    "COLUMNS" => "columns".to_string(),
    "COMMENT" => "comment".to_string(),
    "COMMENTS" => "comments".to_string(),
    "COMMIT" => "commit".to_string(),
    "COMMITTED" => "committed".to_string(),
    "COMPRESSION" => "compression".to_string(),
    "CONDITIONAL" => "conditional".to_string(),
    "CONFIGURATION" => "configuration".to_string(),
    "CONFLICT" => "conflict".to_string(),
    "CONNECTION" => "connection".to_string(),
    "CONSTRAINTS" => "constraints".to_string(),
    "CONTENT_P" => "content".to_string(),
    "CONTINUE_P" => "continue".to_string(),
    "CONVERSION" => "conversion".to_string(),
    "COPY" => "copy".to_string(),
    "COST" => "cost".to_string(),
    "CUBE" => "cube".to_string(),
    "CURRENT" => "current".to_string(),
    "CURSOR" => "cursor".to_string(),
    "CYCLE" => "cycle".to_string(),
    "DATA" => "data".to_string(),
    "DATABASE" => "database".to_string(),
    "DAY_P" => "day".to_string(),
    "DEALLOCATE" => "deallocate".to_string(),
    "DEC" => "dec".to_string(),
    "DECIMAL" => "decimal".to_string(),
    "DECLARE" => "declare".to_string(),
    "DEFAULTS" => "defaults".to_string(),
    "DEFERRED" => "deferred".to_string(),
    "DEFINER" => "definer".to_string(),
    "DELIMITER" => "delimiter".to_string(),
    "DELIMITERS" => "delimiters".to_string(),
    "DEPENDS" => "depends".to_string(),
    "DEPTH" => "depth".to_string(),
    "DETACH" => "detach".to_string(),
    "DICTIONARY" => "dictionary".to_string(),

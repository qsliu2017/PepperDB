grammar;

// --- external lexer interface (scan.rs feeds these terminals) ---------------
extern {
    type Location = i32;
    type Error = crate::backend::parser::scan::LexError;

    enum Token {
        // keywords by canonical spelling (scan.rs resolves words against kwlist)
        "SELECT"  => Token::Keyword("select"),
        "AS"      => Token::Keyword("as"),
        "CREATE"  => Token::Keyword("create"),
        "TABLE"   => Token::Keyword("table"),
        "INT"     => Token::Keyword("int"),

// Translated from PostgreSQL src/backend/parser/gram.y
//
// The SQL grammar. PG generates the LALR parser with bison; we use lalrpop (also
// LALR), so gram.y productions map across nearly one-to-one. The lexer is the
// logos token source in scan.rs (external-token mode below); semantic actions
// build PG's exact RawStmt/SelectStmt/ResTarget/A_Const node trees via the helpers
// in this file's sibling parser.rs (the makeXxxConst / makeRawStmt analogs).
//
// GROW discipline (README): the production hierarchy is scaffolded in full even
// where a nonterminal currently has one alternative, so later milestones ADD
// alternatives instead of restructuring. Every reachable production is complete.

use crate::backend::parser::scan::Token;
use crate::backend::parser::parser::{
    make_int_const, make_float_const, make_string_const, make_raw_stmt, make_star_target,
    do_negate, make_create_stmt, make_column_def_elt, system_type_name, generic_type_name,
    make_insert_stmt, make_values_select, make_column_ref, make_range_var_table_ref,
    make_a_expr, make_and_expr, make_or_expr, make_not_expr, make_func_call, RawStmtVec,
    make_type_cast, make_case_expr, make_case_when, make_coalesce_expr, make_min_max_expr,
    make_nullif_expr, make_string_const_cast, make_agg_star_call, make_distinct_func_call,
    make_sortby, insert_select_options, make_index_stmt, make_index_elem,
    make_join_expr, make_alias, apply_rangevar_alias, apply_join_alias,
};
use crate::nodes::nodes::{JoinType, Node};
use crate::nodes::parsenodes::{ResTarget, SelectStmt, SortByDir, SortByNulls, TypeName};

grammar;

// --- external lexer interface (scan.rs feeds these terminals) ---------------
extern {
    type Location = i32;
    type Error = crate::backend::parser::scan::LexError;

    enum Token {
        // keywords by canonical spelling (scan.rs resolves words against kwlist)
        "SELECT"  => Token::Keyword("select"),
        "AS"      => Token::Keyword("as"),
        "CREATE"  => Token::Keyword("create"),
        "TABLE"   => Token::Keyword("table"),
        "INT"     => Token::Keyword("int"),
        "INTEGER" => Token::Keyword("integer"),
        "FROM"    => Token::Keyword("from"),
        "INSERT"  => Token::Keyword("insert"),
        "INTO"    => Token::Keyword("into"),
        "VALUES"  => Token::Keyword("values"),
        "WHERE"   => Token::Keyword("where"),
        "AND"     => Token::Keyword("and"),
        "OR"      => Token::Keyword("or"),
        "NOT"     => Token::Keyword("not"),
        // M4 (step 23): cast + conditional-expression keywords.
        "CAST"     => Token::Keyword("cast"),
        "CASE"     => Token::Keyword("case"),
        "WHEN"     => Token::Keyword("when"),
        "THEN"     => Token::Keyword("then"),
        "ELSE"     => Token::Keyword("else"),
        "END"      => Token::Keyword("end"),
        "COALESCE" => Token::Keyword("coalesce"),
        "NULLIF"   => Token::Keyword("nullif"),
        "GREATEST" => Token::Keyword("greatest"),
        "LEAST"    => Token::Keyword("least"),
        // M4 type-name keywords (the Numeric / ConstTypename spellings).
        "NUMERIC"   => Token::Keyword("numeric"),
        "DECIMAL"   => Token::Keyword("decimal"),
        "REAL"      => Token::Keyword("real"),
        "FLOAT"     => Token::Keyword("float"),
        "DOUBLE"    => Token::Keyword("double"),
        "PRECISION" => Token::Keyword("precision"),
        "SMALLINT"  => Token::Keyword("smallint"),
        "BIGINT"    => Token::Keyword("bigint"),
        "BOOLEAN"   => Token::Keyword("boolean"),
        "TEXT"      => Token::Keyword("text"),
        // `date` is not a SQL keyword (it reaches the grammar as an IDENT via
        // GenericType); only `timestamp` is a keyword here.
        "TIMESTAMP" => Token::Keyword("timestamp"),
        // M5 (step 26): grouping / ordering / distinct / limit keywords.
        "GROUP"    => Token::Keyword("group"),
        "ORDER"    => Token::Keyword("order"),
        "BY"       => Token::Keyword("by"),
        "DISTINCT" => Token::Keyword("distinct"),
        "ASC"      => Token::Keyword("asc"),
        "DESC"     => Token::Keyword("desc"),
        "NULLS"    => Token::Keyword("nulls"),
        "FIRST"    => Token::Keyword("first"),
        "LAST"     => Token::Keyword("last"),
        "LIMIT"    => Token::Keyword("limit"),
        "OFFSET"   => Token::Keyword("offset"),
        "ALL"      => Token::Keyword("all"),
        // M6 (step 28): CREATE INDEX keywords.
        "INDEX"    => Token::Keyword("index"),
        "ON"       => Token::Keyword("on"),
        "USING"    => Token::Keyword("using"),
        "UNIQUE"   => Token::Keyword("unique"),
        // M7 (step 32): JOIN syntax keywords.
        "JOIN"     => Token::Keyword("join"),
        "INNER"    => Token::Keyword("inner"),
        "LEFT"     => Token::Keyword("left"),
        "RIGHT"    => Token::Keyword("right"),
        "FULL"     => Token::Keyword("full"),
        "OUTER"    => Token::Keyword("outer"),
        "CROSS"    => Token::Keyword("cross"),
        // literals / identifiers
        "IDENT"   => Token::Ident(<String>),
        "ICONST"  => Token::IConst(<i32>),
        "FCONST"  => Token::FConst(<String>),
        "SCONST"  => Token::SConst(<String>),
        // punctuation
        ";"       => Token::Semi,
        ","       => Token::Comma,
        "*"       => Token::Star,
        "("       => Token::LParen,
        ")"       => Token::RParen,
        "."       => Token::Dot,
        "+"       => Token::Plus,
        "-"       => Token::Minus,
        "/"       => Token::Slash,
        "%"       => Token::Percent,
        "<"       => Token::Lt,
        ">"       => Token::Gt,
        "="       => Token::Eq,
        "::"      => Token::Typecast,
        "<="      => Token::LessEquals,
        ">="      => Token::GreaterEquals,
        "<>"      => Token::NotEquals,
    }
}

// ===========================================================================
//  Top level: a semicolon-separated list of statements, each wrapped in RawStmt.
//  (gram.y `stmtmulti`; the MODE_* alternate entry points are added when plpgsql
//  / type-name parsing lands.)
// ===========================================================================

// gram.y wraps the whole result in `parse_toplevel`; the driver calls this rule.
pub Stmtmulti: RawStmtVec = {
    <mut list:Stmtmulti> ";" <s:TopLevelStmt> => {
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
    <s:TopLevelStmt> => {
        let mut list = Vec::new();
        if let Some(stmt) = s { list.push(make_raw_stmt(stmt)); }
        list
    },
};

// gram.y `toplevel_stmt`: stmt (+ TransactionStmtLegacy, added with BEGIN/END).
TopLevelStmt: Option<Node> = {
    Stmt,
};

// gram.y `stmt`: the giant alternation over every statement kind. Grows one
// statement type per milestone; an empty statement yields None (dropped above).
Stmt: Option<Node> = {
    <s:SelectStmt> => Some(s),
    <s:CreateStmt> => Some(s),
    <s:IndexStmt> => Some(s),
    <s:InsertStmt> => Some(s),
    => None,            // empty statement (e.g. trailing ';')
};

// ===========================================================================
//  INSERT
// ===========================================================================

// gram.y `InsertStmt`: opt_with_clause INSERT INTO insert_target insert_rest
// opt_on_conflict returning_clause. M2 reaches `INSERT INTO qname [(collist)]
// (VALUES (...) | SelectStmt)`; WITH / ON CONFLICT / RETURNING / OVERRIDING and
// the DEFAULT VALUES form grow at their milestones.
InsertStmt: Node = {
    "INSERT" "INTO" <rel:QualifiedName> <cols:OptInsertColumnList> <src:InsertRest> => {
        make_insert_stmt(rel, cols, src)
    },
};

// gram.y `insert_rest`: the source after the target. M2 supports a `VALUES (...)`
// list (wrapped as a SelectStmt with valuesLists, exactly as gram.y does) and a
// general SelectStmt; the `DEFAULT VALUES` and column-list+SELECT forms grow.
InsertRest: Option<Node> = {
    "VALUES" <rows:ValuesLists> => Some(make_values_select(rows)),
    <s:SelectStmt> => Some(s),
};

// gram.y `'(' insert_column_list ')' | /*EMPTY*/`. A ColumnRef per column.
OptInsertColumnList: Vec<Node> = {
    "(" <cols:InsertColumnList> ")" => cols,
    => Vec::new(),
};

InsertColumnList: Vec<Node> = {
    <c:InsertColumnItem> => vec![c],
    <mut list:InsertColumnList> "," <c:InsertColumnItem> => { list.push(c); list },
};

// gram.y `insert_column_item: ColId opt_indirection` -> a ResTarget naming the
// target column. M2 takes the bare column name (no indirection).
InsertColumnItem: Node = {
    <n:ColId> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: None, location: -1 };
        Node::ResTarget(Box::new(rt))
    },
};

// gram.y `values_clause`: VALUES ctext_row [, ...]. Each row is a parenthesized
// expression list. M2 covers one or more rows of constant expressions.
ValuesLists: Vec<Node> = {
    <r:ValuesRow> => vec![r],
    <mut list:ValuesLists> "," <r:ValuesRow> => { list.push(r); list },
};

// gram.y `ctext_row: '(' ctext_expr_list ')'`. In PG the row is a bare `List *`
// element of valuesLists; the port has no `List` Node type (pg_list tombstone),
// so a row's expr list is carried as the `args` of a RowExpr node (an exact-fit
// Vec<Node> carrier). transformInsertStmt reads `RowExpr.args` as the sublist.
ValuesRow: Node = {
    "(" <exprs:ExprList> ")" => {
        Node::RowExpr(Box::new(crate::nodes::primnodes::RowExpr {
            args: exprs,
            row_typeid: crate::postgres_ext::InvalidOid,
            row_format: crate::nodes::primnodes::CoercionForm::IMPLICIT_CAST,
            colnames: Vec::new(),
            location: -1,
        }))
    },
};

ExprList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:ExprList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  CREATE TABLE
// ===========================================================================

// gram.y `CreateStmt`. M2 reaches the plain `CREATE TABLE name ( elts )` form;
// IF NOT EXISTS, OF type, PARTITION OF, inheritance, partition spec, WITH options,
// ON COMMIT, tablespace and access-method clauses arrive at their milestones.
CreateStmt: Node = {
    "CREATE" "TABLE" <name:QualifiedName> "(" <elts:OptTableElementList> ")" => {
        make_create_stmt(name, elts)
    },
};

// gram.y `qualified_name`: ColId | ColId indirection. M2 supports the bare and
// schema-qualified (`schema.name`) forms; the general indirection (subscripts) is
// rejected by makeRangeVarFromQualifiedName in PG and is not reached here.
QualifiedName: crate::nodes::primnodes::RangeVar = {
    <n:ColId> => crate::nodes::makefuncs::makeRangeVar(None, Some(n), -1),
    <s:ColId> "." <n:ColId> =>
        crate::nodes::makefuncs::makeRangeVar(Some(s), Some(n), -1),
};

// gram.y `OptTableElementList` / `TableElementList`. M2 element = columnDef;
// TableConstraint and TableLikeClause grow with constraints / LIKE.
OptTableElementList: Vec<Node> = {
    TableElementList,
    => Vec::new(),
};

TableElementList: Vec<Node> = {
    <e:TableElement> => vec![e],
    <mut list:TableElementList> "," <e:TableElement> => { list.push(e); list },
};

TableElement: Node = {
    ColumnDef,
};

// gram.y `columnDef`: ColId Typename ColQualList. M2 builds the plain
// `name type` ColumnDef; column constraints (NOT NULL / DEFAULT / ...) grow with
// the ColQualList machinery.
ColumnDef: Node = {
    <name:ColId> <typ:Typename> => make_column_def_elt(name, typ),
};

// ===========================================================================
//  CREATE INDEX
// ===========================================================================

// gram.y `IndexStmt`: CREATE [UNIQUE] INDEX [name] ON relation [USING am]
// '(' index_params ')'. M6 reaches the plain single-/multi-column btree index;
// CONCURRENTLY, IF NOT EXISTS, INCLUDE, WITH options, tablespace, WHERE (partial),
// and the constraint forms grow at their milestones.
IndexStmt: Node = {
    "CREATE" <uniq:OptUnique> "INDEX" <name:OptIndexName> "ON" <rel:QualifiedName>
        <am:OptAccessMethodClause> "(" <params:IndexParams> ")" =>
        make_index_stmt(uniq, name, rel, am, params),
};

OptUnique: bool = {
    "UNIQUE" => true,
    => false,
};

OptIndexName: Option<String> = {
    <n:ColId> => Some(n),
    => None,
};

// gram.y `access_method_clause: USING name | /*EMPTY*/`. Defaults to btree.
OptAccessMethodClause: Option<String> = {
    "USING" <n:ColId> => Some(n),
    => None,
};

// gram.y `index_params: index_elem (',' index_elem)*`.
IndexParams: Vec<Node> = {
    <e:IndexElem> => vec![e],
    <mut list:IndexParams> "," <e:IndexElem> => { list.push(e); list },
};

// gram.y `index_elem: ColId index_elem_options ...`. M6 covers a bare column name
// (with ASC/DESC); opclasses, expressions, collations, and NULLS ordering grow.
IndexElem: Node = {
    <n:ColId> <dir:OptAscDesc> => make_index_elem(n, dir),
};

// ===========================================================================
//  Type names  (gram.y Typename -> SimpleTypename -> Numeric / GenericType).
//  The full type tower (arrays, intervals, character types, typmods, %TYPE,
//  SETOF) grows at later milestones; M2 covers int/integer and a bare generic
//  type name resolved by catalog lookup.
// ===========================================================================

Typename: TypeName = {
    SimpleTypename,
};

SimpleTypename: TypeName = {
    Numeric,
    // The keyword-spelled non-Numeric built-in types (text + timestamp). `date` is
    // not a SQL keyword in PG, so it arrives via GenericType (a bare catalog name);
    // `text`/`timestamp` ARE keywords and need an explicit arm.
    "TEXT"      => system_type_name("text"),
    "TIMESTAMP" => system_type_name("timestamp"),
    GenericType,
};

// gram.y `Numeric`: the built-in numeric/boolean spellings. The integer aliases map
// to their pg_catalog type; M4 (step 23) adds smallint/bigint/real/float/double
// precision/numeric/decimal/boolean (typmods on numeric/decimal/float grow with the
// opt_type_modifiers machinery). `float8`/`numeric` etc. resolve to their seeded
// pg_type rows.
Numeric: TypeName = {
    "INT"     => system_type_name("int4"),
    "INTEGER" => system_type_name("int4"),
    "SMALLINT" => system_type_name("int2"),
    "BIGINT"  => system_type_name("int8"),
    "REAL"    => system_type_name("float4"),
    "FLOAT"   => system_type_name("float8"),
    "DOUBLE" "PRECISION" => system_type_name("float8"),
    "BOOLEAN" => system_type_name("bool"),
    "NUMERIC" => system_type_name("numeric"),
    "DECIMAL" => system_type_name("numeric"),
};


// gram.y `GenericType`: a (possibly schema-qualified) user/catalog type name,
// resolved by catalog lookup at analysis time. M2 takes a bare type identifier;
// the qualified form + opt_type_modifiers + array bounds grow later.
GenericType: TypeName = {
    <n:ColId> => generic_type_name(n),
};

// gram.y `ColId`: an identifier usable as a column/table name. The unreserved /
// col-name keyword spellings that ColId also admits grow as those keywords enter
// the grammar; M2 accepts a bare IDENT.
ColId: String = {
    <n:"IDENT"> => n,
};

// ===========================================================================
//  SELECT
// ===========================================================================

// gram.y `SelectStmt`: select_no_parens | select_with_parens. The paren form and
// the with/sort/locking/limit wrappers in select_no_parens arrive at their
// milestones (M5 sort/limit, M12 set ops).
SelectStmt: Node = {
    SelectNoParens,
};

// gram.y `select_no_parens`: a `simple_select` optionally followed by ORDER BY and
// LIMIT/OFFSET (the trailing `opt_sort_clause opt_select_limit` arm). The sort and
// limit clauses are stamped onto the SelectStmt built by `simple_select` (PG's
// insertSelectOptions). The WITH / FOR-locking wrappers grow at their milestones.
SelectNoParens: Node = {
    SimpleSelect,
    <s:SimpleSelect> <sort:SortClause> => insert_select_options(s, sort, None, None),
    <s:SimpleSelect> <lim:SelectLimit> =>
        insert_select_options(s, Vec::new(), lim.0, lim.1),
    <s:SimpleSelect> <sort:SortClause> <lim:SelectLimit> =>
        insert_select_options(s, sort, lim.0, lim.1),
};

SelectClause: Node = {
    SimpleSelect,
};

// gram.y `simple_select`. M5 (step 26) reaches the `SELECT [DISTINCT] target_list
// FROM ... WHERE ... GROUP BY ...` shape; HAVING/WINDOW/VALUES/TABLE and the set
// operations are added at their milestones.
SimpleSelect: Node = {
    "SELECT" <distinct:OptDistinctClause> <targets:OptTargetList> <frm:FromClause>
        <whr:WhereClause> <grp:GroupClause> => {
        let n = SelectStmt {
            distinctClause: distinct,
            intoClause: None,
            targetList: targets,
            fromClause: frm,
            whereClause: whr,
            groupClause: grp,
            groupDistinct: false,
            havingClause: None,
            windowClause: Vec::new(),
            valuesLists: Vec::new(),
            sortClause: Vec::new(),
            limitOffset: None,
            limitCount: None,
            limitOption: crate::nodes::nodes::LimitOption::COUNT,  // makeNode zero default
            lockingClause: Vec::new(),
            withClause: None,
            op: crate::nodes::parsenodes::SetOperation::NONE,
            all: false,
            larg: None,
            rarg: None,
        };
        Node::SelectStmt(Box::new(n))
    },
};

// gram.y `distinct_clause` / `opt_all_clause` (the `SELECT [ALL|DISTINCT]` prefix).
// gram.y `distinct_clause: DISTINCT` returns `list_make1(NIL)` -- a one-element
// list whose lone element is NULL, distinguishing "DISTINCT (over all columns)"
// from "no DISTINCT" (an empty list). The port has no NIL Node, so the marker is a
// bare `A_Star` (transformDistinctClause keys off the list being non-empty with a
// NULL/A_Star head). `DISTINCT ON (...)` grows later.
OptDistinctClause: Vec<Node> = {
    "DISTINCT" => vec![Node::A_Star(Box::new(crate::nodes::parsenodes::A_Star {}))],
    "ALL" => Vec::new(),
    => Vec::new(),
};

// gram.y `group_clause: GROUP BY set_quantifier group_by_list | /*EMPTY*/`. M5
// covers `GROUP BY a, b, ...` (plain expression group items); ROLLUP/CUBE/GROUPING
// SETS grow with the grouping-set machinery.
GroupClause: Vec<Node> = {
    "GROUP" "BY" <list:GroupByList> => list,
    => Vec::new(),
};

GroupByList: Vec<Node> = {
    <e:AExpr> => vec![e],
    <mut list:GroupByList> "," <e:AExpr> => { list.push(e); list },
};

// ===========================================================================
//  ORDER BY  (gram.y sort_clause -> sortby_list -> sortby)
// ===========================================================================

// gram.y `sort_clause: ORDER BY sortby_list`.
SortClause: Vec<Node> = {
    "ORDER" "BY" <list:SortbyList> => list,
};

SortbyList: Vec<Node> = {
    <s:Sortby> => vec![s],
    <mut list:SortbyList> "," <s:Sortby> => { list.push(s); list },
};

// gram.y `sortby: a_expr opt_asc_desc opt_nulls_order`. The USING-operator form
// (`a_expr USING op`) grows with operator-class ordering. Builds a SortBy node.
Sortby: Node = {
    <e:AExpr> <dir:OptAscDesc> <nulls:OptNullsOrder> => make_sortby(e, dir, nulls),
};

OptAscDesc: SortByDir = {
    "ASC"  => SortByDir::ASC,
    "DESC" => SortByDir::DESC,
    => SortByDir::DEFAULT,
};

OptNullsOrder: SortByNulls = {
    "NULLS" "FIRST" => SortByNulls::FIRST,
    "NULLS" "LAST"  => SortByNulls::LAST,
    => SortByNulls::DEFAULT,
};

// ===========================================================================
//  LIMIT / OFFSET  (gram.y select_limit -> limit_clause / offset_clause)
// ===========================================================================

// gram.y `select_limit`: any combination of LIMIT and OFFSET, in either order.
// Returns (limitOffset, limitCount). FETCH FIRST / WITH TIES grow at their
// milestone; M5 covers `LIMIT count`, `OFFSET n`, and both orders.
SelectLimit: (Option<Node>, Option<Node>) = {
    <c:LimitClause> <o:OffsetClause> => (Some(o), c),
    <o:OffsetClause> <c:LimitClause> => (Some(o), c),
    <c:LimitClause> => (None, c),
    <o:OffsetClause> => (Some(o), None),
};

// gram.y `limit_clause: LIMIT select_limit_value`. `LIMIT ALL` is no count (None).
LimitClause: Option<Node> = {
    "LIMIT" <e:AExpr> => Some(e),
    "LIMIT" "ALL" => None,
};

// gram.y `offset_clause: OFFSET select_offset_value`.
OffsetClause: Node = {
    "OFFSET" <e:AExpr> => e,
};

// ===========================================================================
//  FROM clause  (gram.y from_clause -> from_list -> table_ref)
// ===========================================================================

// gram.y `from_clause: FROM from_list | /*EMPTY*/`. M2 covers a comma-separated
// list of plain table references (cross-product, no JOIN syntax yet).
FromClause: Vec<Node> = {
    "FROM" <list:FromList> => list,
    => Vec::new(),
};

FromList: Vec<Node> = {
    <t:TableRef> => vec![t],
    <mut list:FromList> "," <t:TableRef> => { list.push(t); list },
};

// gram.y `table_ref`: a FROM item. M7 (step 32) covers a plain table (with an
// optional alias), a parenthesized joined table (with an optional alias), and the
// left-recursive `joined_table` JOIN chain. Subquery / function FROM items grow at
// their milestones.
//
// To keep the LALR table unambiguous, the JOIN chain (`JoinedTable`) is
// left-recursive over `TableRef` with a NON-join right operand (`TableAtom`):
// `a JOIN b JOIN c` parses left-associatively as `(a JOIN b) JOIN c`, matching PG.
TableRef: Node = {
    TableAtom,
    JoinedTable,
};

// A non-join FROM atom: a plain (aliased) table or a parenthesized join (aliased).
TableAtom: Node = {
    <r:QualifiedName> <a:OptAliasClause> => make_range_var_table_ref(apply_rangevar_alias(r, a)),
    "(" <j:JoinedTable> ")" <a:OptAliasClause> => apply_join_alias(j, a),
};

// gram.y `joined_table`. M7 reaches the cross join (`a CROSS JOIN b`), the
// qualified join (`a [INNER] JOIN b ON expr` / `... USING (cols)`), and the outer
// join spellings (LEFT/RIGHT/FULL [OUTER] JOIN ... ON/USING). The executor only
// emits INNER joins this milestone; the outer-join parse is accepted so the
// grammar is complete (the planner/executor outer-join emit grows next). The join
// type is split into explicit productions rather than an optional nonterminal, so
// the LALR table has no empty-reduction conflict on the first JOIN keyword.
JoinedTable: Node = {
    <l:TableRef> "CROSS" "JOIN" <r:TableAtom> =>
        make_join_expr(JoinType::INNER, l, r, None, Vec::new()),
    <l:TableRef> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> "INNER" "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(JoinType::INNER, l, r, q.0, q.1),
    <l:TableRef> <jt:OuterJoinType> "JOIN" <r:TableAtom> <q:JoinQual> =>
        make_join_expr(jt, l, r, q.0, q.1),
};

// gram.y `join_type: LEFT/RIGHT/FULL [OUTER]` (the OUTER noise word is optional).
OuterJoinType: JoinType = {
    "LEFT" OptOuter => JoinType::LEFT,
    "RIGHT" OptOuter => JoinType::RIGHT,
    "FULL" OptOuter => JoinType::FULL,
};

OptOuter: () = { "OUTER" => (), => () };

// gram.y `join_qual: ON a_expr | USING '(' name_list ')'`. Returns the ON-quals or
// the USING column list (mutually exclusive).
JoinQual: (Option<Node>, Vec<String>) = {
    "ON" <q:AExpr> => (Some(q), Vec::new()),
    "USING" "(" <cols:NameList> ")" => (None, cols),
};

// gram.y `opt_alias_clause`: alias_clause | /*EMPTY*/.
OptAliasClause: Option<crate::nodes::primnodes::Alias> = {
    AliasClause => Some(<>),
    => None,
};

// gram.y `alias_clause: AS ColId | ColId` (the column-alias-list form grows later).
AliasClause: crate::nodes::primnodes::Alias = {
    "AS" <n:ColId> => make_alias(n),
    <n:ColId> => make_alias(n),
};

// gram.y `name_list: name | name_list ',' name` (USING column list).
NameList: Vec<String> = {
    <n:ColId> => vec![n],
    <mut list:NameList> "," <n:ColId> => { list.push(n); list },
};

// gram.y `where_clause: WHERE a_expr | /*EMPTY*/`. The qual expression is
// transformed (-> bool) at analysis time; CURRENT OF grows at its milestone.
WhereClause: Option<Node> = {
    "WHERE" <e:AExpr> => Some(e),
    => None,
};

// ===========================================================================
//  Target list
// ===========================================================================

OptTargetList: Vec<Node> = {
    TargetList,
    => Vec::new(),         // gram.y opt_target_list: /*EMPTY*/
};

TargetList: Vec<Node> = {
    <t:TargetEl> => vec![t],
    <mut list:TargetList> "," <t:TargetEl> => { list.push(t); list },
};

// gram.y `target_el`. '*', a bare expression, and `a_expr AS ColLabel` are the
// M1 reachable forms; the bare-label (no-AS) and full ColLabel keyword set arrive
// with the keyword/label machinery. ColLabel is restricted to IDENT for now.
TargetEl: Node = {
    <v:AExpr> "AS" <n:"IDENT"> => {
        let rt = ResTarget { name: Some(n), indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    <v:AExpr> => {
        let rt = ResTarget { name: None, indirection: Vec::new(), val: Some(v), location: -1 };
        Node::ResTarget(Box::new(rt))
    },
    "*" => make_star_target(),
};

// ===========================================================================
//  Expressions  (gram.y a_expr -> c_expr -> AexprConst).  The full operator /
//  comparison / function tower is built out in M3+.
// ===========================================================================

// gram.y `a_expr` is one big rule whose alternatives carry %prec annotations; we
// reproduce its operator precedence (gram.y's %left/%nonassoc/%right table) with
// a precedence-tier nonterminal cascade instead. Loosest binding first:
//   OR  <  AND  <  NOT  <  comparison(nonassoc)  <  '+' '-'  <  '*' '/' '%'  <
//   unary '-'  <  c_expr.
// M3 reaches the boolean (AND/OR/NOT), comparison, and arithmetic operators over
// the c_expr leaves; IS / BETWEEN / IN / LIKE / casts etc. grow at their
// milestones. Every alternative is complete.
AExpr: Node = {
    OrExpr,
};

// gram.y `a_expr OR a_expr` (%left OR). A_Expr boolean op -> BoolExpr(OR).
OrExpr: Node = {
    <l:OrExpr> "OR" <r:AndExpr> => make_or_expr(l, r),
    AndExpr,
};

// gram.y `a_expr AND a_expr` (%left AND).
AndExpr: Node = {
    <l:AndExpr> "AND" <r:NotExpr> => make_and_expr(l, r),
    NotExpr,
};

// gram.y `NOT a_expr` (%right NOT).
NotExpr: Node = {
    "NOT" <e:NotExpr> => make_not_expr(e),
    CompareExpr,
};

// gram.y comparison operators (%nonassoc: no chaining, so the operands are the
// next-tighter tier). Each builds an A_Expr(OP) over the named operator.
CompareExpr: Node = {
    <l:AddExpr> "<"  <r:AddExpr> => make_a_expr("<", l, r),
    <l:AddExpr> ">"  <r:AddExpr> => make_a_expr(">", l, r),
    <l:AddExpr> "="  <r:AddExpr> => make_a_expr("=", l, r),
    <l:AddExpr> "<=" <r:AddExpr> => make_a_expr("<=", l, r),
    <l:AddExpr> ">=" <r:AddExpr> => make_a_expr(">=", l, r),
    <l:AddExpr> "<>" <r:AddExpr> => make_a_expr("<>", l, r),
    AddExpr,
};

// gram.y `a_expr '+'/'-' a_expr` (%left '+' '-').
AddExpr: Node = {
    <l:AddExpr> "+" <r:MulExpr> => make_a_expr("+", l, r),
    <l:AddExpr> "-" <r:MulExpr> => make_a_expr("-", l, r),
    MulExpr,
};

// gram.y `a_expr '*'/'/'/'%' a_expr` (%left '*' '/' '%').
MulExpr: Node = {
    <l:MulExpr> "*" <r:UnaryExpr> => make_a_expr("*", l, r),
    <l:MulExpr> "/" <r:UnaryExpr> => make_a_expr("/", l, r),
    <l:MulExpr> "%" <r:UnaryExpr> => make_a_expr("%", l, r),
    UnaryExpr,
};

// gram.y `'-' a_expr %prec UMINUS` / `'+' a_expr %prec UMINUS` (%right UMINUS).
// A leading '-' on a constant negates it in place (doNegate); over a non-constant
// it becomes the unary-minus operator A_Expr (deferred to its milestone in
// do_negate). A leading '+' is a no-op.
UnaryExpr: Node = {
    "-" <e:UnaryExpr> => do_negate(e),
    "+" <e:UnaryExpr> => e,
    TypecastExpr,
};

// gram.y `a_expr TYPECAST Typename` (%left TYPECAST -- binds tighter than the
// arithmetic/unary operators). A postfix chain of `:: Typename` casts; each builds a
// TypeCast node over the inner expression (M4, step 23).
TypecastExpr: Node = {
    <e:TypecastExpr> "::" <t:Typename> => make_type_cast(e, t),
    CExpr,
};

CExpr: Node = {
    AexprConst,
    // gram.y `c_expr: columnref`. A bare or table-qualified column reference.
    ColumnRef,
    // gram.y `c_expr: '(' a_expr ')'`.
    "(" <e:AExpr> ")" => e,
    // gram.y `c_expr: func_expr`.
    FuncExpr,
    // gram.y `c_expr: case_expr` (M4, step 23).
    CaseExpr,
};

// gram.y `func_expr: func_application ... | func_expr_common_subexpr`. M3 reaches a
// plain function call `name ( arglist )`; M4 (step 23) adds the cast/conditional
// special forms (CAST, COALESCE, NULLIF, GREATEST, LEAST). WITHIN GROUP / FILTER /
// OVER and the remaining common-subexpr forms (CURRENT_DATE, ...) grow later.
FuncExpr: Node = {
    FuncApplication,
    FuncExprCommonSubexpr,
};

// gram.y `func_expr_common_subexpr` (M4 subset): the SQL-keyword "function" forms.
//   CAST '(' a_expr AS Typename ')'   -> a TypeCast (explicit cast)
//   COALESCE '(' expr_list ')'        -> a CoalesceExpr
//   GREATEST '(' expr_list ')'        -> a MinMaxExpr(IS_GREATEST)
//   LEAST '(' expr_list ')'           -> a MinMaxExpr(IS_LEAST)
//   NULLIF '(' a_expr ',' a_expr ')'  -> an A_Expr(AEXPR_NULLIF, "=")
FuncExprCommonSubexpr: Node = {
    "CAST" "(" <e:AExpr> "AS" <t:Typename> ")" => make_type_cast(e, t),
    "COALESCE" "(" <args:ExprList> ")" => make_coalesce_expr(args),
    "GREATEST" "(" <args:ExprList> ")" => make_min_max_expr(true, args),
    "LEAST" "(" <args:ExprList> ")" => make_min_max_expr(false, args),
    "NULLIF" "(" <l:AExpr> "," <r:AExpr> ")" => make_nullif_expr(l, r),
};

// gram.y `case_expr: CASE case_arg when_clause_list case_default END`.
// The optional `case_arg` is the simple-CASE test value; `when_clause_list` is one
// or more WHEN..THEN arms; `case_default` is the optional ELSE.
CaseExpr: Node = {
    "CASE" <arg:CaseArg> <whens:WhenClauseList> <def:CaseDefault> "END" =>
        make_case_expr(arg, whens, def),
};

// gram.y `case_arg: a_expr | /*EMPTY*/`.
CaseArg: Option<Node> = {
    <e:AExpr> => Some(e),
    => None,
};

// gram.y `when_clause_list: when_clause | when_clause_list when_clause`.
WhenClauseList: Vec<Node> = {
    <w:WhenClause> => vec![w],
    <mut list:WhenClauseList> <w:WhenClause> => { list.push(w); list },
};

// gram.y `when_clause: WHEN a_expr THEN a_expr` -> a CaseWhen node.
WhenClause: Node = {
    "WHEN" <c:AExpr> "THEN" <r:AExpr> => make_case_when(c, r),
};

// gram.y `case_default: ELSE a_expr | /*EMPTY*/`.
CaseDefault: Option<Node> = {
    "ELSE" <e:AExpr> => Some(e),
    => None,
};

// gram.y `func_application: func_name '(' func_arg_list ')' | func_name '(' '*' ')'
// | func_name '(' DISTINCT func_arg_list ')' | func_name '(' ')'`. M5 (step 26)
// adds the aggregate spellings: `count(*)` (agg_star) and `agg(DISTINCT expr)`
// (agg_distinct). VARIADIC / ORDER BY / named args grow at their milestones.
FuncApplication: Node = {
    <n:ColId> "(" ")" => make_func_call(vec![n], Vec::new()),
    <n:ColId> "(" <args:ExprList> ")" => make_func_call(vec![n], args),
    <n:ColId> "(" "*" ")" => make_agg_star_call(vec![n]),
    <n:ColId> "(" "DISTINCT" <args:ExprList> ")" => make_distinct_func_call(vec![n], args),
};

// gram.y `columnref: ColId | ColId indirection`. M2 covers `col` and
// `table.col`; the general indirection (subscripts, `.*` mid-chain) grows with
// the A_Indirection machinery.
ColumnRef: Node = {
    <n:ColId> => make_column_ref(vec![n]),
    <t:ColId> "." <n:ColId> => make_column_ref(vec![t, n]),
};

// gram.y `AexprConst`. Iconst/FCONST/Sconst are the plain forms; M4 (step 23) adds
// the typed-literal forms `Numeric Sconst` / `ConstTypename Sconst` (e.g.
// `NUMERIC '1.5'`, `DATE '2024-01-15'`), which PG builds as a string A_Const wrapped
// in a TypeCast to the named type (makeStringConstCast). BCONST/XCONST and the
// func_name-Sconst / typmod'd forms grow later.
AexprConst: Node = {
    <i:"ICONST"> => make_int_const(i),
    <f:"FCONST"> => make_float_const(f),
    <s:"SCONST"> => make_string_const(s),
    // gram.y `ConstTypename Sconst` / `Numeric Sconst`: the typed-literal form
    // `typename 'string'` (e.g. `NUMERIC '1.5'`, `DATE '2024-01-15'`). Reuses the
    // single shared `SimpleTypename` (no duplicate keyword nonterminal) so the only
    // decision after a type keyword is shift-SCONST vs reduce-to-SimpleTypename --
    // resolved by lalrpop toward the typed-literal on SCONST lookahead.
    <t:SimpleTypename> <s:"SCONST"> => make_string_const_cast(s, t),
};

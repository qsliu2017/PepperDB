# ACTIVE (PASS today)
# --------------------------------------------------------------------------
# test_setup: the trimmed shared fixtures (INT2_TBL, INT4_TBL, CHAR_TBL,
# VARCHAR_TBL). run.sh swaps in ai/harness/regress/test_setup_pepper.sql for this
# slot and classifies it by "loaded without error" (its output intentionally
# differs from upstream). Must be FIRST so downstream tests see its tables.
test: test_setup
# boolean: the bool type surface (input/output, the six comparison operators +
# casts, IS [NOT] TRUE/FALSE/UNKNOWN, TRUE/FALSE literals, `AS <keyword>` column
# labels, `table.*` expansion, LINE/caret error position, pg_input_is_valid).
# FULL PASS as of step 08: the last line `SELECT * FROM pg_input_error_info(
# 'junk','bool')` -- a record-returning function in FROM (RangeFunction ->
# RTE_FUNCTION -> FunctionScan) -- now matches upstream. (Its known_diff snapshot
# was deleted when step 08 landed the function-in-FROM path.)
test: boolean
# md5: the MD5 hash builtins over text + bytea (RFC 1321 vectors). FULL PASS as of
# step 10 -- md5(text)/md5(bytea) execute and `= <literal>` resolves via the text
# operators + unknown-literal operator coercion the step added.
test: md5
# char, varchar: FULL PASS as of the post-step-10 unblocker pass. The two gaps
# that held them back both landed: (1) temp-namespace shadowing -- CREATE TEMP
# TABLE creates in the per-backend pg_temp_N namespace (created on first use),
# and the active search path checks it FIRST, so the TEMP CHAR_TBL/VARCHAR_TBL
# shadow the test_setup fixtures, DROP TABLE resolves the temp one, and the
# fixture reappears for the "value too long" tail; (2) varchar-vs-literal
# comparison resolution -- a varchar operand with no operator of its own now
# falls through to the text operators via the binary varchar->text coercion
# (parse_oper) instead of erroring. (The `||` operator is also lexed + resolves
# now; these two tests don't use it.)
test: char
test: varchar

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# SLRU test artifacts (tests should use tempdirs - TODO)
/pg_xact/
/pg_subtrans/

# Ignore ai/harness/* but keep the pg_regress conformance harness (plan 004
# step 05) checked in. Re-include the directory chain first, then the subtree;
# git will not descend into a fully-excluded directory otherwise.
ai/harness/*
!ai/harness/regress/
ai/harness/regress/*
!ai/harness/regress/run.sh
!ai/harness/regress/pepper_schedule
!ai/harness/regress/test_setup_pepper.sql
!ai/harness/regress/known_diffs/
# except the built pg_regress binary and pg_regress run output.
ai/harness/regress/.build/
ai/harness/regress/.run/

ai/tmp/
